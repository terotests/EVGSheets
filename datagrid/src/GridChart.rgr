; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; GridChart.rgr — a cell range becomes a chart.
; ==============================================================================
;
; A chart in a spreadsheet is not a picture pasted onto the sheet: it is a VIEW
; of a range. Move the range's numbers and the picture has to follow, which is
; why nothing here stores a drawing. A `GridChart` stores the range, the kind of
; chart, the style, and where its window sits — nine numbers and two strings —
; and the picture is recomputed from the cells whenever they change.
;
; The path from those cells to pixels is entirely borrowed:
;
;   range → Vega-Lite JSON → VlCompile → VlRuntime → draw commands → EVG
;
; Every step but the first already existed and is checked against the official
; Vega implementation by Vela's own corpus. So this file's whole job is the
; first arrow: read a rectangle of cells and write the specification a chart of
; that shape needs. It emits LONG form — one row per (category, series, value) —
; because that is the shape Vega-Lite's colour and offset channels want, and
; because generating it needs no transform Vela would have to support.
;
; WHICH CHARTS SUIT A SELECTION is decided here too, and it is a real question
; rather than a menu: a pie of six series is nonsense, a line of one point is a
; dot, and a scatter needs a numeric x. `ChartKind.suits` answers it, so the
; picker can offer what will work and grey out what will not.
; ==============================================================================

Import "lib.rs"

; The chart types offered, as small integers so they can be radio-button ids.
;
; Every one of these was rendered from THIS generator's own data shape before it
; was put on the list — see the probe that produced them: twenty specifications,
; twenty scenes, no errors. A picker that offers a chart Vela cannot draw is
; worse than a shorter picker.
class ChartKind {
    sfn column:int ()      { return 1 }
    sfn bar:int ()         { return 2 }
    sfn stacked:int ()     { return 3 }
    sfn normalized:int ()  { return 4 }
    sfn histogram:int ()   { return 5 }
    sfn line:int ()        { return 6 }
    sfn lineDots:int ()    { return 7 }
    sfn step:int ()        { return 8 }
    sfn smooth:int ()      { return 9 }
    sfn area:int ()        { return 10 }
    sfn stackedArea:int () { return 11 }
    sfn stream:int ()      { return 12 }
    sfn scatter:int ()     { return 13 }
    sfn bubble:int ()      { return 14 }
    sfn strip:int ()       { return 15 }
    sfn pie:int ()         { return 16 }
    sfn donut:int ()       { return 17 }
    sfn radial:int ()      { return 18 }
    sfn heatmap:int ()     { return 19 }
    sfn boxplot:int ()     { return 20 }
    sfn stackedBar:int ()  { return 21 }
    sfn normalizedBar:int () { return 22 }
    sfn normalizedArea:int () { return 23 }
    sfn scatterLines:int () { return 24 }
    sfn combo:int ()       { return 25 }
    sfn waterfall:int ()   { return 26 }
    sfn funnel:int ()      { return 27 }
    sfn pareto:int ()      { return 28 }
    sfn stock:int ()       { return 29 }
    sfn stackedLine:int () { return 30 }
    sfn normalizedLine:int () { return 31 }
    sfn scatterSmooth:int () { return 32 }

    sfn lowest:int ()  { return 1 }
    sfn highest:int () { return 32 }

    ; Kinds drawn as several layers. The label and outline decoration works on
    ; a single mark, so these keep their own.
    sfn layered:boolean (kind:int) {
        if (kind == 25) {
            return true
        }
        if (kind == 28) {
            return true
        }
        return (kind == 29)
    }

    sfn label:string (kind:int) {
        if (kind == 1)  { return "Column" }
        if (kind == 2)  { return "Bar" }
        if (kind == 3)  { return "Stacked" }
        if (kind == 4)  { return "100% stacked" }
        if (kind == 5)  { return "Histogram" }
        if (kind == 6)  { return "Line" }
        if (kind == 7)  { return "Line + points" }
        if (kind == 8)  { return "Step" }
        if (kind == 9)  { return "Smooth" }
        if (kind == 10) { return "Area" }
        if (kind == 11) { return "Stacked area" }
        if (kind == 12) { return "Stream" }
        if (kind == 13) { return "Scatter" }
        if (kind == 14) { return "Bubble" }
        if (kind == 15) { return "Strip" }
        if (kind == 16) { return "Pie" }
        if (kind == 17) { return "Donut" }
        if (kind == 18) { return "Radial" }
        if (kind == 19) { return "Heatmap" }
        if (kind == 20) { return "Box plot" }
        if (kind == 21) { return "Stacked bar" }
        if (kind == 22) { return "100% stacked bar" }
        if (kind == 23) { return "100% stacked area" }
        if (kind == 24) { return "Scatter + lines" }
        if (kind == 25) { return "Column + line" }
        if (kind == 26) { return "Waterfall" }
        if (kind == 27) { return "Funnel" }
        if (kind == 28) { return "Pareto" }
        if (kind == 29) { return "Stock (high-low-close)" }
        if (kind == 30) { return "Stacked line" }
        if (kind == 31) { return "100% stacked line" }
        if (kind == 32) { return "Scatter + smooth lines" }
        return "Column"
    }

    ; Which of the two data shapes a kind reads. Most want the long form —
    ; one row per (category, series, value) — but a scatter needs two numeric
    ; columns plotted against each other, which is a different question about
    ; the same selection.
    sfn wantsXY:boolean (kind:int) {
        if ((kind == 13) || (kind == 14)) {
            return true
        }
        return ((kind == 24) || (kind == 32))
    }
}

; A visual style is a `config` block and a background: the same data drawn by
; the same marks, painted differently. Kept as presets rather than a colour
; picker because what a chart in a spreadsheet needs is to match the others.
;
; What makes these look like charts rather than diagrams is mostly what they
; LEAVE OUT: no border around the plot, a grid light enough to read past, ticks
; that do not compete with the data, and a legend that is a key rather than a
; caption. The default Vega look draws all of those at full strength.
class ChartStyle {
    sfn vela:int ()    { return 1 }
    sfn slate:int ()   { return 2 }
    sfn mono:int ()    { return 3 }
    sfn bold:int ()    { return 4 }
    sfn ocean:int ()   { return 5 }
    sfn sunset:int ()  { return 6 }
    sfn lowest:int ()  { return 1 }
    sfn highest:int () { return 6 }

    sfn label:string (style:int) {
        if (style == 1) { return "Vela light" }
        if (style == 2) { return "Slate dark" }
        if (style == 3) { return "Mono" }
        if (style == 4) { return "Bold" }
        if (style == 5) { return "Ocean" }
        if (style == 6) { return "Sunset" }
        return "Vela light"
    }

    ; The page colour behind the plot. The window paints it too, so the chart
    ; does not sit on a white card inside a dark panel.
    sfn background:string (style:int) {
        if (style == 2) { return "#242a33" }
        if (style == 5) { return "#f4f9fd" }
        if (style == 6) { return "#fffaf4" }
        return "#ffffff"
    }

    ; True when the style's own text is light, so the host paints its chrome to
    ; match rather than guessing from the background string.
    sfn isDark:boolean (style:int) {
        return (style == 2)
    }

    ; The colours a categorical scale runs through. Named schemes Vela knows,
    ; so a style is a choice among things that exist rather than a list of hex
    ; codes nobody checked.
    sfn scheme:string (style:int) {
        ; Set2 on the dark style: a qualitative palette light enough to read on
        ; a slate background. category20b begins at #393b79, which on #242a33
        ; is very nearly nothing.
        if (style == 2) { return "set2" }
        if (style == 3) { return "greys" }
        if (style == 4) { return "category10" }
        if (style == 5) { return "tableau10" }
        if (style == 6) { return "category" }
        return "category"
    }

    ; The `config` member, without the surrounding braces of the spec.
    ; `levelX` asks for horizontal labels along the foot. Vega-Lite stands
    ; category names on end by default, which is right for a dozen long ones
    ; and needless for four short ones — so the caller, which can see the
    ; labels, decides.
    sfn configJson:string (style:int levelX:boolean) {
        def ink:string "#3d4653"
        def muted:string "#8a95a5"
        def grid:string "#e6eaf0"
        def view:string ""
        if (style == 2) {
            ink = "#d6dde8"
            muted = "#8b97a8"
            grid = "#39414c"
        }
        if (style == 3) {
            ink = "#333333"
            muted = "#777777"
            grid = "#e2e2e2"
        }
        if (style == 4) {
            ink = "#1b2330"
            muted = "#5b6676"
            grid = "#eceff4"
        }
        if (style == 5) {
            ink = "#20384d"
            muted = "#6d8397"
            grid = "#dce9f4"
        }
        if (style == 6) {
            ink = "#4a3527"
            muted = "#977f6b"
            grid = "#f0e4d6"
        }
        ; Whether to say anything about the grid at all. Left unsaid, the
        ; reference draws one behind a CONTINUOUS axis and none behind a
        ; discrete one — which is what a chart wants, and which saying
        ; `"grid": true` everywhere undoes: four vertical rules between four
        ; quarters made the preview look like a table.
        def gridOff:boolean false
        if (style == 3) {
            gridOff = true
        }
        if (style == 4) {
            gridOff = true
        }
        def out:string "\"config\":{"
        out = (out + "\"range\":{\"category\":{\"scheme\":\"" + (ChartStyle.scheme(style)) + "\"}},")
        ; An axis is scaffolding: the labels stay readable, the furniture
        ; recedes. Domain and ticks are dropped entirely where a grid does the
        ; same job, which is what makes the data the darkest thing on the page.
        out = (out + "\"axis\":{")
        if gridOff {
            out = (out + "\"grid\":false,")
        }
        out = (out + "\"gridColor\":\"" + grid + "\",\"gridWidth\":1,")
        out = (out + "\"domainColor\":\"" + grid + "\",\"tickColor\":\"" + grid + "\",\"tickSize\":4,")
        out = (out + "\"labelColor\":\"" + muted + "\",\"labelFontSize\":10,\"labelPadding\":4,")
        out = (out + "\"titleColor\":\"" + ink + "\",\"titleFontSize\":11,\"titlePadding\":6},")
        out = (out + "\"legend\":{\"labelColor\":\"" + muted + "\",\"labelFontSize\":10,\"titleColor\":\"" + ink + "\",\"titleFontSize\":10,\"symbolSize\":60},")
        out = (out + "\"title\":{\"color\":\"" + ink + "\",\"fontSize\":13,\"offset\":8},")
        ; No box around the plot. Vega draws one by default and it is the
        ; single thing that makes a chart look like a table cell.
        out = (out + "\"view\":{\"stroke\":\"" + view + "\"},")
        if levelX {
            out = (out + "\"axisX\":{\"labelAngle\":0},")
        }
        out = (out + "\"axisY\":{\"domain\":false,\"ticks\":false}")
        return (out + "}")
    }
}

; One chart: what it reads, how it looks, and where its window is. Everything
; is a value — no display list, no cached scene — so a chart can be copied,
; compared and undone like any other edit.
class GridChart {
    def id:int 0
    def kind:int 1
    def style:int 1
    ; Which sheet the range belongs to. A chart of Sheet2 does not follow you
    ; to Sheet1, it hides.
    def sheet:int 0
    def r0:int 0
    def c0:int 0
    def r1:int 0
    def c1:int 0
    ; Optional ordered, non-contiguous source columns (Ctrl+header selection).
    ; Empty means every column in c0..c1, preserving old chart documents.
    def sourceCols:[int]
    ; The first row names the series; the first column names the categories.
    ; Both default on, which is what a spreadsheet selection usually looks like.
    def useHeaderRow:boolean true
    def useHeaderCol:boolean true
    ; --- what the columns MEAN ------------------------------------------------
    ; A rectangle of cells is a table, and a chart is a question about it:
    ;
    ;   SELECT <catCol>, <agg>(<valueCols>) … GROUP BY <catCol>, <seriesCol>
    ;
    ; `catCol` is the column the numbers are broken down BY, `seriesCol` a
    ; second way to cut them, `valueCols` the measures and `valueAggs` how each
    ; one is combined when a category repeats — summed, or averaged when it is
    ; a rate rather than a quantity.
    ;
    ; All of it is off by default and `catCol` of -1 means "read the rectangle
    ; the old way", so every chart written before this still means what it
    ; meant. `ChartInference` is what fills them in.
    def catCol:int -1
    def seriesCol:int -1
    def valueCols:[int]
    def valueAggs:[string]
    ; How rows that share a category are combined.
    ;
    ;   ""       not combined — a bar per row, even when two share a label
    ;   "auto"   combined, each measure by its own rule in `valueAggs`:
    ;            quantities added up, rates averaged
    ;   "sum" "avg" "min" "max" "count"
    ;            combined, every measure the same way, because the reader
    ;            said so
    ;
    ; "auto" is what the inference chooses and what the picker shows as
    ; whichever function it worked out to; the named ones are what a reader
    ; picks when they disagree with it. "count" is also what a table of
    ; nothing but words gets, where there is no measure to combine at all.
    def agg:string ""
    ; How a DATE category is bucketed before it is grouped: "" is the day
    ; itself, "month", "quarter" and "year" are the coarser cuts. A year of
    ; daily readings is 365 categories, and 365 labels along the bottom is a
    ; grey smear — the answer is to ask the question by month.
    def catBucket:string ""
    ; Drawn above the plot, and used as the window's caption when it is set —
    ; one title, in both places it belongs.
    def title:string ""
    ; Alt text, for a reader (Check Accessibility asks for it).
    def altText:string ""
    def showLegend:boolean true
    ; Chart elements and format (Chart Design / Format): data labels, the
    ; value grid ("" as the style has it, "on", "off"), axis titles, series
    ; read from rows instead of columns, and the marks' fill and outline.
    def dataLabels:boolean false
    def gridlines:string ""
    def axisTitles:boolean true
    def transposed:boolean false
    def fillColor:string ""
    def outlineColor:string ""
    ; Element formatting (the Format pane). Empty means as the style has it.
    ;   legendPos    "" (right), "top", "bottom", "left"
    ;   valueMin/Max the value axis bounds, as typed
    ;   logScale     a logarithmic value axis
    ;   numFormat    the value axis and label number format ("," "0%" "$,")
    ;   labelPos     "" (outside end) or "inside"
    ;   lineWidth    line thickness in pixels, 0 for the style's
    ;   titleSize    chart title size in points, 0 for the style's
    ;   seriesColors colours for the series in order, comma separated
    ;   areaFill     the chart area's background
    ;   xTitle/yTitle axis titles typed in place of the headers
    def legendPos:string ""
    def valueMin:string ""
    def valueMax:string ""
    def logScale:boolean false
    def numFormat:string ""
    def labelPos:string ""
    def lineWidth:int 0
    def titleSize:int 0
    def seriesColors:string ""
    def areaFill:string ""
    def xTitle:string ""
    def yTitle:string ""
    ; Window rectangle, in page pixels.
    def x:int 0
    def y:int 0
    def w:int 380
    def h:int 260
    ; Set when the range's cells changed under it, so the host knows to redraw.
    def dirty:boolean true

    Constructor () {
    }

    fn copyFrom:void (o:GridChart) {
        id = o.id
        kind = o.kind
        style = o.style
        sheet = o.sheet
        r0 = o.r0
        c0 = o.c0
        r1 = o.r1
        c1 = o.c1
        clear sourceCols
        def sci:int 0
        while (sci < (array_length o.sourceCols)) {
            push sourceCols (itemAt o.sourceCols sci)
            sci = (sci + 1)
        }
        useHeaderRow = o.useHeaderRow
        useHeaderCol = o.useHeaderCol
        catCol = o.catCol
        seriesCol = o.seriesCol
        clear valueCols
        clear valueAggs
        def vci:int 0
        while (vci < (array_length o.valueCols)) {
            push valueCols (itemAt o.valueCols vci)
            push valueAggs (itemAt o.valueAggs vci)
            vci = (vci + 1)
        }
        agg = o.agg
        catBucket = o.catBucket
        title = o.title
        showLegend = o.showLegend
        dataLabels = o.dataLabels
        gridlines = o.gridlines
        axisTitles = o.axisTitles
        transposed = o.transposed
        fillColor = o.fillColor
        outlineColor = o.outlineColor
        def fmt:string (o.formatText())
        this.setFormats(fmt)
        x = o.x
        y = o.y
        w = o.w
        h = o.h
        dirty = true
    }

    ; One formatting element by its key, as the Format pane and
    ; `chart.formatElement` name them. False for a key or value it does not
    ; know, so a typo is reported rather than ignored.
    fn setFormat:boolean (key:string val:string) {
        def k:string (to_lowercase (trim key))
        def v:string (trim val)
        if (k == "legend") {
            def lv:string (to_lowercase v)
            if ((lv == "right") || (lv == "")) {
                legendPos = ""
                showLegend = true
                return true
            }
            if ((lv == "top") || ((lv == "bottom") || (lv == "left"))) {
                legendPos = lv
                showLegend = true
                return true
            }
            if (lv == "none") {
                showLegend = false
                return true
            }
            return false
        }
        if ((k == "min") || (k == "max")) {
            if ((strlen v) > 0) {
                if ((ChartData.looksNumeric(v)) == false) {
                    return false
                }
            }
            if (k == "min") {
                valueMin = v
            } {
                valueMax = v
            }
            return true
        }
        if (k == "log") {
            logScale = ((v == "on") || ((v == "true") || (v == "1")))
            return true
        }
        if (k == "format") {
            numFormat = v
            return true
        }
        if (k == "labels") {
            def pv:string (to_lowercase v)
            if ((pv == "") || (pv == "outside")) {
                labelPos = ""
                return true
            }
            if (pv == "inside") {
                labelPos = "inside"
                return true
            }
            if (pv == "on") {
                dataLabels = true
                return true
            }
            if (pv == "off") {
                dataLabels = false
                return true
            }
            return false
        }
        if ((k == "linewidth") || (k == "titlesize")) {
            def n@(optional):int (to_int v)
            def got:int 0
            if (!null? n) {
                got = (unwrap n)
            }
            if ((strlen v) == 0) {
                got = 0
            } {
                if ((null? n) || ((got < 0) || (got > 48))) {
                    return false
                }
            }
            if (k == "linewidth") {
                lineWidth = got
            } {
                titleSize = got
            }
            return true
        }
        if (k == "colors") {
            seriesColors = v
            return true
        }
        if (k == "area") {
            areaFill = v
            return true
        }
        if (k == "xtitle") {
            xTitle = v
            return true
        }
        if (k == "ytitle") {
            yTitle = v
            return true
        }
        if (k == "fill") {
            fillColor = v
            return true
        }
        if (k == "outline") {
            outlineColor = v
            return true
        }
        return false
    }

    ; "key=value;key=value", each through setFormat. False if any failed.
    fn setFormats:boolean (text:string) {
        def ok:boolean true
        def rest:string text
        while ((strlen rest) > 0) {
            def semi:int (indexOf rest ";")
            def part:string rest
            if (semi >= 0) {
                part = (substring rest 0 semi)
                rest = (substring rest (semi + 1) (strlen rest))
            } {
                rest = ""
            }
            def eq:int (indexOf part "=")
            if (eq > 0) {
                if ((this.setFormat((substring part 0 eq) (substring part (eq + 1) (strlen part)))) == false) {
                    ok = false
                }
            } {
                if ((strlen (trim part)) > 0) {
                    ok = false
                }
            }
        }
        return ok
    }

    ; Everything setFormat holds, in the form setFormats reads back.
    fn formatText:string () {
        def out:string ""
        def leg:string legendPos
        if (showLegend == false) {
            leg = "none"
        }
        out = (out + "legend=" + leg)
        out = (out + ";min=" + valueMin + ";max=" + valueMax)
        if logScale {
            out = (out + ";log=on")
        } {
            out = (out + ";log=off")
        }
        out = (out + ";format=" + numFormat + ";labels=" + labelPos)
        out = (out + ";lineWidth=" + (to_string lineWidth) + ";titleSize=" + (to_string titleSize))
        out = (out + ";colors=" + seriesColors + ";area=" + areaFill)
        out = (out + ";xTitle=" + xTitle + ";yTitle=" + yTitle)
        out = (out + ";fill=" + fillColor + ";outline=" + outlineColor)
        return out
    }

    fn rangeLabel:string () {
        if ((array_length sourceCols) > 0) {
            def out:string ""
            def i:int 0
            while (i < (array_length sourceCols)) {
                if (i > 0) {
                    out = (out + ",")
                }
                def c:int (itemAt sourceCols i)
                out = (out + (SpreadsheetModel.cellLabel(r0 c)) + ":" + (SpreadsheetModel.cellLabel(r1 c)))
                i = (i + 1)
            }
            return out
        }
        return ((SpreadsheetModel.cellLabel(r0 c0)) + ":" + (SpreadsheetModel.cellLabel(r1 c1)))
    }

    fn sourceColCount:int () {
        if ((array_length sourceCols) > 0) {
            return (array_length sourceCols)
        }
        return ((c1 - c0) + 1)
    }

    fn sourceColAt:int (i:int) {
        if ((array_length sourceCols) > 0) {
            return (itemAt sourceCols i)
        }
        return (c0 + i)
    }

    ; The window's caption: the user's title if they gave one, else what the
    ; chart is of, which is more use than "Chart 1".
    fn caption:string () {
        if ((strlen title) > 0) {
            return title
        }
        return ((ChartKind.label(kind)) + " — " + (this.rangeLabel()))
    }

    ; Is this chart described by a plan rather than by a bare rectangle?
    fn planned:boolean () {
        if ((array_length valueCols) > 0) {
            return true
        }
        ; Counting is a plan with no measures in it: how many rows fall into
        ; each category is a question a table of nothing but words can answer.
        return (agg == "count")
    }

    ; The function this measure is combined with, once the chart-wide choice
    ; and the per-measure rules have both had their say.
    fn aggAt:string (i:int) {
        if (agg == "auto") {
            if (i < (array_length valueAggs)) {
                return (itemAt valueAggs i)
            }
            return "sum"
        }
        if ((strlen agg) > 0) {
            return agg
        }
        ; Not grouped: there is nothing to combine, and summing one row is
        ; that row.
        return "sum"
    }

    ; Does this chart combine rows that share a category?
    fn grouping:boolean () {
        if ((strlen agg) == 0) {
            return false
        }
        return true
    }

    ; What the picker should show as selected. A chart combining each measure
    ; by its own rule still has ONE answer to show whenever the measures agree,
    ; which they almost always do; when they do not, nothing is selected rather
    ; than one of them being shown as if it spoke for the others.
    fn effectiveAgg:string () {
        if (agg != "auto") {
            return agg
        }
        if ((array_length valueAggs) == 0) {
            return "sum"
        }
        def first:string (itemAt valueAggs 0)
        def i:int 1
        while (i < (array_length valueAggs)) {
            if ((itemAt valueAggs i) != first) {
                return ""
            }
            i = (i + 1)
        }
        return first
    }

    ; The name a person reads for one of them.
    sfn aggLabel:string (a:string) {
        if (a == "sum")   { return "Sum" }
        if (a == "avg")   { return "Average" }
        if (a == "min")   { return "Min" }
        if (a == "max")   { return "Max" }
        if (a == "count") { return "Count" }
        return "Don't"
    }

    ; And the word that belongs in a title. A sum needs no word — "Revenue by
    ; Region" already means the revenue — but an average or a maximum is a
    ; different question and the title has to say which one was asked.
    sfn aggTitleWord:string (a:string) {
        if (a == "avg")   { return "Average " }
        if (a == "min")   { return "Lowest " }
        if (a == "max")   { return "Highest " }
        return ""
    }

    ; Does an edit at (r, c) change this chart?
    fn covers:boolean (sh:int r:int c:int) {
        if (sh != sheet) {
            return false
        }
        if (r < r0) {
            return false
        }
        if (r > r1) {
            return false
        }
        if ((array_length sourceCols) > 0) {
            def i:int 0
            while (i < (array_length sourceCols)) {
                if (c == (itemAt sourceCols i)) {
                    return true
                }
                i = (i + 1)
            }
            return false
        }
        if (c < c0) {
            return false
        }
        return (c <= c1)
    }
}

; The numbers behind one chart, pulled out of the model once and then asked
; questions: how many series, are the categories numeric, is a pie sensible.
class ChartData {
    def cats:[string]
    def series:[string]
    ; Row-major over categories: index = (cat * seriesCount) + series.
    def values:[double]
    def filled:[boolean]
    ; True when every category label parsed as a number, which is what decides
    ; whether a line gets a real x axis or a categorical one.
    def catNumeric:boolean false
    def points:int 0
    ; What the headers called things. Without these an axis is labelled with
    ; the field name the generator invented ("cat", "value"), which is a
    ; detail of this file leaking onto the user's chart.
    def catTitle:string ""
    ; Characters a category name may show, 0 for all of them (see specJson).
    def catClip:int 0
    def valueTitle:string ""
    def seriesTitle:string ""

    Constructor () {
    }

    fn catCount:int () {
        return (array_length cats)
    }

    fn seriesCount:int () {
        return (array_length series)
    }

    ; Is the WHOLE string a number? `to_double` is a front-parser: it reads
    ; "2024-01-01" as 2024 and "14%" as 14, which is how a column of dates
    ; ended up charted as six equal values of 2024. So the shape is checked
    ; first, and only then converted.
    sfn looksNumeric:boolean (text:string) {
        def n:int (strlen text)
        if (n == 0) {
            return false
        }
        def i:int 0
        def digits:int 0
        def dots:int 0
        def exponents:int 0
        while (i < n) {
            def ch:int (charAt text i)
            def isDigit:boolean ((ch >= 48) && (ch <= 57))
            if isDigit {
                digits = (digits + 1)
            } {
                if (ch == 46) {
                    dots = (dots + 1)
                    if (dots > 1) {
                        return false
                    }
                } {
                    if ((ch == 43) || (ch == 45)) {
                        ; A sign is only a sign at the front, or straight after
                        ; the exponent marker.
                        if (i > 0) {
                            def prev:int (charAt text (i - 1))
                            if ((prev != 101) && (prev != 69)) {
                                return false
                            }
                        }
                    } {
                        if ((ch == 101) || (ch == 69)) {
                            exponents = (exponents + 1)
                            if (exponents > 1) {
                                return false
                            }
                            if (digits == 0) {
                                return false
                            }
                        } {
                            return false
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return (digits > 0)
    }

    sfn asNumber:double (text:string out:[boolean]) {
        clear out
        if ((ChartData.looksNumeric(text)) == false) {
            push out false
            return 0.0
        }
        def p@(optional):double (to_double text)
        if p {
            push out true
            return (unwrap p)
        }
        push out false
        return 0.0
    }

    ; Read the chart's rectangle out of the model. Returns false when there is
    ; nothing to draw — no value column, or no row under the header.
    ; Switch Row/Column: the series become the categories and back.
    fn extract:boolean (model:SpreadsheetModel ch:GridChart) {
        def ok:boolean (this.extractRead(model ch))
        if (ok && ch.transposed) {
            this.transpose()
        }
        return ok
    }

    fn transpose:void () {
        def nc:int (array_length cats)
        def ns:int (array_length series)
        def nv:[double]
        def nf:[boolean]
        def s:int 0
        while (s < ns) {
            def c:int 0
            while (c < nc) {
                push nv (itemAt values ((c * ns) + s))
                push nf (itemAt filled ((c * ns) + s))
                c = (c + 1)
            }
            s = (s + 1)
        }
        def oldCats:[string] cats
        cats = series
        series = oldCats
        values = nv
        filled = nf
        catNumeric = false
        def t:string catTitle
        catTitle = seriesTitle
        seriesTitle = t
        if ((array_length series) > 1) {
            valueTitle = ""
        }
    }

    fn extractRead:boolean (model:SpreadsheetModel ch:GridChart) {
        clear cats
        clear series
        clear values
        clear filled
        catNumeric = true
        points = 0
        catTitle = ""
        valueTitle = ""
        seriesTitle = ""
        ; A chart with a plan says which column is the category and which are
        ; the measures; one without is a bare rectangle read the old way.
        if (ch.planned()) {
            return (this.extractPlanned(model ch))
        }

        def top:int ch.r0
        def firstValue:int 0
        if ch.useHeaderRow {
            top = (top + 1)
        }
        if ch.useHeaderCol {
            firstValue = 1
        }
        if (top > ch.r1) {
            return false
        }
        def sourceN:int (ch.sourceColCount())
        if (firstValue >= sourceN) {
            return false
        }

        ; Series names: the header row over the value columns, or "Series n".
        def ci:int firstValue
        while (ci < sourceN) {
            def c:int (ch.sourceColAt(ci))
            def name:string ""
            if ch.useHeaderRow {
                name = (model.getCell(ch.r0 c))
            }
            if ((strlen name) == 0) {
                name = ("Series " + (to_string ((ci - firstValue) + 1)))
            }
            push series name
            ci = (ci + 1)
        }

        def flag:[boolean]
        def r:int top
        while (r <= ch.r1) {
            def label:string ""
            if ch.useHeaderCol {
                label = (model.getCell(r (ch.sourceColAt(0))))
            }
            if ((strlen label) == 0) {
                label = (to_string ((r - top) + 1))
            }
            def probe:double (ChartData.asNumber(label flag))
            if ((array_length flag) > 0) {
                if ((itemAt flag 0) == false) {
                    catNumeric = false
                }
            }
            push cats label
            def cci:int firstValue
            while (cci < sourceN) {
                def cc:int (ch.sourceColAt(cci))
                def raw:string (model.getCell(r cc))
                def v:double (ChartData.asNumber(raw flag))
                def ok:boolean false
                if ((array_length flag) > 0) {
                    ok = (itemAt flag 0)
                }
                push values v
                push filled ok
                if ok {
                    points = (points + 1)
                }
                cci = (cci + 1)
            }
            r = (r + 1)
        }
        if ((array_length cats) == 0) {
            return false
        }
        if ch.useHeaderCol {
            catTitle = (model.getCell(ch.r0 (ch.sourceColAt(0))))
        }
        if ((array_length series) == 1) {
            valueTitle = (itemAt series 0)
        }
        if ((array_length series) > 1) {
            seriesTitle = "Series"
        }
        return (points > 0)
    }


    ; --- the planned reading --------------------------------------------------
    ; One pass down the rows, accumulating into a bucket per (category, series).
    ; That is a GROUP BY, and it is the whole difference between two hundred
    ; bars of one invoice line each and four bars of a region's revenue.
    ;
    ; A row is skipped when its category is blank — an empty cell is not a
    ; group called "" — and a measure that will not parse is left UNFILLED
    ; rather than counted as zero, so a gap in the data reads as a gap.
    fn extractPlanned:boolean (model:SpreadsheetModel ch:GridChart) {
        def top:int ch.r0
        if ch.useHeaderRow {
            top = (top + 1)
        }
        if (top > ch.r1) {
            return false
        }
        ; Counting is not a way of combining a measure — it is a question
        ; about the ROWS — so it collapses to one series called Count however
        ; many measures the chart has. Two identical Count lines, one per
        ; measure, would say nothing twice.
        def counting:boolean ((ch.effectiveAgg()) == "count")
        def measures:int (array_length ch.valueCols)
        if counting {
            measures = 1
        }
        if (measures == 0) {
            return false
        }
        def grouped:boolean (ch.grouping())

        ; Series names: one per measure, or one per distinct value of the
        ; series column when there is one — never both, because a grid of
        ; measure × series has no room in a legend.
        def bySeriesCol:boolean (ch.seriesCol >= 0)
        def catKeys:[string]
        def catIndex:[string:int]
        def serKeys:[string]
        def serIndex:[string:int]
        if (bySeriesCol == false) {
            def mi:int 0
            while (mi < measures) {
                def name:string ""
                if counting {
                    name = "Count"
                } {
                    if ch.useHeaderRow {
                        name = (model.getCell(ch.r0 (itemAt ch.valueCols mi)))
                    }
                    if ((strlen name) == 0) {
                        name = ("Series " + (to_string (mi + 1)))
                    }
                }
                push series name
                set serIndex name mi
                push serKeys name
                mi = (mi + 1)
            }
        }

        ; One bucket per (category, series). Everything the five functions need
        ; is accumulated in one pass — a sum and a count answer Sum, Average
        ; and Count; the smallest and largest answer Min and Max — so changing
        ; the function in the picker never re-reads the sheet.
        def sums:[double]
        def counts:[int]
        def lows:[double]
        def highs:[double]
        def flag:[boolean]
        def r:int top
        while (r <= ch.r1) {
            def key:string ""
            if (ch.catCol >= 0) {
                if ((strlen ch.catBucket) > 0) {
                    key = (ChartData.bucketKey((model.getCell(r ch.catCol)) ch.catBucket))
                } {
                    key = (model.getDisplay(r ch.catCol))
                }
                if ((strlen (trim key)) == 0) {
                    key = ""
                }
            } {
                key = (to_string ((r - top) + 1))
            }
            if ((strlen key) > 0) {
                ; Grouped: rows with the same label land in the same bucket,
                ; which is the GROUP BY. Ungrouped: every row is its own bar,
                ; even when two of them are called the same thing.
                def ci:int -1
                if grouped {
                    if (has catIndex key) {
                        ci = (unwrap (get catIndex key))
                    }
                }
                if (ci < 0) {
                    ci = (array_length catKeys)
                    push catKeys key
                    set catIndex key ci
                }
                def si:int 0
                if bySeriesCol {
                    def sname:string (model.getDisplay(r ch.seriesCol))
                    if ((strlen (trim sname)) == 0) {
                        sname = "(blank)"
                    }
                    si = -1
                    if (has serIndex sname) {
                        si = (unwrap (get serIndex sname))
                    }
                    if (si < 0) {
                        si = (array_length serKeys)
                        if (si < (ChartData.slotStride())) {
                            push serKeys sname
                            set serIndex sname si
                            push series sname
                        } {
                            si = -1
                        }
                    }
                    def raw:string (model.getCell(r (itemAt ch.valueCols 0)))
                    def v:double (ChartData.asNumber(raw flag))
                    def ok:boolean false
                    if ((array_length flag) > 0) {
                        ok = (itemAt flag 0)
                    }
                    if (si < 0) {
                        ok = false
                    }
                    if ok {
                        ChartData.addTo(sums counts lows highs (ci * (ChartData.slotStride())) si v)
                    }
                } {
                    if counting {
                        ; One per row that landed in this bucket, and nothing
                        ; else: counting rows is not a way of combining a
                        ; measure, so the measures are not read at all. Adding
                        ; them here as well double-counted every row.
                        ChartData.addTo(sums counts lows highs (ci * (ChartData.slotStride())) 0 1.0)
                    }
                    def mi2:int 0
                    def upTo:int (array_length ch.valueCols)
                    if counting {
                        upTo = 0
                    }
                    while (mi2 < upTo) {
                        def raw2:string (model.getCell(r (itemAt ch.valueCols mi2)))
                        def v2:double (ChartData.asNumber(raw2 flag))
                        def ok2:boolean false
                        if ((array_length flag) > 0) {
                            ok2 = (itemAt flag 0)
                        }
                        if ok2 {
                            ChartData.addTo(sums counts lows highs (ci * (ChartData.slotStride())) mi2 v2)
                        }
                        mi2 = (mi2 + 1)
                    }
                }
            }
            r = (r + 1)
        }

        def nc:int (array_length catKeys)
        def ns:int (array_length series)
        if (nc == 0) {
            return false
        }
        if (ns == 0) {
            return false
        }
        ; Lay the buckets out row-major, turning a sum into an average where
        ; the plan asked for one.
        def ci2:int 0
        while (ci2 < nc) {
            push cats (itemAt catKeys ci2)
            def si2:int 0
            while (si2 < ns) {
                def slot:int (((ci2 * (ChartData.slotStride())) + si2))
                def total:double 0.0
                def cnt:int 0
                if (slot < (array_length sums)) {
                    total = (itemAt sums slot)
                    cnt = (itemAt counts slot)
                }
                def want:string "sum"
                if bySeriesCol {
                    want = (ch.aggAt(0))
                } {
                    want = (ch.aggAt(si2))
                }
                def out:double total
                if (want == "avg") {
                    if (cnt > 0) {
                        out = (total / (to_double cnt))
                    }
                }
                if (want == "count") {
                    out = (to_double cnt)
                }
                if (want == "min") {
                    if (slot < (array_length lows)) {
                        out = (itemAt lows slot)
                    }
                }
                if (want == "max") {
                    if (slot < (array_length highs)) {
                        out = (itemAt highs slot)
                    }
                }
                push values out
                push filled (cnt > 0)
                if (cnt > 0) {
                    points = (points + 1)
                }
                si2 = (si2 + 1)
            }
            ci2 = (ci2 + 1)
        }

        ; Are the categories numbers? A date axis reads as text here — it is
        ; formatted — but its ORDER is the row order, which is what a line
        ; wants, so nothing has to be sorted.
        catNumeric = true
        def k:int 0
        while (k < (array_length cats)) {
            ChartData.asNumber((itemAt cats k) flag)
            if ((array_length flag) > 0) {
                if ((itemAt flag 0) == false) {
                    catNumeric = false
                }
            }
            k = (k + 1)
        }
        if (ch.catCol >= 0) {
            if ch.useHeaderRow {
                catTitle = (model.getCell(ch.r0 ch.catCol))
            }
        }
        if (ns == 1) {
            valueTitle = (itemAt series 0)
        }
        if (ns > 1) {
            seriesTitle = "Series"
            if bySeriesCol {
                if ch.useHeaderRow {
                    seriesTitle = (model.getCell(ch.r0 ch.seriesCol))
                }
            }
        }
        return (points > 0)
    }

    ; A date serial, as the month / quarter / year it falls in. The label is
    ; also the sort key, which is why the year comes first and the month is
    ; padded — the rows arrive in whatever order the sheet has them and the
    ; categories come out in the order they were first seen.
    sfn bucketKey:string (raw:string want:string) {
        def flag:[boolean]
        def serial:double (ChartData.asNumber(raw flag))
        def ok:boolean false
        if ((array_length flag) > 0) {
            ok = (itemAt flag 0)
        }
        if (ok == false) {
            return (trim raw)
        }
        def ymd:[int] (DateSerial.toYMD(serial))
        if ((array_length ymd) < 3) {
            return (trim raw)
        }
        def y:int (itemAt ymd 0)
        def m:int (itemAt ymd 1)
        if (want == "year") {
            return (to_string y)
        }
        if (want == "quarter") {
            def q:int ((idiv (m - 1) 3) + 1)
            return (((to_string y) + " Q") + (to_string q))
        }
        def mm:string (to_string m)
        if (m < 10) {
            mm = ("0" + mm)
        }
        return (((to_string y) + "-") + mm)
    }

    ; How many series one category's buckets have room for. A flat index is
    ; cheaper than a map of pairs, and a chart with more series than this is
    ; not a chart anyone can read — the skill's ladder gives up at eight.
    sfn slotStride:int () {
        return 64
    }

    ; Grow the two parallel bucket arrays as far as `slot` and add to it.
    sfn addTo:void (sums:[double] counts:[int] lows:[double] highs:[double] catBase:int series:int v:double) {
        if (series >= (ChartData.slotStride())) {
            return
        }
        def slot:int (catBase + series)
        while ((array_length sums) <= slot) {
            push sums 0.0
            push counts 0
            push lows 0.0
            push highs 0.0
        }
        def seen:int (itemAt counts slot)
        set_at sums slot ((itemAt sums slot) + v)
        set_at counts slot (seen + 1)
        ; The first value is both the smallest and the largest; after that the
        ; comparison decides. Seeding with zero instead would make every
        ; minimum of a column of positive numbers zero.
        if (seen == 0) {
            set_at lows slot v
            set_at highs slot v
        } {
            if (v < (itemAt lows slot)) {
                set_at lows slot v
            }
            if (v > (itemAt highs slot)) {
                set_at highs slot v
            }
        }
    }

    ; Can this selection be drawn as `kind` at all? The picker greys out what
    ; answers false rather than drawing something misleading — a pie of six
    ; series, a line of one point, a scatter with nothing to plot against.
    fn suits:boolean (kind:int) {
        if (points == 0) {
            return false
        }
        def nc:int (this.catCount())
        def ns:int (this.seriesCount())
        ; Stacking needs something to stack.
        if (kind == (ChartKind.stacked())) {
            return (ns >= 2)
        }
        if (kind == (ChartKind.normalized())) {
            return (ns >= 2)
        }
        if (kind == (ChartKind.stackedArea())) {
            if (ns < 2) {
                return false
            }
            return (nc >= 2)
        }
        if (kind == (ChartKind.stream())) {
            if (ns < 2) {
                return false
            }
            return (nc >= 3)
        }
        ; A line, an area or a strip of one point is a dot.
        if (kind == (ChartKind.line())) {
            return (nc >= 2)
        }
        if (kind == (ChartKind.lineDots())) {
            return (nc >= 2)
        }
        if (kind == (ChartKind.step())) {
            return (nc >= 2)
        }
        if (kind == (ChartKind.smooth())) {
            return (nc >= 3)
        }
        if (kind == (ChartKind.area())) {
            return (nc >= 2)
        }
        if (kind == (ChartKind.strip())) {
            return (nc >= 2)
        }
        ; A scatter plots one numeric column against another, so it needs two;
        ; a bubble needs a third for the size.
        if (kind == (ChartKind.scatter())) {
            return (ns >= 2)
        }
        if (kind == (ChartKind.bubble())) {
            return (ns >= 3)
        }
        ; A histogram bins ONE column of numbers.
        if (kind == (ChartKind.histogram())) {
            return (points >= 3)
        }
        ; A circle divides one series into slices.
        if (kind == (ChartKind.pie())) {
            if (ns != 1) {
                return false
            }
            return (nc >= 2)
        }
        if (kind == (ChartKind.donut())) {
            if (ns != 1) {
                return false
            }
            return (nc >= 2)
        }
        if (kind == (ChartKind.radial())) {
            if (ns != 1) {
                return false
            }
            return (nc >= 2)
        }
        ; A grid of colour needs a grid.
        if (kind == (ChartKind.heatmap())) {
            if (ns < 2) {
                return false
            }
            return (nc >= 2)
        }
        ; A box needs a spread to describe.
        if (kind == (ChartKind.boxplot())) {
            return (nc >= 3)
        }
        if ((kind == (ChartKind.stackedBar())) || (kind == (ChartKind.normalizedBar()))) {
            return (ns >= 2)
        }
        if ((kind == (ChartKind.normalizedArea())) || ((kind == (ChartKind.stackedLine())) || (kind == (ChartKind.normalizedLine())))) {
            if (ns < 2) {
                return false
            }
            return (nc >= 2)
        }
        ; Lines through XY points need two columns and two points.
        if ((kind == (ChartKind.scatterLines())) || (kind == (ChartKind.scatterSmooth()))) {
            if (ns < 2) {
                return false
            }
            return (nc >= 2)
        }
        ; Columns for the first series, lines for the rest.
        if (kind == (ChartKind.combo())) {
            return (ns >= 2)
        }
        ; Waterfall, funnel and Pareto read one series, as a pie does.
        if ((kind == (ChartKind.waterfall())) || ((kind == (ChartKind.funnel())) || (kind == (ChartKind.pareto())))) {
            if (ns != 1) {
                return false
            }
            return (nc >= 2)
        }
        ; High, low and close: three columns in that order.
        if (kind == (ChartKind.stock())) {
            if (ns < 3) {
                return false
            }
            return (nc >= 2)
        }
        return true
    }

    ; The kind to open the picker on: what the shape of the data suggests.
    fn suggestedKind:int () {
        def ns:int (this.seriesCount())
        def nc:int (this.catCount())
        if catNumeric {
            if (ns == 1) {
                return (ChartKind.line())
            }
        }
        if (ns >= 4) {
            if (nc >= 4) {
                return (ChartKind.heatmap())
            }
        }
        if (ns >= 3) {
            return (ChartKind.stacked())
        }
        if (ns == 1) {
            if (nc >= 6) {
                return (ChartKind.column())
            }
            if (nc >= 2) {
                return (ChartKind.pie())
            }
        }
        return (ChartKind.column())
    }

    ; A channel's `title`, or nothing at all. An empty title is written as one
    ; — that is how a spec says "label this with nothing", and it is what a
    ; column of numbers with no header wants.
    sfn titleMember:string (title:string) {
        return ((",\"title\":\"" + (ChartData.jsonEscape(title))) + "\"")
    }

    sfn jsonEscape:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:int (charAt s i)
            if (ch == 34) {
                out = (out + "\\\"")
            } {
                if (ch == 92) {
                    out = (out + "\\\\")
                } {
                    if (ch < 32) {
                        out = (out + " ")
                    } {
                        out = (out + (substring s i (i + 1)))
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; A double, written so a JSON parser reads it back as the same number.
    ; `to_string` on a whole double gives "3" on some targets and "3.0" on
    ; others; both parse, so this only has to avoid exponent notation.
    sfn num:string (v:double) {
        def neg:boolean (v < 0.0)
        def av:double v
        if neg {
            av = (0.0 - v)
        }
        def rounded:int (to_int ((av * 1000.0) + 0.5))
        if (rounded == 0) {
            return "0"
        }
        def whole:int (idiv rounded 1000)
        def frac:int (rounded - (whole * 1000))
        def out:string (to_string whole)
        if (frac > 0) {
            def digits:string (to_string frac)
            while ((strlen digits) < 3) {
                digits = ("0" + digits)
            }
            out = ((out + ".") + digits)
        }
        if neg {
            out = ("-" + out)
        }
        return out
    }

    ; One JSON row per (category, series) pair that has a number. Pie and donut
    ; read a single series, so they are given the first one only.
    fn rowsJson:string (singleSeries:boolean) {
        def out:string ""
        def ns:int (this.seriesCount())
        def nc:int (this.catCount())
        def wrote:int 0
        def ci:int 0
        while (ci < nc) {
            def si:int 0
            def upto:int ns
            if singleSeries {
                upto = 1
            }
            while (si < upto) {
                def at:int ((ci * ns) + si)
                if (itemAt filled at) {
                    if (wrote > 0) {
                        out = (out + ",")
                    }
                    def cat:string (this.shownCat(ci))
                    out = (out + "{\"cat\":")
                    if catNumeric {
                        out = (out + cat)
                    } {
                        out = ((out + "\"") + (ChartData.jsonEscape(cat)) + "\"")
                    }
                    out = ((out + ",\"series\":\"") + (ChartData.jsonEscape((itemAt series si))) + "\"")
                    out = ((out + ",\"value\":") + (ChartData.num((itemAt values at))) + "}")
                    wrote = (wrote + 1)
                }
                si = (si + 1)
            }
            ci = (ci + 1)
        }
        return out
    }

    ; The category channel's type. A numeric first column is a real axis for
    ; the marks that have one; a bar always bands, because a bar of a
    ; continuous x is a histogram and that is a different chart.
    fn catType:string (kind:int) {
        if (kind == (ChartKind.line())) {
            if catNumeric {
                return "quantitative"
            }
        }
        if (kind == (ChartKind.area())) {
            if catNumeric {
                return "quantitative"
            }
        }
        if (kind == (ChartKind.scatter())) {
            return "quantitative"
        }
        return "nominal"
    }

    ; One row per point in the XY shape: the first value column against the
    ; second, with a third as the size when there is one. A scatter is asking a
    ; different question of the same selection than a column chart is — "how do
    ; these two columns move together" rather than "how big is each category" —
    ; and that question needs its own rows.
    fn rowsXyJson:string () {
        def out:string ""
        def ns:int (this.seriesCount())
        def nc:int (this.catCount())
        if (ns < 2) {
            return ""
        }
        def wrote:int 0
        def ci:int 0
        while (ci < nc) {
            def base:int (ci * ns)
            def haveX:boolean (itemAt filled base)
            def haveY:boolean (itemAt filled (base + 1))
            if (haveX && haveY) {
                if (wrote > 0) {
                    out = (out + ",")
                }
                out = (out + "{\"x\":" + (ChartData.num((itemAt values base))))
                out = (out + ",\"y\":" + (ChartData.num((itemAt values (base + 1)))))
                if (ns >= 3) {
                    def sz:double 0.0
                    if (itemAt filled (base + 2)) {
                        sz = (itemAt values (base + 2))
                    }
                    out = (out + ",\"size\":" + (ChartData.num(sz)))
                }
                out = ((out + ",\"label\":\"") + (ChartData.jsonEscape((itemAt cats ci))) + "\"")
                out = (out + "}")
                wrote = (wrote + 1)
            }
            ci = (ci + 1)
        }
        return out
    }

    ; The colour channel, or nothing. A chart of one series has nothing to tell
    ; apart, and a legend of one entry is furniture.
    fn colourJson:string (ch:GridChart field:string title:string) {
        def out:string ("\"color\":{\"field\":\"" + field + "\",\"type\":\"nominal\"" + (ChartData.titleMember(title)))
        ; Same reason as the category axis: the colour scale's domain is what
        ; orders a pie's wedges and its key, and sorted alphabetically the key
        ; read Apr, Feb, Jan while the wedges ran Jan, Feb, Mar.
        out = (out + ",\"sort\":null")
        ; Colours chosen in the Format pane, on the scale itself: a palette in
        ; `config.range` is read only as a scheme name.
        def pal:string (ChartData.paletteOf(ch))
        if ((strlen pal) > 0) {
            out = (out + ",\"scale\":{\"range\":[" + pal + "]}")
        }
        if (ch.showLegend == false) {
            out = (out + ",\"legend\":null")
        }
        return (out + "}")
    }

    ; The whole Vega-Lite specification, sized to the box it will be drawn in.
    fn specJson:string (ch:GridChart plotW:int plotH:int) {
        def keepCat:string catTitle
        def keepValue:string valueTitle
        ; A small chart keeps its words inside its box: titles and category
        ; names are cut with an ellipsis to the room they have.
        catTitle = (ChartData.clipText(catTitle (to_int ((to_double plotW) / 7.5))))
        valueTitle = (ChartData.clipText(valueTitle (to_int ((to_double plotH) / 7.5))))
        catClip = 0
        if (((this.catCount()) > 0) && (catNumeric == false)) {
            if (this.levelLabels()) {
                catClip = (to_int (((to_double plotW) / (to_double (this.catCount()))) / 6.0))
            } {
                catClip = (to_int (((to_double plotH) * 0.45) / 5.5))
            }
            if (catClip < 8) {
                catClip = 8
            }
        }
        def spec:string (this.specJsonIn(ch plotW plotH))
        catTitle = keepCat
        valueTitle = keepValue
        catClip = 0
        return spec
    }

    ; `s` cut to `most` characters, the last of them an ellipsis.
    sfn clipText:string (s:string most:int) {
        if ((strlen s) <= most) {
            return s
        }
        if (most < 2) {
            return "…"
        }
        return ((substring s 0 (most - 1)) + "…")
    }

    ; A category as the axis shows it: clipped to `catClip`, unless that would
    ; make it read the same as an earlier one.
    fn shownCat:string (ci:int) {
        def cat:string (itemAt cats ci)
        if ((catClip <= 0) || ((strlen cat) <= catClip)) {
            return cat
        }
        def cut:string (ChartData.clipText(cat catClip))
        def k:int 0
        while (k < ci) {
            if ((ChartData.clipText((itemAt cats k) catClip)) == cut) {
                return cat
            }
            k = (k + 1)
        }
        return cut
    }

    fn specJsonIn:string (ch:GridChart plotW:int plotH:int) {
        def kind:int ch.kind
        if ((strlen ch.xTitle) > 0) {
            catTitle = ch.xTitle
        }
        if ((strlen ch.yTitle) > 0) {
            valueTitle = ch.yTitle
        }
        if (ch.axisTitles == false) {
            catTitle = ""
            valueTitle = ""
            seriesTitle = ""
        }
        def single:boolean false
        if (kind == (ChartKind.pie())) {
            single = true
        }
        if (kind == (ChartKind.donut())) {
            single = true
        }
        if (kind == (ChartKind.radial())) {
            single = true
        }
        def out:string "{"
        out = ((out + "\"width\":") + (to_string plotW) + ",\"height\":" + (to_string plotH))
        def bg:string (ChartStyle.background(ch.style))
        if ((strlen ch.areaFill) > 0) {
            bg = ch.areaFill
        }
        out = ((out + ",\"background\":\"") + (ChartData.jsonEscape(bg)) + "\"")
        if ((strlen ch.title) > 0) {
            def shownTitle:string (ChartData.clipText(ch.title (to_int (((to_double plotW) + 60.0) / 7.5))))
            out = ((out + ",\"title\":\"") + (ChartData.jsonEscape(shownTitle)) + "\"")
        }
        def rows:string ""
        if (ChartKind.wantsXY(kind)) {
            rows = (this.rowsXyJson())
        } {
            rows = (this.rowsJson(single))
        }
        if (kind == (ChartKind.combo())) {
            rows = (this.comboRowsJson())
        }
        if (kind == (ChartKind.waterfall())) {
            rows = (this.waterfallRowsJson())
        }
        if (kind == (ChartKind.funnel())) {
            rows = (this.funnelRowsJson())
        }
        if (kind == (ChartKind.pareto())) {
            rows = (this.paretoRowsJson())
        }
        if (kind == (ChartKind.stock())) {
            rows = (this.stockRowsJson())
        }
        if (kind == (ChartKind.stackedLine())) {
            rows = (this.stackedLineRowsJson(false))
        }
        if (kind == (ChartKind.normalizedLine())) {
            rows = (this.stackedLineRowsJson(true))
        }
        out = ((out + ",\"data\":{\"values\":[") + rows + "]}")

        def multi:boolean ((this.seriesCount()) > 1)
        def colour:string (this.colourJson(ch "series" seriesTitle))
        def catColour:string (this.colourJson(ch "cat" catTitle))
        def stackedKind:boolean ((kind == 3) || ((kind == 11) || ((kind == 21) || (kind == 30))))
        def extras:string (this.valueExtras(ch stackedKind))
        def valueField:string ("\"field\":\"value\",\"type\":\"quantitative\"" + (ChartData.titleMember(valueTitle)) + extras)
        def plainValue:string ("\"field\":\"value\",\"type\":\"quantitative\"" + (ChartData.titleMember(valueTitle)))
        ; Categories keep the order the SHEET put them in. Vega-Lite sorts a
        ; nominal domain alphabetically, which turned Jan..Jun into
        ; Apr, Feb, Jan, Jun, Mar, May — right for a bar chart of names,
        ; wrong for every table a spreadsheet draws.
        def catOrder:string ""
        if ((this.catType(kind)) != "quantitative") {
            catOrder = ",\"sort\":null"
        }
        def catField:string ("\"field\":\"cat\",\"type\":\"" + (this.catType(kind)) + "\"" + (ChartData.titleMember(catTitle)) + catOrder)
        def sumField:string ("\"field\":\"value\",\"type\":\"quantitative\",\"aggregate\":\"sum\"" + (ChartData.titleMember(valueTitle)) + extras)
        def normField:string ("\"field\":\"value\",\"type\":\"quantitative\",\"aggregate\":\"sum\",\"stack\":\"normalize\"" + (ChartData.titleMember(valueTitle)) + ",\"axis\":{\"format\":\".0%\"}")
        def xyY:string ("\"field\":\"y\",\"type\":\"quantitative\"" + (ChartData.titleMember((this.seriesName(1)))) + extras)
        def xyX:string ("\"field\":\"x\",\"type\":\"quantitative\"" + (ChartData.titleMember((this.seriesName(0)))))
        def plainCat:string ("\"field\":\"cat\",\"type\":\"nominal\"" + (ChartData.titleMember(catTitle)) + ",\"sort\":null")

        ; --- bars ---
        if (kind == (ChartKind.column())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"x\":{" + catField + "},\"y\":{" + valueField + "}")
            if multi {
                out = (out + "," + colour + ",\"xOffset\":{\"field\":\"series\",\"type\":\"nominal\"}")
            }
            out = (out + "}")
        }
        if (kind == (ChartKind.bar())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"y\":{" + catField + "},\"x\":{" + valueField + "}")
            if multi {
                out = (out + "," + colour + ",\"yOffset\":{\"field\":\"series\",\"type\":\"nominal\"}")
            }
            out = (out + "}")
        }
        if (kind == (ChartKind.stacked())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"x\":{" + catField + "},\"y\":{" + sumField + "}," + colour + "}")
        }
        if (kind == (ChartKind.normalized())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"x\":{" + catField + "},\"y\":{\"field\":\"value\",\"type\":\"quantitative\",\"aggregate\":\"sum\",\"stack\":\"normalize\"}," + colour + "}")
        }
        if (kind == (ChartKind.histogram())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"x\":{\"field\":\"value\",\"type\":\"quantitative\",\"bin\":true" + (ChartData.titleMember(valueTitle)) + "},\"y\":{\"aggregate\":\"count\"}}")
        }

        ; --- lines ---
        if (kind == (ChartKind.line())) {
            out = (out + ",\"mark\":\"line\",\"encoding\":{\"x\":{" + catField + "},\"y\":{" + valueField + "}")
            if multi {
                out = (out + "," + colour)
            }
            out = (out + "}")
        }
        if (kind == (ChartKind.lineDots())) {
            out = (out + ",\"mark\":{\"type\":\"line\",\"point\":true},\"encoding\":{\"x\":{" + catField + "},\"y\":{" + valueField + "}")
            if multi {
                out = (out + "," + colour)
            }
            out = (out + "}")
        }
        if (kind == (ChartKind.step())) {
            out = (out + ",\"mark\":{\"type\":\"line\",\"interpolate\":\"step-after\"},\"encoding\":{\"x\":{" + catField + "},\"y\":{" + valueField + "}")
            if multi {
                out = (out + "," + colour)
            }
            out = (out + "}")
        }
        if (kind == (ChartKind.smooth())) {
            out = (out + ",\"mark\":{\"type\":\"line\",\"interpolate\":\"monotone\"},\"encoding\":{\"x\":{" + catField + "},\"y\":{" + valueField + "}")
            if multi {
                out = (out + "," + colour)
            }
            out = (out + "}")
        }

        ; --- areas ---
        if (kind == (ChartKind.area())) {
            out = (out + ",\"mark\":{\"type\":\"area\",\"opacity\":0.85},\"encoding\":{\"x\":{" + catField + "},\"y\":{" + valueField + "}")
            if multi {
                out = (out + "," + colour)
            }
            out = (out + "}")
        }
        if (kind == (ChartKind.stackedArea())) {
            out = (out + ",\"mark\":\"area\",\"encoding\":{\"x\":{" + catField + "},\"y\":{" + sumField + "}," + colour + "}")
        }
        if (kind == (ChartKind.stream())) {
            out = (out + ",\"mark\":\"area\",\"encoding\":{\"x\":{" + catField + "},\"y\":{\"field\":\"value\",\"type\":\"quantitative\",\"stack\":\"center\"}," + colour + "}")
        }

        ; --- points ---
        if (kind == (ChartKind.scatter())) {
            out = (out + ",\"mark\":{\"type\":\"point\",\"filled\":true,\"size\":70},\"encoding\":{\"x\":{\"field\":\"x\",\"type\":\"quantitative\"" + (ChartData.titleMember((this.seriesName(0)))) + "},\"y\":{\"field\":\"y\",\"type\":\"quantitative\"" + (ChartData.titleMember((this.seriesName(1)))) + "}}")
        }
        if (kind == (ChartKind.bubble())) {
            out = (out + ",\"mark\":{\"type\":\"point\",\"filled\":true,\"opacity\":0.7},\"encoding\":{\"x\":{\"field\":\"x\",\"type\":\"quantitative\"" + (ChartData.titleMember((this.seriesName(0)))) + "},\"y\":{\"field\":\"y\",\"type\":\"quantitative\"" + (ChartData.titleMember((this.seriesName(1)))) + "},\"size\":{\"field\":\"size\",\"type\":\"quantitative\"" + (ChartData.titleMember((this.seriesName(2)))) + "}}")
        }
        if (kind == (ChartKind.strip())) {
            out = (out + ",\"mark\":{\"type\":\"tick\",\"thickness\":2},\"encoding\":{\"x\":{" + valueField + "},\"y\":{" + catField + "}")
            if multi {
                out = (out + "," + colour)
            }
            out = (out + "}")
        }

        ; --- circles ---
        if (kind == (ChartKind.pie())) {
            out = (out + ",\"mark\":\"arc\",\"encoding\":{\"theta\":{" + plainValue + "}," + catColour + "}")
        }
        if (kind == (ChartKind.donut())) {
            out = (out + ",\"mark\":{\"type\":\"arc\",\"innerRadius\":40},\"encoding\":{\"theta\":{" + plainValue + "}," + catColour + "}")
        }
        if (kind == (ChartKind.radial())) {
            out = (out + ",\"mark\":{\"type\":\"arc\",\"innerRadius\":18},\"encoding\":{\"theta\":{" + plainValue + "},\"radius\":{\"field\":\"value\",\"type\":\"quantitative\",\"scale\":{\"type\":\"sqrt\",\"zero\":true,\"rangeMin\":18}}," + catColour + "}")
        }

        ; --- matrices ---
        if (kind == (ChartKind.heatmap())) {
            out = (out + ",\"mark\":\"rect\",\"encoding\":{\"x\":{" + catField + "},\"y\":{\"field\":\"series\",\"type\":\"nominal\"" + (ChartData.titleMember(seriesTitle)) + "},\"color\":{" + plainValue)
            if (ch.showLegend == false) {
                out = (out + ",\"legend\":null")
            }
            out = (out + "}}")
        }
        if (kind == (ChartKind.boxplot())) {
            out = (out + ",\"mark\":\"boxplot\",\"encoding\":{\"x\":{\"field\":\"series\",\"type\":\"nominal\"" + (ChartData.titleMember(seriesTitle)) + "},\"y\":{" + valueField + "}}")
        }

        ; --- more bars, lines and areas ---
        if (kind == (ChartKind.stackedBar())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"y\":{" + catField + "},\"x\":{" + sumField + "}," + colour + "}")
        }
        if (kind == (ChartKind.normalizedBar())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"y\":{" + catField + "},\"x\":{" + normField + "}," + colour + "}")
        }
        if (kind == (ChartKind.normalizedArea())) {
            out = (out + ",\"mark\":\"area\",\"encoding\":{\"x\":{" + catField + "},\"y\":{" + normField + "}," + colour + "}")
        }
        if (kind == (ChartKind.stackedLine())) {
            out = (out + ",\"mark\":\"line\",\"encoding\":{\"x\":{" + catField + "},\"y\":{\"field\":\"top\",\"type\":\"quantitative\"" + (ChartData.titleMember(valueTitle)) + extras + "}," + colour + "}")
        }
        if (kind == (ChartKind.normalizedLine())) {
            out = (out + ",\"mark\":\"line\",\"encoding\":{\"x\":{" + catField + "},\"y\":{\"field\":\"top\",\"type\":\"quantitative\"" + (ChartData.titleMember(valueTitle)) + ",\"scale\":{\"domain\":[0,1]},\"axis\":{\"format\":\".0%\"}}," + colour + "}")
        }
        if (kind == (ChartKind.scatterLines())) {
            out = (out + ",\"mark\":{\"type\":\"line\",\"point\":true},\"encoding\":{\"x\":{" + xyX + "},\"y\":{" + xyY + "}}")
        }
        if (kind == (ChartKind.scatterSmooth())) {
            out = (out + ",\"mark\":{\"type\":\"line\",\"point\":true,\"interpolate\":\"monotone\"},\"encoding\":{\"x\":{" + xyX + "},\"y\":{" + xyY + "}}")
        }
        if (kind == (ChartKind.waterfall())) {
            def wfColour:string ("\"color\":{\"field\":\"series\",\"type\":\"nominal\",\"title\":\"\",\"scale\":{\"domain\":[\"Increase\",\"Decrease\"],\"range\":[\"#4472C4\",\"#ED7D31\"]}")
            if (ch.showLegend == false) {
                wfColour = (wfColour + ",\"legend\":null")
            }
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"x\":{" + plainCat + "},\"y\":{\"field\":\"start\",\"type\":\"quantitative\"" + (ChartData.titleMember(valueTitle)) + extras + "},\"y2\":{\"field\":\"end\"}," + wfColour + "}}")
        }
        if (kind == (ChartKind.funnel())) {
            out = (out + ",\"mark\":\"bar\",\"encoding\":{\"y\":{" + plainCat + "},\"x\":{\"field\":\"lo\",\"type\":\"quantitative\",\"axis\":null},\"x2\":{\"field\":\"hi\"}}")
        }

        ; --- layered ---
        if (kind == (ChartKind.combo())) {
            def lineColour:string (this.colourJson(ch "series" seriesTitle))
            out = (out + ",\"encoding\":{\"x\":{" + plainCat + "}}")
            out = (out + ",\"layer\":[{\"transform\":[{\"filter\":\"datum.lead == 1\"}],\"mark\":\"bar\",\"encoding\":{\"y\":{" + valueField + "}," + lineColour + "}}")
            out = (out + ",{\"transform\":[{\"filter\":\"datum.lead == 0\"}],\"mark\":{\"type\":\"line\",\"point\":true},\"encoding\":{\"y\":{" + valueField + "}," + lineColour + "}}]")
        }
        if (kind == (ChartKind.pareto())) {
            out = (out + ",\"encoding\":{\"x\":{" + plainCat + "}}")
            out = (out + ",\"layer\":[{\"mark\":\"bar\",\"encoding\":{\"y\":{" + valueField + "}}}")
            out = (out + ",{\"mark\":{\"type\":\"line\",\"point\":true,\"color\":\"#ED7D31\"},\"encoding\":{\"y\":{\"field\":\"cum\",\"type\":\"quantitative\",\"title\":\"\",\"scale\":{\"domain\":[0,1]},\"axis\":{\"format\":\".0%\",\"orient\":\"right\"}}}}]")
            out = (out + ",\"resolve\":{\"scale\":{\"y\":\"independent\"}}")
        }
        if (kind == (ChartKind.stock())) {
            def stockY:string ("\"type\":\"quantitative\"" + (ChartData.titleMember(valueTitle)) + extras)
            out = (out + ",\"encoding\":{\"x\":{" + plainCat + "}}")
            out = (out + ",\"layer\":[{\"mark\":\"rule\",\"encoding\":{\"y\":{\"field\":\"low\"," + stockY + ",\"scale\":{\"zero\":false}},\"y2\":{\"field\":\"high\"}}}")
            out = (out + ",{\"mark\":{\"type\":\"tick\",\"thickness\":2},\"encoding\":{\"y\":{\"field\":\"close\",\"type\":\"quantitative\"}}}]")
        }

        out = (this.decorate(ch out))
        def cfg:string (ChartStyle.configJson(ch.style (this.levelLabels())))
        if (ch.gridlines == "off") {
            cfg = (ChartData.replaceOnce(cfg "\"axis\":{" "\"axis\":{\"grid\":false,"))
        }
        if (ch.gridlines == "on") {
            cfg = (ChartData.replaceOnce(cfg "\"grid\":false," ""))
            cfg = (ChartData.replaceOnce(cfg "\"axis\":{" "\"axis\":{\"grid\":true,"))
        }
        if ((strlen ch.fillColor) > 0) {
            def scheme:string ("\"range\":{\"category\":{\"scheme\":\"" + ((ChartStyle.scheme(ch.style)) + "\"}}"))
            def fill:string ("\"range\":{\"category\":[\"" + (ch.fillColor + "\",\"#ED7D31\",\"#A5A5A5\",\"#FFC000\",\"#5B9BD5\",\"#70AD47\"]}"))
            cfg = (ChartData.replaceOnce(cfg scheme fill))
            if ((strlen ch.seriesColors) == 0) {
                cfg = (ChartData.replaceOnce(cfg "\"config\":{" ("\"config\":{\"mark\":{\"color\":\"" + (ch.fillColor + "\"},"))))
            }
        }
        if ((strlen ch.seriesColors) > 0) {
            def firstCol:string (ChartData.colourList(ch.seriesColors))
            def endQ:int (indexOf firstCol "\"," )
            if (endQ > 0) {
                firstCol = (substring firstCol 0 (endQ + 1))
            }
            cfg = (ChartData.replaceOnce(cfg "\"config\":{" ("\"config\":{\"mark\":{\"color\":" + (firstCol + "},"))))
        }
        if ((strlen ch.seriesColors) > 0) {
            def scheme2:string ("\"range\":{\"category\":{\"scheme\":\"" + ((ChartStyle.scheme(ch.style)) + "\"}}"))
            cfg = (ChartData.replaceOnce(cfg scheme2 ("\"range\":{\"category\":[" + (ChartData.colourList(ch.seriesColors)) + "]}")))
        }
        if ((strlen ch.legendPos) > 0) {
            cfg = (ChartData.replaceOnce(cfg "\"legend\":{" ("\"legend\":{\"orient\":\"" + ch.legendPos + "\",")))
        }
        if (ch.titleSize > 0) {
            cfg = (ChartData.replaceOnce(cfg "\"fontSize\":13,\"offset\"" ("\"fontSize\":" + (to_string ch.titleSize) + ",\"offset\"")))
        }
        out = ((out + ",") + cfg)
        return (out + "}")
    }

    ; The colours the series are drawn in when the reader chose them: the
    ; Format pane's list, or Shape Fill followed by Excel's next colours.
    sfn paletteOf:string (ch:GridChart) {
        if ((strlen ch.seriesColors) > 0) {
            return (ChartData.colourList(ch.seriesColors))
        }
        if ((strlen ch.fillColor) > 0) {
            return ("\"" + (ChartData.jsonEscape(ch.fillColor)) + "\",\"#ED7D31\",\"#A5A5A5\",\"#FFC000\",\"#5B9BD5\",\"#70AD47\"")
        }
        return ""
    }

    ; "red, #00f" as a JSON list of strings.
    sfn colourList:string (text:string) {
        def out:string ""
        def rest:string text
        while ((strlen rest) > 0) {
            def comma:int (indexOf rest ",")
            def part:string rest
            if (comma >= 0) {
                part = (substring rest 0 comma)
                rest = (substring rest (comma + 1) (strlen rest))
            } {
                rest = ""
            }
            def t:string (trim part)
            if ((strlen t) > 0) {
                if ((strlen out) > 0) {
                    out = (out + ",")
                }
                out = (out + "\"" + (ChartData.jsonEscape(t)) + "\"")
            }
        }
        return out
    }

    sfn replaceOnce:string (s:string find:string repl:string) {
        def at:int (indexOf s find)
        if (at < 0) {
            return s
        }
        return ((substring s 0 at) + (repl + (substring s (at + (strlen find)) (strlen s))))
    }

    ; Outline and data labels, worked into the mark the kind chose. Labels are
    ; a text layer over the same encoding, which is how Vega-Lite does it.
    fn decorate:string (ch:GridChart spec:string) {
        def at:int (indexOf spec ",\"mark\":")
        if (at < 0) {
            return spec
        }
        if (ChartKind.layered(ch.kind)) {
            return spec
        }
        def head:string (substring spec 0 at)
        def tail:string (substring spec (at + 8) (strlen spec))
        def encAt:int (indexOf tail ",\"encoding\":")
        if (encAt < 0) {
            return spec
        }
        def mark:string (substring tail 0 encAt)
        def enc:string (substring tail (encAt + 12) (strlen tail))
        if ((strlen ch.outlineColor) > 0) {
            def stroke:string ("\"stroke\":\"" + (ch.outlineColor + "\",\"strokeWidth\":1.5"))
            if ((charAt mark 0) == 34) {
                mark = ("{\"type\":" + (mark + ("," + (stroke + "}"))))
            } {
                mark = ("{" + (stroke + ("," + (substring mark 1 (strlen mark)))))
            }
        }
        def k:int ch.kind
        def liney:boolean ((k >= 6) && (k <= 9))
        if ((k == 24) || ((k == 30) || ((k == 31) || (k == 32)))) {
            liney = true
        }
        if (liney && (ch.lineWidth > 0)) {
            def sw:string ("\"strokeWidth\":" + (to_string ch.lineWidth))
            if ((charAt mark 0) == 34) {
                mark = ("{\"type\":" + (mark + ("," + (sw + "}"))))
            } {
                mark = ("{" + (sw + ("," + (substring mark 1 (strlen mark)))))
            }
        }
        def labelled:boolean (ch.dataLabels && ((k == 1) || ((k == 2) || ((k == 6) || (k == 7)))))
        if (labelled == false) {
            return (head + (",\"mark\":" + (mark + (",\"encoding\":" + enc))))
        }
        def offset:string "\"dy\":-7"
        if (k == 2) {
            offset = "\"dx\":14"
        }
        if (ch.labelPos == "inside") {
            offset = "\"dy\":9"
            if (k == 2) {
                offset = "\"dx\":-14"
            }
            if (k == 1) {
                offset = (offset + ",\"color\":\"#ffffff\"")
            }
            if (k == 2) {
                offset = (offset + ",\"color\":\"#ffffff\"")
            }
        }
        def lf:string (ChartData.d3Format(ch.numFormat))
        if ((strlen lf) == 0) {
            lf = ","
        }
        def label:string ("{\"mark\":{\"type\":\"text\"," + (offset + (",\"fontSize\":9},\"encoding\":{\"text\":{\"field\":\"value\",\"type\":\"quantitative\",\"format\":\"" + ((ChartData.jsonEscape(lf)) + "\"}}}"))))
        return (head + (",\"encoding\":" + (enc + (",\"layer\":[{\"mark\":" + (mark + ("}," + (label + "]")))))))
    }

    ; Whether the category names are short enough to read lying down. Six
    ; characters and a dozen of them is what fits under a chart the size of a
    ; sticky panel; past that they are stood on end, as Vega-Lite does.
    fn levelLabels:boolean () {
        if ((array_length cats) > 12) {
            return false
        }
        def i:int 0
        while (i < (array_length cats)) {
            def c:string (itemAt cats i)
            if ((strlen c) > 6) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; The value at (category, series), and whether there is one.
    fn has:boolean (ci:int si:int) {
        def ns:int (this.seriesCount())
        if ((si >= ns) || (ci >= (this.catCount()))) {
            return false
        }
        return (itemAt filled ((ci * ns) + si))
    }

    fn at:double (ci:int si:int) {
        def ns:int (this.seriesCount())
        return (itemAt values ((ci * ns) + si))
    }

    ; A category as a JSON value: a number when the axis is numeric.
    fn catJson:string (ci:int) {
        def cat:string (this.shownCat(ci))
        if catNumeric {
            return cat
        }
        return ("\"" + (ChartData.jsonEscape(cat)) + "\"")
    }

    ; The largest value, or the largest category total when `stacked`; the
    ; smallest value. What a bound left empty falls back to.
    fn extent:double (stacked:boolean high:boolean) {
        def ns:int (this.seriesCount())
        def nc:int (this.catCount())
        def best:double 0.0
        def ci:int 0
        while (ci < nc) {
            def total:double 0.0
            def si:int 0
            while (si < ns) {
                if (this.has(ci si)) {
                    def v:double (this.at(ci si))
                    if stacked {
                        if (v > 0.0) {
                            total = (total + v)
                        }
                    } {
                        if high {
                            if (v > best) {
                                best = v
                            }
                        } {
                            if (v < best) {
                                best = v
                            }
                        }
                    }
                }
                si = (si + 1)
            }
            if (stacked && (total > best)) {
                best = total
            }
            ci = (ci + 1)
        }
        return best
    }

    ; The first series with a flag on each row: 1 for the series drawn as
    ; columns in a combo chart, 0 for the ones drawn as lines.
    fn comboRowsJson:string () {
        def out:string ""
        def ns:int (this.seriesCount())
        def nc:int (this.catCount())
        def wrote:int 0
        def ci:int 0
        while (ci < nc) {
            def si:int 0
            while (si < ns) {
                if (this.has(ci si)) {
                    if (wrote > 0) {
                        out = (out + ",")
                    }
                    def lead:string "0"
                    if (si == 0) {
                        lead = "1"
                    }
                    out = (out + "{\"cat\":" + (this.catJson(ci)) + ",\"series\":\"" + (ChartData.jsonEscape((itemAt series si))) + "\",\"value\":" + (ChartData.num((this.at(ci si)))) + ",\"lead\":" + lead + "}")
                    wrote = (wrote + 1)
                }
                si = (si + 1)
            }
            ci = (ci + 1)
        }
        return out
    }

    ; Waterfall: each bar runs from the running total before it to the one
    ; after, coloured by which way it went.
    fn waterfallRowsJson:string () {
        def out:string ""
        def nc:int (this.catCount())
        def run:double 0.0
        def wrote:int 0
        def ci:int 0
        while (ci < nc) {
            if (this.has(ci 0)) {
                def v:double (this.at(ci 0))
                def dir:string "Increase"
                if (v < 0.0) {
                    dir = "Decrease"
                }
                if (wrote > 0) {
                    out = (out + ",")
                }
                out = (out + "{\"cat\":" + (this.catJson(ci)) + ",\"start\":" + (ChartData.num(run)) + ",\"end\":" + (ChartData.num((run + v))) + ",\"value\":" + (ChartData.num(v)) + ",\"series\":\"" + dir + "\"}")
                run = (run + v)
                wrote = (wrote + 1)
            }
            ci = (ci + 1)
        }
        return out
    }

    ; Funnel: each bar centred on zero, half its value either side.
    fn funnelRowsJson:string () {
        def out:string ""
        def nc:int (this.catCount())
        def wrote:int 0
        def ci:int 0
        while (ci < nc) {
            if (this.has(ci 0)) {
                def v:double (this.at(ci 0))
                if (v < 0.0) {
                    v = (0.0 - v)
                }
                if (wrote > 0) {
                    out = (out + ",")
                }
                out = (out + "{\"cat\":" + (this.catJson(ci)) + ",\"lo\":" + (ChartData.num((0.0 - (v / 2.0)))) + ",\"hi\":" + (ChartData.num((v / 2.0))) + ",\"value\":" + (ChartData.num(v)) + "}")
                wrote = (wrote + 1)
            }
            ci = (ci + 1)
        }
        return out
    }

    ; Pareto: categories largest first, with the running share of the total.
    fn paretoRowsJson:string () {
        def nc:int (this.catCount())
        def order:[int]
        def total:double 0.0
        def ci:int 0
        while (ci < nc) {
            if ((this.has(ci 0)) && ((this.at(ci 0)) > 0.0)) {
                def v:double (this.at(ci 0))
                def pos:int 0
                while ((pos < (array_length order)) && ((this.at((itemAt order pos) 0)) >= v)) {
                    pos = (pos + 1)
                }
                insert order pos ci
                total = (total + v)
            }
            ci = (ci + 1)
        }
        def out:string ""
        def run:double 0.0
        def i:int 0
        while (i < (array_length order)) {
            def c:int (itemAt order i)
            def v:double (this.at(c 0))
            run = (run + v)
            def share:double 0.0
            if (total != 0.0) {
                share = (run / total)
            }
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "{\"cat\":" + (this.catJson(c)) + ",\"value\":" + (ChartData.num(v)) + ",\"cum\":" + (ChartData.num(share)) + "}")
            i = (i + 1)
        }
        return out
    }

    ; Stacked lines: each series drawn at the running total of the series
    ; before it, or at the running share of the category's total when
    ; `normalize`. Worked out here because a line does not stack by itself.
    fn stackedLineRowsJson:string (normalize:boolean) {
        def out:string ""
        def ns:int (this.seriesCount())
        def nc:int (this.catCount())
        def wrote:int 0
        def ci:int 0
        while (ci < nc) {
            def total:double 0.0
            def si:int 0
            while (si < ns) {
                if (this.has(ci si)) {
                    total = (total + (this.at(ci si)))
                }
                si = (si + 1)
            }
            def run:double 0.0
            si = 0
            while (si < ns) {
                if (this.has(ci si)) {
                    run = (run + (this.at(ci si)))
                    def top:double run
                    if normalize {
                        top = 0.0
                        if (total != 0.0) {
                            top = (run / total)
                        }
                    }
                    if (wrote > 0) {
                        out = (out + ",")
                    }
                    out = (out + "{\"cat\":" + (this.catJson(ci)) + ",\"series\":\"" + (ChartData.jsonEscape((itemAt series si))) + "\",\"value\":" + (ChartData.num((this.at(ci si)))) + ",\"top\":" + (ChartData.num(top)) + "}")
                    wrote = (wrote + 1)
                }
                si = (si + 1)
            }
            ci = (ci + 1)
        }
        return out
    }

    ; Stock: the first three series read as high, low and close.
    fn stockRowsJson:string () {
        def out:string ""
        def nc:int (this.catCount())
        def wrote:int 0
        def ci:int 0
        while (ci < nc) {
            if ((this.has(ci 0)) && ((this.has(ci 1)) && (this.has(ci 2)))) {
                if (wrote > 0) {
                    out = (out + ",")
                }
                out = (out + "{\"cat\":" + (this.catJson(ci)) + ",\"high\":" + (ChartData.num((this.at(ci 0)))) + ",\"low\":" + (ChartData.num((this.at(ci 1)))) + ",\"close\":" + (ChartData.num((this.at(ci 2)))) + "}")
                wrote = (wrote + 1)
            }
            ci = (ci + 1)
        }
        return out
    }

    ; An Excel number format as the d3 format a chart axis reads: decimals
    ; from the zeroes after the point, a comma for grouping, % and $ kept.
    ; Something already in d3's grammar passes through.
    sfn d3Format:string (fmt:string) {
        if ((strlen fmt) == 0) {
            return ""
        }
        if ((indexOf fmt "0") < 0) {
            if ((indexOf fmt "#") < 0) {
                return fmt
            }
        }
        def dec:int 0
        def dot:int (indexOf fmt ".")
        if (dot >= 0) {
            def i:int (dot + 1)
            while ((i < (strlen fmt)) && (((charAt fmt i) == 48) || ((charAt fmt i) == 35))) {
                dec = (dec + 1)
                i = (i + 1)
            }
        }
        def out:string ""
        if ((indexOf fmt "$") >= 0) {
            out = "$"
        }
        if ((indexOf fmt ",") >= 0) {
            out = (out + ",")
        }
        out = (out + "." + (to_string dec))
        if ((indexOf fmt "%") >= 0) {
            return (out + "%")
        }
        return (out + "f")
    }

    ; What the Format pane asked of the value axis: bounds, a log scale and a
    ; number format, as members to add to the value channel.
    fn valueExtras:string (ch:GridChart stacked:boolean) {
        def scale:string ""
        if ch.logScale {
            scale = "\"type\":\"log\""
        }
        def hasMin:boolean ((strlen ch.valueMin) > 0)
        def hasMax:boolean ((strlen ch.valueMax) > 0)
        if (hasMin || hasMax) {
            def lo:double (this.extent(false false))
            def hi:double (this.extent(stacked true))
            if hasMin {
                lo = (?? (to_double ch.valueMin) lo)
            }
            if hasMax {
                hi = (?? (to_double ch.valueMax) hi)
            }
            if (hi > lo) {
                if ((strlen scale) > 0) {
                    scale = (scale + ",")
                }
                scale = (scale + "\"domain\":[" + (ChartData.num(lo)) + "," + (ChartData.num(hi)) + "]")
                if (hasMin && hasMax) {
                    scale = (scale + ",\"nice\":false")
                }
            }
        }
        def out:string ""
        if ((strlen scale) > 0) {
            out = (",\"scale\":{" + scale + "}")
        }
        def f:string (ChartData.d3Format(ch.numFormat))
        if ((strlen f) > 0) {
            out = (out + ",\"axis\":{\"format\":\"" + (ChartData.jsonEscape(f)) + "\"}")
        }
        return out
    }

    ; The name of the nth value column, for the axis titles of an XY chart.
    fn seriesName:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (array_length series)) {
            return ""
        }
        return (itemAt series i)
    }
}
