        this.num("=SYD(30000,7500,10,1)" 4090.90909090909)
        this.num("=EFFECT(0.0525,4)" 0.0535426673707584)
        this.num("=NOMINAL(0.053543,4)" 0.0525003697081)
        this.num("=CUMIPMT(0.09/12,360,125000,13,24,0)" -11135.2321307508)
        this.num("=PDURATION(0.025,2000,2200)" 3.85986616262266)
        this.num("=RRI(96,10000,11000)" 0.000993236547441)
