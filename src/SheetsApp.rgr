    fn tool:RibbonItem (r:RibbonCtl value:string name:string icon:string command:string arg:string toggle:boolean) {
        this.act(value command arg "")
        if toggle {
            return (r.addToggle(value name icon))
        }
        return (r.add(value name icon))
    }

    ; A group on one of the ribbon's tabs.
    fn grp:RibbonCtl (tab:string tid:string name:string) {
        def g:RibbonCtl (new RibbonCtl)
        g.tid = tid
        g.name = name
        push tabGroups g
        push tabOf tab
        return g
    }

    ; A toolbar of the full Home tab.
    fn bar:RibbonCtl (tid:string name:string) {
        def g:RibbonCtl (new RibbonCtl)
        g.tid = tid
        g.name = name
        return g
    }

    ; A drop-down of the full Home tab, named by what its trigger says.
    fn drop:MenuCtl (tid:string name:string) {
        def m:MenuCtl (new MenuCtl)
        m.tid = tid
        m.name = name
        return m
    }

    ; The same command under another value, for a folded group's menu.
    fn alias:void (value:string from:string) {
        if (has actions from) {
            def a:SxAction (unwrap (get actions from))
            this.act(value a.command a.arg a.shortcut)
        }
    }

    ; A toolbar's buttons as rows of a folded group's menu.
    fn copyBar:void (mc:MenuCtl r:RibbonCtl prefix:string) {
        def i:int 0
        while (i < (array_length r.items)) {
            def it:RibbonItem (itemAt r.items i)
            if (it.separator == false) {
                this.alias((prefix + it.value) it.value)
                mc.addItem((prefix + it.value) it.name false)
            }
            i = (i + 1)
        }
    }

    ; Another drop-down's rows, inline.
    fn copyMenu:void (mc:MenuCtl src:MenuCtl prefix:string) {
        def i:int 0
        while (i < (array_length src.items)) {
            def it:UiItem (itemAt src.items i)
            if (it.kind == "separator") {
                mc.addSeparator()
            } {
                this.alias((prefix + it.value) it.value)
                mc.addItem((prefix + it.value) it.name false)
            }
            i = (i + 1)
        }
    }

    ; Another drop-down as a submenu.
    fn subOf:void (mc:MenuCtl value:string label:string src:MenuCtl) {
        def sub:UiItem (mc.addSub(value label false))
        def i:int 0
        while (i < (array_length src.items)) {
            def it:UiItem (itemAt src.items i)
            if (it.kind == "separator") {
                MenuCtl.addKidSeparator(sub)
            } {
                this.alias((value + "-" + it.value) it.value)
                def k:UiItem (MenuCtl.addKid(sub (value + "-" + it.value) it.name false))
            }
            i = (i + 1)
        }
    }

    ; A button labelled with a word instead of a glyph.
    fn word:RibbonItem (r:RibbonCtl value:string name:string label:string command:string arg:string) {
        def it:RibbonItem (this.tool(r value name "" command arg false))
        it.text = label
        return it
    }

    fn groupsOf:[RibbonCtl] (tab:string) {
        def out:[RibbonCtl]
        def i:int 0
        while (i < (array_length tabGroups)) {
            if ((itemAt tabOf i) == tab) {
                push out (itemAt tabGroups i)
            }
            i = (i + 1)
        }
        return out
    }

    ; --- The tabs past Home --------------------------------------------------
    ;
    ; Laid out as Home is: labelled groups, each a few columns of two rows of
    ; labelled buttons and drop-downs, so no tab is a wall of words. A group
    ; that does not fit the window folds into a drop-down named after it.

    ; Starts a labelled group on `tab`.
    fn tset:void (tab:string tid:string name:string) {
        def g (new SxGroup())
        g.tab = tab
        g.tid = tid
        g.name = name
        push tabSets g
        curSet = g
    }

    ; The group being filled is one the tab is mostly for.
    fn tkeep:void () {
        curSet.keep = true
    }

    ; The next slots of the group go in a new column.
    fn tcol:void () {
        curSet.cols = (curSet.cols + 1)
    }

    ; A labelled button on a row of its own in the group's current column.
    fn tb:RibbonItem (value:string name:string label:string icon:string command:string arg:string) {
        def g:SxGroup curSet
        def r:RibbonCtl (this.grp(g.tab (g.tid + "-" + (to_string (array_length g.slots))) g.name))
        def sl (new SxSlot())
        sl.col = (g.cols - 1)
        sl.bar = r
        push g.slots sl
        def it:RibbonItem (this.tool(r value name (SheetsApp.icon(icon)) command arg false))
        it.text = label
        return it
    }

    ; The same, a button that stays down while what it shows is on.
    fn tt:RibbonItem (value:string name:string label:string icon:string command:string arg:string) {
        def it:RibbonItem (this.tb(value name label icon command arg))
        it.toggle = true
        return it
    }

    ; A drop-down on a row of its own in the group's current column.
    fn tmenu:MenuCtl (tid:string name:string) {
        def g:SxGroup curSet
        def m:MenuCtl (this.drop(tid name))
        def sl (new SxSlot())
        sl.col = (g.cols - 1)
        sl.isMenu = true
        sl.menu = m
        push g.slots sl
        push tabMenus m
        return m
    }

    fn titem:void (m:MenuCtl value:string label:string command:string arg:string) {
        this.item(m value label command arg "")
    }

