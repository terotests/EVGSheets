    def zoomSlider:SliderCtl (new SliderCtl)
    def sliderDrag:boolean false
    ; A hover the pointer passed over on its way to an open submenu.
    def holdHover:string ""
    ; The first tab the strip shows (see tabWindow).
    def tabFirst:int 0
    def holdMs:double 0.0
    def holdDelayMs:double 400.0
    ; The contextual tab showing: "tabledesign", "chartdesign" or "".
    def ctxTab:string ""
    ; The colour each sheet's tab was drawn with, by sheet index.
    def tabColours:[string:string]
    def ctxMenu:MenuCtl (new MenuCtl)
    def history:RibbonCtl (new RibbonCtl)
    def textTools:RibbonCtl (new RibbonCtl)
    def alignTools:RibbonCtl (new RibbonCtl)
    def numberTools:RibbonCtl (new RibbonCtl)
    def dataTools:RibbonCtl (new RibbonCtl)
    def insertTools:RibbonCtl (new RibbonCtl)
    def tabs:TabsCtl (new TabsCtl)
    def sheetTools:RibbonCtl (new RibbonCtl)
    ; Excel's ribbon: a row of tabs, each with its own groups. Home keeps the
    ; groups above; the rest are listed in `tabGroups`, `tabOf` naming the tab.
    def ribTabs:TabsCtl (new TabsCtl)
    def ribbonTab:string "home"
    def tabGroups:[RibbonCtl]
    def tabOf:[string]
    ; The labelled groups of the tabs past Home, their drop-downs, and the
    ; group being filled while the ribbon is built.
    def tabSets:[SxGroup]
    def tabMenus:[MenuCtl]
    def curSet:SxGroup (new SxGroup)
    ; The theme switch in the title bar.
    def themeBar:RibbonCtl (new RibbonCtl)
    def ribTabRow:EVGElement (EVGElement.createDiv())
    ; Footer: scroll through the sheets, and the status bar's view and zoom.
    def tabNav:RibbonCtl (new RibbonCtl)
    def viewTools:RibbonCtl (new RibbonCtl)
    ; The full Home tab, laid out as Excel's groups: these toolbars and the
    ; drop-downs below, in labelled boxes. A host's `tools=` list keeps the
    ; flat bar of `history`, `textTools`… above instead.
    def xUndo:RibbonCtl (new RibbonCtl)
    def xClip:RibbonCtl (new RibbonCtl)
    def xFontA:RibbonCtl (new RibbonCtl)
    def xFontB:RibbonCtl (new RibbonCtl)
    def xFontC:RibbonCtl (new RibbonCtl)
    def xAlignV:RibbonCtl (new RibbonCtl)
    def xAlignH:RibbonCtl (new RibbonCtl)
    def xNum:RibbonCtl (new RibbonCtl)
    def xSum:RibbonCtl (new RibbonCtl)
    def xAddins:RibbonCtl (new RibbonCtl)
    def pasteMenu:MenuCtl (new MenuCtl)
    def mergeMenu:MenuCtl (new MenuCtl)
    def insMenu:MenuCtl (new MenuCtl)
    def delMenu:MenuCtl (new MenuCtl)
    def fmtMenu:MenuCtl (new MenuCtl)
    def fillMenu:MenuCtl (new MenuCtl)
    def clearMenu:MenuCtl (new MenuCtl)
    def sortMenu:MenuCtl (new MenuCtl)
    def findMenu:MenuCtl (new MenuCtl)
    ; A narrow window folds whole groups into one drop-down each, the way
