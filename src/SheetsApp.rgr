    ; The groups of the tab that is showing, in the order they are mounted.
    fn ribbonGroups:[RibbonCtl] () {
        if (ribbonTab != "home") {
            return (this.groupsOf(ribbonTab))
        }
        def h:[RibbonCtl] (this.groupsOf("home"))
        def a:[RibbonCtl]
        push a history
        push a (itemAt h 0)
        push a textTools
        push a (itemAt h 1)
        push a alignTools
        push a (itemAt h 2)
        push a numberTools
        push a (itemAt h 3)
        push a (itemAt h 4)
        push a (itemAt h 5)
        push a dataTools
        push a (itemAt h 6)
        push a insertTools
        push a (itemAt h 7)
        return a
    }

    ; Lucide's icons (ISC licence), 24×24, stroked.
    sfn icon:string (name:string) {
        if (name == "save") { return "M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7 M7 3v4a1 1 0 0 0 1 1h7" }
        if (name == "undo") { return "M9 14 4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" }
        if (name == "redo") { return "m15 14 5-5-5-5 M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13" }
        if (name == "painter") { return "M18 4H6a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z M20 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-8.5 M12 12v3 M11 15h2v6h-2z" }
        if (name == "bold") { return "M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8" }
        if (name == "italic") { return "M19 4h-9 M14 20H5 M15 4 9 20" }
        if (name == "underline") { return "M6 4v6a6 6 0 0 0 12 0V4 M4 20h16" }
        if (name == "strike") { return "M16 4H9a3 3 0 0 0-2.83 4 M14 12a4 4 0 0 1 0 8H6 M4 12h16" }
        if (name == "color") { return "M5 16 12 3l7 13 M8 11h8" }
        if (name == "fill") { return "m19 11-8-8-8.6 8.6a2 2 0 0 0 0 2.8l5.2 5.2c.8.8 2 .8 2.8 0L19 11Z M5 2l5 5 M2 13h15" }
        if (name == "left") { return "M21 6H3 M15 12H3 M17 18H3" }
        if (name == "center") { return "M21 6H3 M17 12H7 M19 18H5" }
        if (name == "right") { return "M21 6H3 M21 12H9 M21 18H7" }
        if (name == "wrap") { return "M3 6h18 M3 12h15a3 3 0 1 1 0 6h-4 M16 16l-2 2 2 2 M3 18h7" }
        if (name == "merge") { return "M3 5h18v14H3z M8 12h8 M6 10l-2 2 2 2 M18 10l2 2-2 2" }
        if (name == "currency") { return "M12 2v20 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" }
        if (name == "percent") { return "M19 5 5 19 M6.5 4a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z M17.5 15a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z" }
        if (name == "sortasc") { return "m3 8 4-4 4 4 M7 4v16 M11 12h4 M11 16h7 M11 20h10" }
        if (name == "sortdesc") { return "m3 16 4 4 4-4 M7 20V4 M11 4h10 M11 8h7 M11 12h4" }
        if (name == "filterclear") { return "M13 3H2l8 9.46V19l4 2v-8.54l.9-1.06 M17 3l5 5 M22 3l-5 5" }
        if (name == "freeze") { return "M3 3h18v18H3z M3 9h18 M9 3v18" }
        if (name == "chart") { return "M3 3v16a2 2 0 0 0 2 2h16 M18 17V9 M13 17V5 M8 17v-3" }
        if (name == "link") { return "M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" }
        if (name == "find") { return "M11 3a8 8 0 1 0 0 16a8 8 0 1 0 0-16z M21 21l-4.3-4.3" }
        if (name == "plus") { return "M12 5v14 M5 12h14" }
        if (name == "chevron") { return "m6 9 6 6 6-6" }
        if (name == "chevronRight") { return "m9 18 6-6-6-6" }
        if (name == "chevronLeft") { return "m15 18-6-6 6-6" }
        if (name == "check") { return "M20 6 9 17l-5-5" }
        if (name == "dot") { return "M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8z" }
        if (name == "logo") { return "M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M3 9h18 M3 15h18 M9 9v12 M15 9v12" }
        return ""
    }

    ; =========================================================================
    ; The page
    ; =========================================================================

    fn mount:void (parent:EVGElement c:UiCtl) {
        push ui.ctls c
        def el:EVGElement (unwrap c.rootEl)
        parent.addChild(el)
    }

    fn buildChrome:void () {
        def root:EVGElement (unwrap ui.root)
        root.id = "root"
        root.className = "sx-root"
        UiTree.clearChildren(root)
        def noCtls:[UiCtl]
        ui.ctls = noCtls

        ; The pieces the parameters keep.
        def keep:[string] tools
        def groups:[RibbonCtl] (this.ribbonGroups())
        def gi:int 0
        while (gi < (array_length groups)) {
            def g:RibbonCtl (itemAt groups gi)
            if ((array_length keep) > 0) {
                g.keepOnly(keep)
            }
            gi = (gi + 1)
        }

        ; --- header --------------------------------------------------------
        if (showMenubar || showTitle) {
            headerEl.id = "sx-header"
            headerEl.className = "sx-header"
            UiTree.clearChildren(headerEl)
            if showTitle {
                def brand:EVGElement (EVGElement.createDiv())
                brand.className = "sx-brand"
                brand.addChild((RibbonCtl.glyph((SheetsApp.icon("logo")) "sx-logo")))
                titleEl.className = "sx-title"
                titleEl.elementType = 1
                titleEl.textContent = title
                brand.addChild(titleEl)
                headerEl.addChild(brand)
                if (readOnly == false) {
                    this.mount(headerEl qat)
                }
            }
            if showMenubar {
                this.mount(headerEl menubar)
            }
            def spacer:EVGElement (EVGElement.createDiv())
            spacer.className = "sx-spacer"
            headerEl.addChild(spacer)
            badgeEl.className = "sx-badge"
            badgeEl.elementType = 1
            badgeEl.textContent = "Read-only"
            if readOnly {
                headerEl.addChild(badgeEl)
            }
            docEl.className = "sx-doc"
            docEl.elementType = 1
            headerEl.addChild(docEl)
            root.addChild(headerEl)
        }

        ; --- ribbon ----------------------------------------------------------
        if (showRibbon && (readOnly == false)) {
            ; The tab row only on the full ribbon: a tool list chosen by the
            ; host is one toolbar, not Excel's.
            if ((array_length tools) == 0) {
                ribTabRow.id = "sx-ribtabrow"
                ribTabRow.className = "sx-ribtabrow"
                UiTree.clearChildren(ribTabRow)
                ribTabs.value = ribbonTab
                this.mount(ribTabRow ribTabs)
                root.addChild(ribTabRow)
            }
            ribbonEl.id = "sx-ribbonbar"
            ribbonEl.className = "sx-ribbonbar"
            UiTree.clearChildren(ribbonEl)
            if (ribbonTab == "home") {
                def h:[RibbonCtl] (this.groupsOf("home"))
                this.mountGroup(history)
                this.mountGroup((itemAt h 0))
                if (this.wantsTool("font")) {
                    this.mount(ribbonEl fontMenu)
                }
                if (this.wantsTool("size")) {
                    this.mount(ribbonEl sizeMenu)
                }
                this.mountGroup(textTools)
                this.mountGroup((itemAt h 1))
                this.mountGroup(alignTools)
                this.mountGroup((itemAt h 2))
                if (this.wantsTool("numfmt")) {
                    this.mount(ribbonEl numMenu)
                }
                this.mountGroup(numberTools)
                this.mountGroup((itemAt h 3))
                if (this.wantsTool("borders")) {
                    this.mount(ribbonEl borderMenu)
                }
                this.mountGroup((itemAt h 4))
                if (this.wantsTool("galleries")) {
                    this.mount(ribbonEl cfMenu)
                    this.mount(ribbonEl tableMenu)
                    this.mount(ribbonEl styleMenu)
                }
                this.mountGroup((itemAt h 5))
                this.mountGroup(dataTools)
                this.mountGroup((itemAt h 6))
                this.mountGroup(insertTools)
                this.mountGroup((itemAt h 7))
            } {
                def tg:[RibbonCtl] (this.groupsOf(ribbonTab))
                def ti:int 0
                while (ti < (array_length tg)) {
                    this.mountGroup((itemAt tg ti))
                    ti = (ti + 1)
                }
            }
            root.addChild(ribbonEl)
        }

        ; --- the grid --------------------------------------------------------
        gridEl.id = "sx-grid"
        gridEl.className = "sx-grid"
        root.addChild(gridEl)

        ; --- footer: sheet tabs and the status line ------------------------
        if (showTabs || showStatus) {
            footerEl.id = "sx-footer"
            footerEl.className = "sx-footer"
            UiTree.clearChildren(footerEl)
            if showTabs {
                this.mount(footerEl tabNav)
                this.mount(footerEl tabs)
                if (readOnly == false) {
                    this.mount(footerEl sheetTools)
                }
            }
            def spacer2:EVGElement (EVGElement.createDiv())
            spacer2.className = "sx-spacer"
            footerEl.addChild(spacer2)
            if showStatus {
                statusEl.className = "sx-status"
                statusEl.elementType = 1
                footerEl.addChild(statusEl)
                statsEl.className = "sx-stats"
                statsEl.elementType = 1
                footerEl.addChild(statsEl)
                this.mount(footerEl viewTools)
                this.mount(footerEl zoomSlider)
            }
            root.addChild(footerEl)
        }

        ; --- the task pane (absolutely placed at the grid's right) --------
        paneBuilt = grid.app.paneKind
        if ((strlen paneBuilt) > 0) {
            paneHolder.id = "sx-pane"
            paneHolder.className = "sx-pane"
            UiTree.clearChildren(paneHolder)
            def phead:EVGElement (EVGElement.createDiv())
            phead.className = "sx-pane-head"
            paneTitleEl.className = "sx-pane-title"
            paneTitleEl.elementType = 1
            phead.addChild(paneTitleEl)
            paneHead.tid = "sx-pane-head"
            paneHead.name = "Task pane"
            if ((array_length paneHead.items) == 0) {
                this.word(paneHead "pane-close" "Close pane" "✕" "" "")
            }
            this.mount(phead paneHead)
            paneHolder.addChild(phead)
            if (grid.app.paneSearches()) {
                paneSearch.tid = "sx-pane-search"
                paneSearch.name = "Search for a function"
                paneSearch.placeholder = "Search for a function"
                paneSearch.boxWidth = ((to_double paneW) - 24.0)
                paneSearch.fontFamily = "Open Sans"
                paneSearch.fontSize = 13.0
                paneSearch.value = grid.app.paneFilter
                this.mount(paneHolder paneSearch)
            }
            paneList.tid = "sx-pane-list"
            paneList.rootClass = "sx-pane-list"
            paneList.toolClass = "sx-pane-row"
            this.mount(paneHolder paneList)
            root.addChild(paneHolder)
        }

        ; --- the context menu holder (absolutely placed at the pointer) ----
        ctxHolder.id = "sx-ctx-holder"
        ctxHolder.className = "sx-ctx-holder"
        UiTree.clearChildren(ctxHolder)
        this.mount(ctxHolder ctxMenu)
        root.addChild(ctxHolder)

        ; --- the dialogs: modal overlays, so they take no room in the page --
        dlgHolder.id = "sx-dlg-holder"
        dlgHolder.className = "sx-dlg-holder"
        UiTree.clearChildren(dlgHolder)
        def dl:[SxDialog] (this.dialogs())
        def di:int 0
        while (di < (array_length dl)) {
            def d:SxDialog (itemAt dl di)
            this.mount(dlgHolder d.win)
            def fc:[UiCtl] (d.ctls())
            def fi:int 1
            while (fi < (array_length fc)) {
                push ui.ctls (itemAt fc fi)
                fi = (fi + 1)
            }
            d.buildAll()
            di = (di + 1)
        }
        root.addChild(dlgHolder)

        grid.app.setChrome(false showFormulaBar false false)
        grid.setReadOnly(readOnly)
        this.sync()
    }

    fn wantsTool:boolean (value:string) {
        if ((array_length tools) == 0) {
            return true
        }
        return (RibbonCtl.listHas(tools value))
    }

    fn mountGroup:void (g:RibbonCtl) {
        if ((g.buttonCount()) == 0) {
            return
        }
        this.mount(ribbonEl g)
    }

    ; A parameter changed: models are rebuilt from scratch, because a tool
    ; list that dropped a button cannot be undone by keeping the old group.
    fn rebuildChrome:void () {
        if (built == false) {
            return
        }
        def noActions:[string:SxAction]
        actions = noActions
        this.buildModels()
        this.buildChrome()
    }

    ; =========================================================================
    ; State: the core decides, the chrome shows
    ; =========================================================================

    fn sync:void () {
        this.adoptCoreDialogs()
        if (grid.app.paneKind != paneBuilt) {
            def opened:boolean ((strlen grid.app.paneKind) > 0)
            def hadPane:boolean ((strlen paneBuilt) > 0)
            this.buildChrome()
            ; The rows of the pane just mounted, in this frame.
            this.syncPane()
            ; A pane with a search field takes the keys when it opens, as
            ; Insert Function's does; a pane closing gives them back.
            if (opened && (grid.app.paneSearches())) {
                gridFocused = false
                ui.focus(paneSearch.tid)
                this.sync()
            }
            if ((opened == false) && hadPane) {
                gridFocused = true
                ui.blur()
            }
            return
        }
        this.syncPane()
        def app:GridApp grid.app
        def model:SpreadsheetModel app.model
        def sel:GridSelection app.sel
        def st:CellStyle (model.getCellStyle(sel.active.row sel.active.col))

        textTools.setOn("bold" st.bold)
        textTools.setOn("italic" st.italic)
        textTools.setOn("underline" st.underline)
        textTools.setOn("strike" st.strike)
        if ((strlen st.textRgb) >= 4) {
            textTools.setSwatch("color" st.textRgb)
        }
        alignTools.setOn("left" (st.alignSet && (st.align == "left")))
        alignTools.setOn("center" (st.align == "center"))
        alignTools.setOn("right" (st.align == "right"))
        alignTools.setOn("wrap" st.wrapText)
        alignTools.setOn("merge" ((strlen (model.mergeAt(sel.active.row sel.active.col))) > 0))
        numberTools.setOn("currency" (GridFormat.isOn(st "numfmt" "currency")))
        numberTools.setOn("percent" (GridFormat.isOn(st "numfmt" "percent")))
        dataTools.setOn("freeze" ((model.freezeRows > 0) || (model.freezeCols > 0)))
        history.setDisabled("undo" ((model.history.canUndo()) == false))
        history.setDisabled("redo" ((model.history.canRedo()) == false))
        history.setOn("painter" app.formatBrushArmed)

        ; The font and size dropdowns name what the caret is on.
        def fname:string st.fontName
        if ((strlen fname) == 0) {
            fname = "Open Sans"
        }
        fontMenu.name = fname
        this.checkRadio(fontMenu fname)
        def pt:string (SheetsApp.ptText(st.fontSizePt))
        sizeMenu.name = pt
        this.checkRadio(sizeMenu pt)

        ; The View menu's checkboxes say what is shown.
        def vm:UiMenu (menubar.menuAt("view"))
        this.setChecked(vm.menu "showformula" showFormulaBar)
        this.setChecked(vm.menu "showtabs" showTabs)
        this.setChecked(vm.menu "showstatus" showStatus)
        this.setChecked(vm.menu "showribbon" showRibbon)
        this.setChecked(vm.menu "themelight" (theme == "light"))
        this.setChecked(vm.menu "themedark" (theme == "dark"))
        this.setChecked(vm.menu "rtl" app.uiRtl)

        this.syncTabs()

        ; The header and the status line.
        def src:string app.book.sourcePath
        if ((strlen src) == 0) {
            src = "Untitled.xlsx"
        }
        docEl.textContent = (SheetsApp.baseName(src))
        statusEl.textContent = (this.statusText())
        statsEl.textContent = (this.statsText())

        def groups:[RibbonCtl] (this.ribbonGroups())
        def i:int 0
        while (i < (array_length groups)) {
            def g:RibbonCtl (itemAt groups i)
            g.build()
            i = (i + 1)
        }
        sheetTools.build()
        menubar.build()
        fontMenu.build()
        sizeMenu.build()
        numMenu.build()
        borderMenu.build()
        cfMenu.build()
        tableMenu.build()
        styleMenu.build()
        ctxMenu.build()
        qat.setDisabled("qat-undo" ((model.history.canUndo()) == false))
        qat.setDisabled("qat-redo" ((model.history.canRedo()) == false))
        qat.build()
        tabs.build()
        this.colourTabs()
        ; The grid is what a tab shows, and it is drawn beside the tabs, not in
        ; them: the controller's panel leaves the tree.
        def troot:EVGElement (unwrap tabs.rootEl)
        def onlyList:[EVGElement]
        push onlyList (unwrap tabs.listEl)
        troot.children = onlyList
        tabNav.build()
        viewTools.setText("sv-zoom" ((to_string (to_int ((grid.app.model.zoom * 100.0) + 0.5))) + "%"))
        viewTools.build()
        def zpct:int (to_int ((grid.app.model.zoom * 100.0) + 0.5))
        if (sliderDrag == false) {
            zoomSlider.setValue(zpct)
        }
        zoomSlider.build()
        this.syncContextTab()
        ribTabs.value = ribbonTab
        ribTabs.build()
        def rroot:EVGElement (unwrap ribTabs.rootEl)
        def onlyRibList:[EVGElement]
        push onlyRibList (unwrap ribTabs.listEl)
        rroot.children = onlyRibList
        def sd:[SxDialog] (this.dialogs())
        def si:int 0
        while (si < (array_length sd)) {
            def d:SxDialog (itemAt sd si)
            d.follow(grid.app)
            d.showFocus(ui.focusId)
            si = (si + 1)
        }
    }

    sfn baseName:string (p:string) {
        def i:int ((strlen p) - 1)
        while (i >= 0) {
            def ch:int (charAt p i)
            if ((ch == 47) || (ch == 92)) {
                return (substring p (i + 1) (strlen p))
            }
            i = (i - 1)
        }
        return p
    }

    sfn ptText:string (pt:double) {
        def whole:int (to_int (pt + 0.0001))
        if (((to_double whole) - pt) == 0.0) {
            return (to_string whole)
        }
        def tenths:int (to_int ((pt * 10.0) + 0.5))
        return ((to_string (idiv tenths 10)) + "." + (to_string (tenths - ((idiv tenths 10) * 10))))
    }

    fn checkRadio:void (mc:MenuCtl name:string) {
        def i:int 0
        while (i < (array_length mc.items)) {
            def it:UiItem (itemAt mc.items i)
            if (it.kind == "radio") {
                it.checked = (it.name == name)
            }
            i = (i + 1)
        }
    }

    fn setChecked:void (mc:MenuCtl value:string on:boolean) {
        def i:int 0
        while (i < (array_length mc.items)) {
            def it:UiItem (itemAt mc.items i)
            if (it.value == value) {
                it.checked = on
            }
            i = (i + 1)
        }
    }

    ; The tabs are the workbook's sheets, by index. Rebuilt only when the
    ; names changed, so a reader's place in the list survives an edit.
    ; The tabs that fit: a window of the strip around the active sheet, so a
    ; workbook of many sheets scrolls its tabs instead of pushing the status
    ; line and the zoom off the page. The arrows move the active sheet, and
    ; the window follows it.
    fn tabWindow:[int] (all:[int]) {
        def book:WorkbookModel grid.app.book
        def n:int (array_length all)
        if (n == 0) {
            return all
        }
        ; The room is what the last layout left the tabs: the footer less
        ; everything else in it but the stats, which give way first.
        if (footerEl.calculatedWidth <= 0.0) {
            return all
        }
        def others:double 0.0
        def fi:int 0
        while (fi < (array_length footerEl.children)) {
            def kid:EVGElement (itemAt footerEl.children fi)
            if ((kid.id != "sx-tabs") && (kid.className != "sx-stats") && (kid.className != "sx-spacer")) {
                others = (others + kid.calculatedWidth + 6.0)
            }
            fi = (fi + 1)
        }
        def budget:int (to_int ((footerEl.calculatedWidth - others) - 40.0))
        if (budget < 120) {
            budget = 120
        }
        def widths:[int]
        def pos:int 0
        def i:int 0
        while (i < n) {
            def at:int (itemAt all i)
            def sh:SpreadsheetModel (book.sheetAt(at))
            push widths (((strlen sh.name) * 7) + 30)
            if (at == book.activeIndex) {
                pos = i
            }
            i = (i + 1)
        }
        if (tabFirst > pos) {
            tabFirst = pos
        }
        if (tabFirst >= n) {
            tabFirst = 0
        }
        def used:int 0
        def k:int tabFirst
        while (k <= pos) {
            used = (used + (itemAt widths k))
            k = (k + 1)
        }
        while ((used > budget) && (tabFirst < pos)) {
            used = (used - (itemAt widths tabFirst))
            tabFirst = (tabFirst + 1)
        }
        ; Fill the room left: after the active tab, then back before it.
        def last:int pos
        while (((last + 1) < n) && ((used + (itemAt widths (last + 1))) <= budget)) {
            last = (last + 1)
            used = (used + (itemAt widths last))
        }
        while ((tabFirst > 0) && ((used + (itemAt widths (tabFirst - 1))) <= budget)) {
            tabFirst = (tabFirst - 1)
            used = (used + (itemAt widths tabFirst))
        }
        def out:[int]
        def j:int tabFirst
        while (j <= last) {
            push out (itemAt all j)
            j = (j + 1)
        }
        return out
    }

    fn syncTabs:void () {
        def book:WorkbookModel grid.app.book
        def order:[int] (this.tabWindow((this.tabOrder())))
        def n:int (array_length order)
        def same:boolean ((array_length tabs.items) == n)
        if same {
            def i:int 0
            while (i < n) {
                def it:UiItem (itemAt tabs.items i)
                def at:int (itemAt order i)
                def sh:SpreadsheetModel (book.sheetAt(at))
                if ((it.name != sh.name) || (it.value != (to_string at))) {
                    same = false
                }
                i = (i + 1)
            }
        }
        if (same == false) {
            def empty:[UiItem]
            tabs.items = empty
            def j:int 0
            while (j < n) {
                def at2:int (itemAt order j)
                def sh2:SpreadsheetModel (book.sheetAt(at2))
                tabs.addItem((to_string at2) sh2.name "" false)
                j = (j + 1)
            }
        }
        tabs.value = (to_string book.activeIndex)
        if ((strlen tabs.rovingValue) == 0) {
            tabs.rovingValue = tabs.value
        }
        if (gridFocused || ((tabs.owns(ui.focusId)) == false)) {
            tabs.rovingValue = tabs.value
        }
    }

    ; A sheet's tab colour as CSS: "FF4472C4", "4472C4" and "#4472C4" are
    ; all "#4472C4"; no colour is "".
    sfn cssColour:string (c:string) {
        def t:string (trim c)
        if ((strlen t) == 0) {
            return ""
        }
        if ((charAt t 0) == 35) {
            t = (substring t 1 (strlen t))
        }
        if ((strlen t) == 8) {
            t = (substring t 2 8)
        }
        if ((strlen t) != 6) {
            return ""
        }
        return ("#" + t)
    }

    ; Each tab shows its sheet's colour as an edge, as Excel's do.
    fn colourTabs:void () {
        def none:[string:string]
        tabColours = none
        def book:WorkbookModel grid.app.book
        def i:int 0
        while (i < (array_length tabs.items)) {
            def it:UiItem (itemAt tabs.items i)
            def at:int (GridApp.intOf(it.value))
            if ((at >= 0) && (at < (book.sheetCount())) && (!null? it.el)) {
                def sh:SpreadsheetModel (book.sheetAt(at))
                def c:string (SheetsApp.cssColour(sh.tabColor))
                if ((strlen c) > 0) {
                    def el:EVGElement (unwrap it.el)
                    UiTree.inline(el "border" ("2px solid " + c))
                    set tabColours it.value c
                }
            }
            i = (i + 1)
        }
    }

    ; The colour the tab of sheet `at` is drawn with, "" for none.
    fn tabColourShown:string (at:int) {
        def k:string (to_string at)
        if (has tabColours k) {
            return (unwrap (get tabColours k))
        }
        return ""
    }

    ; Table Design while the active cell is in a table, Chart Design while a
    ; chart has the focus: the tab appears, and goes when the selection leaves.
    fn syncContextTab:void () {
        def app:GridApp grid.app
        def want:string ""
        if ((app.model.tableIndexAt(app.sel.active.row app.sel.active.col)) >= 0) {
            want = "tabledesign"
        }
        if ((app.activeChartId()) > 0) {
            want = "chartdesign"
        }
        if (want == ctxTab) {
            return
        }
        def was:string ctxTab
        ctxTab = want
        def kept:[UiItem]
        def i:int 0
        while (i < (array_length ribTabs.items)) {
            def it:UiItem (itemAt ribTabs.items i)
            if ((it.value != "tabledesign") && (it.value != "chartdesign")) {
                push kept it
            }
            i = (i + 1)
        }
        ribTabs.items = kept
        if (want == "tabledesign") {
            ribTabs.addItem("tabledesign" "Table Design" "" false)
        }
        if (want == "chartdesign") {
            ribTabs.addItem("chartdesign" "Chart Design" "" false)
        }
        if ((strlen was) > 0) {
            if (ribbonTab == was) {
                ribbonTab = "home"
                this.buildChrome()
            }
        }
    }

    ; The sheets in the order the strip draws them: the workbook's, except
    ; while a tab is carried, when the carried one sits where it would land.
    fn tabOrder:[int] () {
        def out:[int]
        def n:int (grid.app.book.sheetCount())
        def carrying:boolean ((tabDrag >= 0) && (tabDrag < n) && (tabDropAt >= 0) && (tabDropAt < n))
        def i:int 0
        while (i < n) {
            def shw:SpreadsheetModel (grid.app.book.sheetAt(i))
            if (((carrying == false) || (i != tabDrag)) && (shw.sheetHidden == false)) {
                push out i
            }
            i = (i + 1)
        }
        if carrying {
            def kept:[int]
            def k:int 0
            while (k < (array_length out)) {
                if (k == tabDropAt) {
                    push kept tabDrag
                }
                push kept (itemAt out k)
                k = (k + 1)
            }
            if (tabDropAt >= (array_length out)) {
                push kept tabDrag
            }
            return kept
        }
        return out
    }

    ; The sheet a tab target names, or -1.
    fn tabSheetOf:int (target:string) {
        def n:int (grid.app.book.sheetCount())
        def i:int 0
        while (i < n) {
            if ((tabs.tabTid((to_string i))) == target) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; [x, w] of the tab drawn at strip position `pos`, from the last layout.
    fn tabSpan:[int] (pos:int) {
        def out:[int]
        def order:[int] (this.tabOrder())
        if ((pos < 0) || (pos >= (array_length order))) {
            return out
        }
        def r:string (ui.rectOf((tabs.tabTid((to_string (itemAt order pos))))))
        if ((strlen r) == 0) {
            return out
        }
        def parts:[string] (strsplit r ",")
        push out (?? (to_int (itemAt parts 0)) 0)
        push out (?? (to_int (itemAt parts 2)) 0)
        return out
    }

    ; The carried tab follows the pointer one neighbour at a time. It swaps
    ; with a neighbour once the pointer is far enough past it that, after the
    ; swap, the pointer is over the carried tab again — so tabs of different
    ; widths do not swap back and forth under a pointer that has stopped.
    fn dragTabTo:void (x:int) {
        def n:int (grid.app.book.sheetCount())
        if ((tabDrag < 0) || (n < 2)) {
            return
        }
        if (tabDragMoved == false) {
            def dx:int (x - tabDragX)
            if (dx < 0) {
                dx = (0 - dx)
            }
            if (dx < 6) {
                return
            }
            tabDragMoved = true
            tabDropAt = tabDrag
        }
        def guard:int 0
        while (guard < n) {
            guard = (guard + 1)
            def me:[int] (this.tabSpan(tabDropAt))
            if ((array_length me) < 2) {
                return
            }
            def mw:int (itemAt me 1)
            def moved:boolean false
            if ((tabDropAt + 1) < n) {
                def right:[int] (this.tabSpan((tabDropAt + 1)))
                if ((array_length right) == 2) {
                    def rEnd:int ((itemAt right 0) + (itemAt right 1))
                    if (x >= (rEnd - mw)) {
                        tabDropAt = (tabDropAt + 1)
                        moved = true
                    }
                }
            }
            if ((moved == false) && (tabDropAt > 0)) {
                def left:[int] (this.tabSpan((tabDropAt - 1)))
                if ((array_length left) == 2) {
                    if (x < ((itemAt left 0) + mw)) {
                        tabDropAt = (tabDropAt - 1)
                        moved = true
                    }
                }
            }
            if moved {
                ; The next neighbour is measured on the strip as now drawn.
                this.sync()
                def page:EVGElement (this.layout())
            } {
                return
            }
        }
    }

    ; Let go: the sheet moves to where its tab was drawn.
    fn dropTab:void () {
        def from:int tabDrag
        def to:int tabDropAt
        def moved:boolean tabDragMoved
        tabDrag = -1
        tabDropAt = -1
        tabDragMoved = false
        if (moved && (from >= 0) && (to >= 0) && (from != to)) {
            def ok:boolean (grid.app.moveSheetTo(from to))
        }
        this.sync()
    }

    fn statusText:string () {
        def app:GridApp grid.app
        if app.editing {
            if ((strlen app.editBuf) > 0) {
                if ((charAt app.editBuf 0) == 61) {
                    return "Enter    Editing a formula — click cells to insert references"
                }
            }
            return "Edit    Enter to keep, Esc to cancel"
        }
        def s:string app.view.status
        if ((strlen s) > 1) {
            ; The core's version stamp ("v12") is a debugging aid, not news.
            if (((charAt s 0) == 118) && ((strlen s) < 8)) {
                return "Ready"
            }
            return ("Ready    " + s)
        }
        return "Ready"
    }

    fn statsText:string () {
        def app:GridApp grid.app
        if (app.sel.isSingle()) {
            return ""
        }
        ; Read the figures straight from the model rather than parsing the JSON
        ; back: same walk, same cap.
        def st:SxStats (SxStats.of(app))
        if (st.count == 0) {
            return ""
        }
        if (st.nums == 0) {
            return ("Count " + (to_string st.count))
        }
        def avg:double (st.sum / (to_double st.nums))
        return ((("Sum " + (SheetsApp.num(st.sum))) + "   Average " + (SheetsApp.num(avg))) + "   Count " + (to_string st.count))
    }

    ; A figure for the status line: thousands grouped, at most two decimals.
    sfn num:string (v:double) {
        def neg:boolean (v < 0.0)
        def a:double v
        if neg {
            a = (0.0 - v)
        }
        ; Past a trillion the figure is a magnitude, not an amount: shown as
        ; 2.22226E+15, the way a spreadsheet's General format shows it. (The
        ; integer arithmetic below would also overflow there.)
        if (a >= 1000000000000.0) {
            def e:int 0
            def m:double a
            while (m >= 10.0) {
                m = (m / 10.0)
                e = (e + 1)
            }
            def scaled:int (to_int ((m * 100000.0) + 0.5))
            if (scaled >= 1000000) {
                scaled = 100000
                e = (e + 1)
            }
            def ms:string (to_string scaled)
            def digits:string ((substring ms 0 1) + "." + (substring ms 1 (strlen ms)))
            while ((strlen digits) > 1) {
                def last:int (charAt digits ((strlen digits) - 1))
                if ((last == 48) || (last == 46)) {
                    def wasDot:boolean (last == 46)
                    digits = (substring digits 0 ((strlen digits) - 1))
                    if wasDot {
                        break
                    }
                } {
                    break
                }
            }
            def sci:string (digits + "E+" + (to_string e))
            if neg {
                return ("-" + sci)
            }
            return sci
        }
        def cents:int (to_int ((a * 100.0) + 0.5))
        def whole:int (idiv cents 100)
        def frac:int (cents - (whole * 100))
        def ws:string (to_string whole)
        def grouped:string ""
        def n:int (strlen ws)
        def i:int 0
        while (i < n) {
            if ((i > 0) && ((idiv (n - i) 3) * 3) == (n - i)) {
                grouped = (grouped + ",")
            }
            grouped = (grouped + (substring ws i (i + 1)))
            i = (i + 1)
        }
        def out:string grouped
        if (frac > 0) {
            def fs:string (to_string frac)
            if (frac < 10) {
                fs = ("0" + fs)
            }
            if ((charAt fs 1) == 48) {
                fs = (substring fs 0 1)
            }
            out = (out + "." + fs)
        }
        if neg {
            out = ("-" + out)
        }
        return out
    }

    ; =========================================================================
    ; Drawing
    ; =========================================================================

    ; The labels of a dropdown trigger and of menu rows are one text leaf as
    ; EVGUI builds them; a trigger also wants a chevron, a row its shortcut and
    ; a tick. Added here, after the controllers built and before the layout,
    ; and only on rows that are still bare — so it is safe every frame.
    fn decorate:void (el:EVGElement) {
        def cls:string el.className
        def isTrigger:boolean ((indexOf cls "ui-dropdownmenu-trigger") == 0)
        def isItem:boolean (((indexOf cls "ui-dropdownmenu-item") == 0) || ((indexOf cls "ui-contextmenu-item") == 0) || ((indexOf cls "ui-menubar-item") == 0))
        if ((isTrigger || isItem) && (el.elementType == 1) && ((strlen el.textContent) > 0)) {
            def words:string el.textContent
            el.textContent = ""
            el.elementType = 0
            def kids:[EVGElement] el.children
            def empty:[EVGElement]
            el.children = empty
            if isItem {
                def mark:EVGElement (EVGElement.createDiv())
                mark.className = "sx-mark"
                mark.a11yHidden = true
                if ((indexOf cls "state-checked") >= 0) {
                    def radio:boolean (this.isRadioRow(el.id))
                    if radio {
                        mark.addChild((RibbonCtl.glyph((SheetsApp.icon("dot")) "sx-mark-dot")))
                    } {
                        mark.addChild((RibbonCtl.glyph((SheetsApp.icon("check")) "sx-mark-check")))
                    }
                }
                el.addChild(mark)
            }
            def label:EVGElement (EVGElement.createSpan())
            label.className = "sx-menu-label"
            label.textContent = words
            label.elementType = 1
            label.a11yHidden = true
            el.addChild(label)
            if isItem {
                def sc:string (this.shortcutOf(el.id))
                if ((strlen sc) > 0) {
                    def scEl:EVGElement (EVGElement.createSpan())
                    scEl.className = "sx-menu-shortcut"
                    scEl.textContent = sc
                    scEl.elementType = 1
                    scEl.a11yHidden = true
                    el.addChild(scEl)
                }
                if ((indexOf cls "subtrigger") >= 0) {
                    el.addChild((RibbonCtl.glyph((SheetsApp.icon("chevronRight")) "sx-menu-chevron")))
                }
            }
            if isTrigger {
                el.addChild((RibbonCtl.glyph((SheetsApp.icon("chevron")) "sx-trigger-chevron")))
            }
            ; A submenu surface hangs off its row: keep it after the label.
            def k:int 0
            ; Decorated in the same pass: left for the next frame, the
            ; submenu's rows drew one frame bare on every rebuild.
            while (k < (array_length kids)) {
                def sub:EVGElement (itemAt kids k)
                el.addChild(sub)
                this.decorate(sub)
                k = (k + 1)
            }
            return
        }
        def i:int 0
        while (i < (array_length el.children)) {
            this.decorate((itemAt el.children i))
            i = (i + 1)
        }
    }

    fn isRadioRow:boolean (tid:string) {
        def menus:[MenuCtl] (this.allMenus())
        def i:int 0
        while (i < (array_length menus)) {
            def mc:MenuCtl (itemAt menus i)
            def idx:int (mc.rowIndexOf(tid))
            if (idx >= 0) {
                return ((itemAt mc.rowKind idx) == "radio")
            }
            i = (i + 1)
        }
        return false
    }

    fn shortcutOf:string (tid:string) {
        def v:string (this.leafValueOf(tid))
        if ((strlen v) == 0) {
            return ""
        }
        if (has actions v) {
            def a:SxAction (unwrap (get actions v))
            return a.shortcut
        }
        return ""
    }

    fn allMenus:[MenuCtl] () {
        def a:[MenuCtl]
        def i:int 0
        while (i < (array_length menubar.menus)) {
            def m:UiMenu (itemAt menubar.menus i)
            push a m.menu
            i = (i + 1)
        }
        push a fontMenu
        push a sizeMenu
        push a numMenu
        push a borderMenu
        push a cfMenu
        push a tableMenu
        push a styleMenu
        push a ctxMenu
        return a
    }

    fn layout:EVGElement () {
        def root:EVGElement (unwrap ui.root)
        this.decorate(root)
        ; The context menu sits where it was asked for.
        if ctxOpen {
            UiTree.inline(ctxHolder "left" ((to_string ctxX) + "px"))
            UiTree.inline(ctxHolder "top" ((to_string ctxY) + "px"))
        }
        ; An open task pane takes the grid's right edge.
        if ((strlen paneBuilt) > 0) {
            UiTree.inline(gridEl "width" ((to_string ((to_int pageW) - paneW)) + "px"))
        } {
            UiTree.inline(gridEl "width" "100%")
        }
        def page:EVGElement (ui.layout())
        if ctxOpen {
            if (this.fitCtxMenu()) {
                page = (ui.layout())
            }
        }
        ; The grid takes what the bars leave. Measured rather than left to
        ; flex-grow: the ribbon wraps onto a second row on a narrow page, and
        ; the height it wraps to is only known once it has been laid out.
        def used:double 0.0
        def ki:int 0
        while (ki < (array_length root.children)) {
            def kid:EVGElement (itemAt root.children ki)
            if ((kid.id != "sx-grid") && (kid.id != "sx-ctx-holder") && (kid.id != "sx-dlg-holder") && (kid.id != "sx-pane")) {
                used = (used + kid.calculatedHeight + 1.0)
            }
            ki = (ki + 1)
        }
        def wantH:int (to_int (pageH - used))
        if (wantH < 40) {
            wantH = 40
        }
        if (wantH != (to_int gridEl.calculatedHeight)) {
            UiTree.inline(gridEl "height" ((to_string wantH) + "px"))
            page = (ui.layout())
        }
        def nx:int (to_int gridEl.calculatedX)
        def ny:int (to_int gridEl.calculatedY)
        def nw:int (to_int gridEl.calculatedWidth)
        def nh:int (to_int gridEl.calculatedHeight)
        if (nw < 40) {
            nw = 40
        }
        if (nh < 40) {
            nh = 40
        }
        gx = nx
        gy = ny
        if ((strlen paneBuilt) > 0) {
            def ph:int nh
            UiTree.inline(paneHolder "left" ((to_string (nx + nw)) + "px"))
            UiTree.inline(paneHolder "top" ((to_string ny) + "px"))
            UiTree.inline(paneHolder "width" ((to_string paneW) + "px"))
            UiTree.inline(paneHolder "height" ((to_string ph) + "px"))
            ; A pane just mounted was laid out before it had a place; lay out
            ; again so its rows are in this frame, not the next one.
            if (((to_int paneHolder.calculatedY) != ny) || ((to_int paneHolder.calculatedX) != (nx + nw)) || ((to_int paneHolder.calculatedWidth) != paneW) || ((to_int paneHolder.calculatedHeight) != ph)) {
                page = (ui.layout())
            }
        }
        if ((nw != gw) || (nh != gh)) {
            gw = nw
            gh = nh
            grid.resize(gw gh)
        }
        return page
    }

    ; A context menu that would run off the page is moved back onto it: up,
    ; when it was opened low (a tab's menu always opens upward, off the
    ; strip), and left, when opened near the right edge. True if it moved.
    fn fitCtxMenu:boolean () {
        def r:string (ui.rectOf((ctxMenu.contentTid())))
        if ((strlen r) == 0) {
            return false
        }
        def parts:[string] (strsplit r ",")
        def mx:int (?? (to_int (itemAt parts 0)) 0)
        def my:int (?? (to_int (itemAt parts 1)) 0)
        def mw:int (?? (to_int (itemAt parts 2)) 0)
        def mh:int (?? (to_int (itemAt parts 3)) 0)
        def pw:int (to_int pageW)
        def ph:int (to_int pageH)
        def nx:int ctxX
        def ny:int ctxY
        if ((ctxKind == "tab") || ((my + mh) > ph)) {
            ny = (ctxY - mh)
            if ((ctxKind != "tab") && ((my + mh) > ph)) {
                ny = (ctxY - (((my + mh) - ph) + 4))
            }
            if (ny < 0) {
                ny = 0
            }
        }
        if ((mx + mw) > pw) {
            nx = (ctxX - (((mx + mw) - pw) + 4))
            if (nx < 0) {
                nx = 0
            }
        }
        if ((nx == ctxX) && (ny == ctxY)) {
            return false
        }
        UiTree.inline(ctxHolder "left" ((to_string nx) + "px"))
        UiTree.inline(ctxHolder "top" ((to_string ny) + "px"))
        return true
    }

    fn displayList:EVGDisplayList () {
        def page:EVGElement (this.layout())
        def gdl:EVGDisplayList (grid.app.sceneList())
        gdl.offsetBy((to_double gx) (to_double gy))
        def inGrid (new EVGDisplayList)
        inGrid.addClip((to_double gx) (to_double gy) (to_double gw) (to_double gh))
        inGrid.appendFrom(gdl)
        inGrid.addClipEnd()
        def lay (new EVGLayout())
        lay.setPageSize(pageW pageH)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.paintAt("sx-grid" inGrid)
        dl.build(page)
        return dl
    }

    fn scene:string () {
        def dl:EVGDisplayList (this.displayList())
        return ("{\"width\":" + (EVGDisplayList.num(pageW)) + ",\"height\":" + (EVGDisplayList.num(pageH)) + ",\"list\":" + (dl.toJson()) + "}")
    }

    ; One tree for a reader: the chrome's, with the core's hung under a region
    ; at the grid's rectangle. Ask for the scene first; this reads its layout.
    fn a11yTree:EVGA11yTree () {
        def t:EVGA11yTree (ui.a11yTree())
        def rootNode:EVGA11yNode (t.find("root"))
        rootNode.name = title
        ; The font and size triggers are named by what they show ("Open Sans",
        ; "11"); a reader also needs to hear what they are for.
        def fontNode:EVGA11yNode (t.find((fontMenu.triggerTid())))
        if ((strlen fontNode.id) > 0) {
            fontNode.name = ("Font: " + fontNode.name)
        }
        def sizeNode:EVGA11yNode (t.find((sizeMenu.triggerTid())))
        if ((strlen sizeNode.id) > 0) {
            sizeNode.name = ("Font size: " + sizeNode.name)
        }
        def region:EVGA11yNode (t.node("sx-grid" "root" (EVGA11yRole.region())))
        region.name = "Spreadsheet"
        t.place(region gx gy gw gh)
        def g:EVGA11yTree (grid.app.a11yTree())
        def i:int 0
        while (i < (array_length g.nodes)) {
            def n:EVGA11yNode (itemAt g.nodes i)
            if ((strlen n.parentId) == 0) {
                n.parentId = "sx-grid"
            }
            n.x = (n.x + gx)
            n.y = (n.y + gy)
            push t.nodes n
            i = (i + 1)
        }
        if showStatus {
            def live:EVGA11yNode (t.statusRegion("sx-status" "root" (this.statusText())))
            t.place(live (to_int statusEl.calculatedX) (to_int statusEl.calculatedY) (to_int statusEl.calculatedWidth) (to_int statusEl.calculatedHeight))
            def stats:EVGA11yNode (t.label("sx-stats" "root" (this.statsText())))
            t.place(stats (to_int statsEl.calculatedX) (to_int statsEl.calculatedY) (to_int statsEl.calculatedWidth) (to_int statsEl.calculatedHeight))
        }
        if (gridFocused || ((strlen ui.focusId) == 0)) {
            t.setFocus(g.focusId)
        } {
            t.setFocus(ui.focusId)
        }
        return t
    }

    fn a11y:string () {
        def t:EVGA11yTree (this.a11yTree())
        return (t.toJson())
    }

    fn width:int () {
        return (to_int pageW)
    }

    fn height:int () {
        return (to_int pageH)
    }

    ; =========================================================================
    ; Input
    ; =========================================================================

    fn insideGrid:boolean (x:int y:int) {
        return ((x >= gx) && (y >= gy) && (x < (gx + gw)) && (y < (gy + gh)))
    }

    fn anyMenuOpen:boolean () {
        if ((strlen menubar.openValue) > 0) {
            return true
        }
        if (fontMenu.open || sizeMenu.open || numMenu.open || borderMenu.open || ctxMenu.open || cfMenu.open || tableMenu.open || styleMenu.open) {
            return true
        }
        return false
    }

    fn closeMenus:void () {
        if ((strlen menubar.openValue) > 0) {
            menubar.closeMenu()
        }
        def menus:[MenuCtl] (this.allMenus())
        def i:int 0
        while (i < (array_length menus)) {
            def mc:MenuCtl (itemAt menus i)
            if mc.open {
                mc.closeMenu()
            }
            i = (i + 1)
        }
        ctxOpen = false
    }

    ; The value of the menu row `tid` names, when that row is a leaf a press
    ; would choose — "" for a trigger, a submenu row, a separator, a disabled
    ; row or anything that is not a menu row.
    fn leafValueOf:string (tid:string) {
        def menus:[MenuCtl] (this.allMenus())
        def i:int 0
        while (i < (array_length menus)) {
            def mc:MenuCtl (itemAt menus i)
            def idx:int (mc.rowIndexOf(tid))
            if (idx >= 0) {
                if (itemAt mc.rowIsSub idx) {
                    return ""
                }
                if (itemAt mc.rowDisabled idx) {
                    return ""
                }
                def it:UiItem (itemAt mc.rowItem idx)
                return it.value
            }
            i = (i + 1)
        }
        return ""
    }

    ; What pressing `target` will choose, worked out BEFORE the press: the
    ; controllers close a menu as they choose from it, and after that the row
    ; is gone.
    fn choiceOf:string (target:string) {
        def leaf:string (this.leafValueOf(target))
        if ((strlen leaf) > 0) {
            return leaf
        }
        return ""
    }

    fn pointer:void (x:int y:int down:boolean shift:boolean ctrl:boolean) {
        if gridCapture {
            grid.pointer((x - gx) (y - gy) down shift ctrl)
            if (down == false) {
                gridCapture = false
                held = false
            }
            this.sync()
            return
        }
        ; A press is an edge: the button held over the chrome is not pressed
        ; again on every move — unless it is carrying a tab.
        if (down && held) {
            if sliderDrag {
                ui.pointerMove((to_double x) (to_double y))
                this.zoomFromSlider()
                this.sync()
                return
            }
            if (tabDrag >= 0) {
                this.dragTabTo(x)
                this.sync()
            }
            return
        }
        held = down
        if ((down == false) && sliderDrag) {
            sliderDrag = false
        }
        if ((down == false) && (tabDrag >= 0)) {
            this.dropTab()
        }
        if (down == false) {
            ; A move or a release over the chrome.
            ui.pointerUp()
            def over:string (ui.hitTest((to_double x) (to_double y)))
            if ((strlen over) > 0) {
                ; On its way to an open submenu the pointer crosses the rows
                ; below it: those wait a moment instead of closing it at once.
                if (this.hoverHeld(over)) {
                    if (over != holdHover) {
                        holdHover = over
                        holdMs = 0.0
                    }
                    return
                }
                holdHover = ""
                ; Back on the row whose submenu is open: nothing to do. Hovered
                ; again, the menu shut that submenu and reopened it a moment later.
                if ((this.openSubTrigger(over)) == false) {
                    ui.hover(over)
                }
            } {
                holdHover = ""
                ui.unhover()
                if (this.insideGrid(x y)) {
                    grid.pointer((x - gx) (y - gy) false shift ctrl)
                }
            }
            return
        }
        def target:string (ui.hitTest((to_double x) (to_double y)))
        ; The zoom slider is dragged, not clicked.
        if ((strlen target) > 0) {
            if ((zoomSlider.owns(target)) && ((strlen (ui.dragBoundsFor(target))) > 0)) {
                def pressed:string (ui.pressAt((to_double x) (to_double y)))
                sliderDrag = true
                this.zoomFromSlider()
                this.sync()
                return
            }
        }
        if ((strlen target) > 0) {
            this.pressChrome(target shift ctrl)
            ; A press on a tab may become a carry, if it travels.
            def held2:int (this.tabSheetOf(target))
            if ((held2 >= 0) && (readOnly == false) && ((this.dialogOpen()) == false)) {
                tabDrag = held2
                tabDropAt = held2
                tabDragX = x
                tabDragMoved = false
            }
            return
        }
        ; A modal dialog owns the page until it closes.
        if (this.dialogOpen()) {
            return
        }
        ; A press outside an open menu closes it and does nothing else.
        if (this.anyMenuOpen()) {
            this.closeMenus()
            ui.blur()
            this.sync()
            return
        }
        if (this.insideGrid(x y)) {
            if ((shift == false) && (ctrl == false)) {
                if (this.headerArrowAt(x y)) {
                    return
                }
            }
            gridFocused = true
            ui.blur()
            gridCapture = true
            grid.pointer((x - gx) (y - gy) true shift ctrl)
            this.sync()
        }
    }

    fn zoomFromSlider:void () {
        def pct:int zoomSlider.value
        def cur:int (to_int ((grid.app.model.zoom * 100.0) + 0.5))
        if (pct != cur) {
            def ok:boolean (grid.run("view.zoom" (to_string pct)))
        }
    }

    fn pressChrome:void (target:string shift:boolean ctrl:boolean) {
        def choice:string (this.choiceOf(target))
        ; A press on a trigger of another menu closes the open one first.
        if ((ctxMenu.owns(target)) == false) {
            if ctxMenu.open {
                ctxMenu.closeMenu()
                ctxOpen = false
            }
        }
        def menus:[MenuCtl] ([] _:MenuCtl (fontMenu sizeMenu numMenu borderMenu cfMenu tableMenu styleMenu))
        def i:int 0
        while (i < (array_length menus)) {
            def mc:MenuCtl (itemAt menus i)
            if (mc.open && ((mc.owns(target)) == false)) {
                mc.closeMenu()
            }
            i = (i + 1)
        }
        if (((strlen menubar.openValue) > 0) && ((menubar.owns(target)) == false)) {
            menubar.closeMenu()
        }
        gridFocused = false
        ui.pressTidValue = target
        ui.clickWith(target shift ctrl)
        if (this.dialogOpen()) {
            def d:SxDialog (this.openDialog())
            if (d.isButton(target)) {
                def closed:boolean (d.act(target grid.app))
            }
            this.afterDialog()
            return
        }
        this.afterChrome(target choice)
    }

    ; =========================================================================
    ; Dialogs drawn with EVGUI controllers
    ; =========================================================================

    fn dialogs:[SxDialog] () {
        def a:[SxDialog]
        push a find
        push a paste
        push a rename
        push a link
        push a color
        push a border
        push a cf
        push a dv
        push a pick
        push a chart
        push a sql
        push a conn
        push a delSheet
        return a
    }

    fn dialogOpen:boolean () {
        def a:[SxDialog] (this.dialogs())
        def i:int 0
        while (i < (array_length a)) {
            def d:SxDialog (itemAt a i)
            if d.win.open {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; The open one. Only asked while `dialogOpen()` is true; Find otherwise.
    fn openDialog:SxDialog () {
        def a:[SxDialog] (this.dialogs())
        def i:int 0
        while (i < (array_length a)) {
            def d:SxDialog (itemAt a i)
            if d.win.open {
                return d
            }
            i = (i + 1)
        }
        return find
    }

    ; The core can still open its own EVGWindow for a dialog the app has
    ; replaced: a command run straight on the grid, a shortcut the core reads
    ; itself. Whatever opened it, the app's dialog is shown instead.
    fn adoptCoreDialogs:void () {
        def a:[SxDialog] (this.dialogs())
        def i:int 0
        while (i < (array_length a)) {
            def d:SxDialog (itemAt a i)
            if (d.adopt(grid.app)) {
                def ok:boolean (this.openDlg(d))
            }
            i = (i + 1)
        }
    }

    ; A dialog has opened with focus going to `at`.
    fn shown:boolean (at:string) {
        gridFocused = false
        ui.focus(at)
        this.sync()
        return true
    }

    fn openDlg:boolean (d:SxDialog) {
        this.closeMenus()
        if (readOnly && (d.writes())) {
            return false
        }
        return (this.shown((d.open(grid.app pageW pageH))))
    }

    fn openFind:boolean () {
        return (this.openDlg(find))
    }

    fn openPaste:boolean () {
        return (this.openDlg(paste))
    }

    ; After a dialog took an input: a closed dialog gives the keyboard back
    ; to the sheet.
    fn afterDialog:void () {
        if ((this.dialogOpen()) == false) {
            gridFocused = true
            ui.blur()
        }
        this.sync()
    }

    ; Keys while a dialog is up. Escape closes it, Tab walks its ring, Enter
    ; where the dialog says so is the default button, and Enter or Space on a
    ; button presses it; the rest goes to the focused controller.
    fn dialogKey:void (name:string shift:boolean ctrl:boolean) {
        def d:SxDialog (this.openDialog())
        def at:string ui.focusId
        if (d.holdsKeys(at)) {
            ui.keyWith(name shift ctrl)
            this.afterDialog()
            return
        }
        if (name == "Escape") {
            d.close()
            this.afterDialog()
            return
        }
        if (name == "Tab") {
            ui.focus((d.nextFocus(at shift)))
            this.sync()
            return
        }
        if ((name == "Enter") && (d.entersDefault(at))) {
            def c1:boolean (d.act((d.defaultTid()) grid.app))
            this.afterDialog()
            return
        }
        if (((name == "Enter") || (name == " ")) && (d.isButton(at))) {
            def c2:boolean (d.act(at grid.app))
            this.afterDialog()
            return
        }
        ui.keyWith(name shift ctrl)
        this.afterDialog()
    }

    ; After the chrome took an input: run what it chose, and hand the keyboard
    ; back to the sheet when a command ran — the way a spreadsheet's ribbon
    ; does, so typing after Bold goes into the cell.
    fn afterChrome:void (target:string choice:string) {
        def ran:boolean false
        if ((strlen choice) > 0) {
            ran = (this.runAction(choice))
            this.closeMenus()
        }
        if (this.paneAction()) {
            ran = true
        }
        def groups:[RibbonCtl] (this.ribbonGroups())
        push groups sheetTools
        push groups tabNav
        push groups viewTools
        push groups qat
        def i:int 0
        while (i < (array_length groups)) {
            def g:RibbonCtl (itemAt groups i)
            def v:string (g.takePressed())
            if ((strlen v) > 0) {
                ran = (this.runAction(v))
            }
            i = (i + 1)
        }
        ; A ribbon tab chosen is that tab's groups shown.
        if (ribTabs.owns(target)) {
            ; File is not a ribbon: it opens the File view and the ribbon stays.
            if (ribTabs.value == "file") {
                ribTabs.value = ribbonTab
                ribTabs.rovingValue = ribbonTab
                def bs:boolean (grid.run("file.backstage" ""))
                this.sync()
                return
            }
            if (((strlen ribTabs.value) > 0) && (ribTabs.value != ribbonTab)) {
                ribbonTab = ribTabs.value
                this.buildChrome()
                return
            }
        }
        ; A tab chosen is a sheet shown.
        def want:int (?? (to_int tabs.value) 0)
        if (tabs.owns(target) || (tabs.owns(ui.focusId))) {
            if ((want != grid.app.book.activeIndex) && (want >= 0) && (want < (grid.app.book.sheetCount()))) {
                grid.app.setActiveSheet(want)
            }
        }
        if ran {
            if ((grid.app.windows.anyModalVisible()) || ((this.anyMenuOpen()) == false)) {
                gridFocused = true
                ui.blur()
            }
        }
        this.sync()
    }

    ; The pane's title and rows, from the core, after every input.
    fn syncPane:void () {
        if ((strlen paneBuilt) == 0) {
            return
        }
        def app:GridApp grid.app
        if (app.paneSearches()) {
            if (paneSearch.value != app.paneFilter) {
                app.paneFilter = paneSearch.value
            }
        }
        paneTitleEl.textContent = (app.paneTitle())
        def rows:[string] (app.paneRows())
        def empty:[RibbonItem]
        paneList.items = empty
        paneList.name = (app.paneTitle())
        def i:int 0
        while ((i < (array_length rows)) && (i < 200)) {
            def it:RibbonItem (paneList.add(("pane-row-" + (to_string i)) (itemAt rows i) ""))
            it.text = (itemAt rows i)
            i = (i + 1)
        }
        paneList.build()
        paneHead.build()
        if (app.paneSearches()) {
            paneSearch.build()
        }
    }

    ; A press in the pane: a row is the core's to act on; ✕ closes it.
    fn paneAction:boolean () {
        def h:string (paneHead.takePressed())
        if (h == "pane-close") {
            grid.app.closePane()
            return true
        }
        def v:string (paneList.takePressed())
        if ((indexOf v "pane-row-") == 0) {
            def idx:int (?? (to_int (substring v 9 (strlen v))) -1)
            def ok:boolean (grid.app.paneChoose(idx))
            grid.app.refreshAll()
            return true
        }
        return false
    }

    fn runAction:boolean (value:string) {
        if ((has actions value) == false) {
            return false
        }
        def a:SxAction (unwrap (get actions value))
        def cmd:string a.command
        if ((indexOf cmd "sx:") == 0) {
            if (cmd == "sx:theme") {
                return (this.setTheme(a.arg))
            }
            ; The sheet's own clipboard, through the same paste as Ctrl+V.
            if (cmd == "sx:paste") {
                SheetsEdits.paste(grid.app grid.app.clipboardTsv (SheetsEdits.modeAll()))
                return true
            }
            if (cmd == "sx:pasteValues") {
                SheetsEdits.paste(grid.app grid.app.clipboardTsv (SheetsEdits.modeValues()))
                return true
            }
            if (cmd == "sx:formulaBar") {
                showFormulaBar = (showFormulaBar == false)
            }
            if (cmd == "sx:tabs") {
                showTabs = (showTabs == false)
            }
            if (cmd == "sx:status") {
                showStatus = (showStatus == false)
            }
            if (cmd == "sx:ribbon") {
                showRibbon = (showRibbon == false)
            }
            this.rebuildChrome()
            return true
        }
        if (cmd == "edit.find") {
            return (this.openFind())
        }
        if (cmd == "edit.pasteSpecial") {
            return (this.openPaste())
        }
        if (((cmd == "format.color") || (cmd == "format.fill")) && ((strlen a.arg) == 0)) {
            color.op = "color"
            if (cmd == "format.fill") {
                color.op = "fill"
            }
            return (this.openDlg(color))
        }
        if ((cmd == "format.border") && ((strlen a.arg) == 0)) {
            return (this.openDlg(border))
        }
        if (cmd == "format.conditional") {
            return (this.openDlg(cf))
        }
        if (cmd == "data.validation") {
            return (this.openDlg(dv))
        }
        if (cmd == "insert.link") {
            return (this.openDlg(link))
        }
        if (cmd == "sheet.delete") {
            if ((grid.app.book.sheetCount()) <= 1) {
                return false
            }
            return (this.openDlg(delSheet))
        }
        if ((cmd == "sheet.rename") && ((strlen a.arg) == 0)) {
            grid.app.renameIndex = grid.app.book.activeIndex
            return (this.openDlg(rename))
        }
        return (grid.run(cmd a.arg))
    }

    ; The secondary button on the sheet: the cell under it joins (or becomes)
    ; the selection, and the context menu opens at the pointer.
    fn rightClick:void (x:int y:int) {
        def onTab:int (this.tabSheetOf((ui.hitTest((to_double x) (to_double y)))))
        if (onTab >= 0) {
            this.tabMenu(onTab x y)
            return
        }
        if ((this.insideGrid(x y)) == false) {
            return
        }
        this.closeMenus()
        def app:GridApp grid.app
        def lx:int (x - gx)
        def ly:int (y - gy)
        def hit:CellPos (app.grid.hitTest(app.model lx ly))
        def kind:string "cell"
        if ((hit.row >= 0) && (hit.col >= 0)) {
            if ((app.sel.contains(hit.row hit.col)) == false) {
                grid.pointer(lx ly true false false)
                grid.pointer(lx ly false false false)
            }
        }
        if ((hit.row == -2) && (hit.col >= 0)) {
            kind = "column"
        }
        if ((hit.col == -2) && (hit.row >= 0)) {
            kind = "row"
        }
        if readOnly {
            this.sync()
            return
        }
        this.openCtxAt(kind hit x y)
    }

    ; The context menu for `kind` at (x, y). A header press first makes its
    ; band the selection, unless the band is already in a selection of whole
    ; columns (or rows) — so a Ctrl/Cmd-picked set of columns is kept.
    fn openCtxAt:void (kind:string hit:CellPos x:int y:int) {
        def app:GridApp grid.app
        if (kind == "column") {
            if ((this.bandSelected(hit.col true)) == false) {
                app.selectColumn(hit.col)
            }
        }
        if (kind == "row") {
            if ((this.bandSelected(hit.row false)) == false) {
                app.selectRow(hit.row)
            }
        }
        this.fillCtxMenu(kind)
        ctxX = x
        ctxY = y
        ctxOpen = true
        gridFocused = false
        def next:string (ctxMenu.contextClick((ctxMenu.triggerTid())))
        if ((strlen next) > 0) {
            ui.focusId = next
        }
        this.sync()
    }

    ; Is column (or row) `at` inside a selected rectangle that starts at the
    ; first row (column) — that is, one a header press made?
    fn bandSelected:boolean (at:int isCol:boolean) {
        def sel:GridSelection grid.app.sel
        def i:int 0
        while (i < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(i))
            if isCol {
                if ((g.r0 == 0) && (at >= g.c0) && (at <= g.c1)) {
                    return true
                }
            } {
                if ((g.c0 == 0) && (at >= g.r0) && (at <= g.r1)) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    ; A press on a column header's small arrow opens the column menu under it.
    fn headerArrowAt:boolean (x:int y:int) {
        if readOnly {
            return false
        }
        def app:GridApp grid.app
        def lx:int (x - gx)
        def ly:int (y - gy)
        def hit:CellPos (app.grid.hitTest(app.model lx ly))
        if ((hit.row != -2) || (hit.col < 0)) {
            return false
        }
        if ((app.hitColumnMenuArrow(hit.col lx ly)) == false) {
            return false
        }
        if app.editing {
            app.commitEdit()
        }
        def top:int ((app.grid.headerTop()) + app.grid.colHeaderH)
        this.openCtxAt("column" hit x (gy + top))
        return true
    }

    ; The secondary button on a tab: that sheet is shown, and its menu opens.
    fn tabMenu:void (at:int x:int y:int) {
        this.closeMenus()
        if (this.dialogOpen()) {
            return
        }
        if (at != grid.app.book.activeIndex) {
            grid.app.setActiveSheet(at)
        }
        if readOnly {
            this.sync()
            return
        }
        this.fillCtxMenu("tab")
        ctxX = x
        ctxY = y
        ; Its bottom edge sits on the strip's top edge, clear of the tabs.
        def r:string (ui.rectOf((tabs.tabTid((to_string at)))))
        if ((strlen r) > 0) {
            def parts:[string] (strsplit r ",")
            ctxY = ((?? (to_int (itemAt parts 1)) y) - 4)
        }
        ctxOpen = true
        gridFocused = false
        def next:string (ctxMenu.contextClick((ctxMenu.triggerTid())))
        if ((strlen next) > 0) {
            ui.focusId = next
        }
        this.sync()
    }

    ; The rows of the context menu for a press on a cell, a column header or
    ; a row header. Every header row is a command the core already has, run
    ; on the selection the press made.
    fn fillCtxMenu:void (kind:string) {
        ctxKind = kind
        if (kind == "cell") {
            ctxMenu.name = "Cell actions"
            ctxMenu.items = cellItems
            return
        }
        def fresh:[UiItem]
        if (kind == "tab") {
            ctxMenu.items = fresh
            def book:WorkbookModel grid.app.book
            def at:int book.activeIndex
            def n:int (book.sheetCount())
            def t:MenuCtl ctxMenu
            t.name = "Sheet actions"
            this.act("t-rename" "sheet.rename" "" "")
            t.addItem("t-rename" "Rename…" false)
            this.act("t-dup" "sheet.duplicate" "" "")
            t.addItem("t-dup" "Duplicate" false)
            this.act("t-add" "sheet.add" "" "")
            t.addItem("t-add" "Insert sheet" false)
            t.addSeparator()
            this.act("t-left" "sheet.move.left" "" "")
            t.addItem("t-left" "Move left" (at <= 0))
            this.act("t-right" "sheet.move.right" "" "")
            t.addItem("t-right" "Move right" (at >= (n - 1)))
            t.addSeparator()
            this.act("t-delete" "sheet.delete" "" "")
            t.addItem("t-delete" "Delete…" (n <= 1))
            t.addSeparator()
            def tcSub:UiItem (t.addSub("t-color" "Tab Color" false))
            this.kid(tcSub "t-c-red" "Red" "sheet.tabColor" "FF0000")
            this.kid(tcSub "t-c-orange" "Orange" "sheet.tabColor" "FFC000")
            this.kid(tcSub "t-c-green" "Green" "sheet.tabColor" "00B050")
            this.kid(tcSub "t-c-blue" "Blue" "sheet.tabColor" "0070C0")
            this.kid(tcSub "t-c-purple" "Purple" "sheet.tabColor" "7030A0")
            this.kid(tcSub "t-c-none" "No Color" "sheet.tabColor" "")
            this.act("t-hide" "sheet.hide" "" "")
            t.addItem("t-hide" "Hide" (n <= 1))
            def anyHidden:boolean false
            def hi:int 0
            while (hi < n) {
                def hs:SpreadsheetModel (book.sheetAt(hi))
                if hs.sheetHidden {
                    anyHidden = true
                }
                hi = (hi + 1)
            }
            this.act("t-unhide" "sheet.unhide" "" "")
            t.addItem("t-unhide" "Unhide…" (anyHidden == false))
            return
        }
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        grid.app.sel.normalized(a b)
        ctxMenu.items = fresh
        def m:MenuCtl ctxMenu
        if (kind == "column") {
            def span:string (SpreadsheetModel.colLabel(a.col))
            def noun:string "column "
            if (b.col > a.col) {
                span = ((span + " – ") + (SpreadsheetModel.colLabel(b.col)))
                noun = "columns "
            }
            m.name = "Column actions"
            this.item(m "h-cut" "Cut" "edit.cut" "" "Ctrl+X")
            this.item(m "h-copy" "Copy" "edit.copy" "" "Ctrl+C")
            this.item(m "h-paste" "Paste" "edit.paste" "" "Ctrl+V")
            this.item(m "h-pastespecial" "Paste special…" "edit.pasteSpecial" "" "")
            m.addSeparator()
            this.item(m "h-colleft" "Insert 1 column left" "insert.column.left" "" "")
            this.item(m "h-colright" "Insert 1 column right" "insert.column.right" "" "")
            this.item(m "h-delcols" ("Delete " + (noun + span)) "delete.columns" "" "")
            this.item(m "h-clearcols" ("Clear " + (noun + span)) "edit.clear" "" "Del")
            m.addSeparator()
            this.item(m "h-moveleft" "Move column left" "move.column.left" "" "")
            this.item(m "h-moveright" "Move column right" "move.column.right" "" "")
            this.item(m "h-fitcol" "Fit column width" "format.autofit.column" "" "")
            m.addSeparator()
            this.item(m "h-sortasc" "Sort sheet A → Z" "data.sort.asc" "" "")
            this.item(m "h-sortdesc" "Sort sheet Z → A" "data.sort.desc" "" "")
            this.item(m "h-filterclear" "Clear filters" "data.filter.clear" "" "")
            m.addSeparator()
            this.item(m "h-cf" "Conditional formatting…" "format.conditional" "" "")
            this.item(m "h-dv" "Data validation…" "data.validation" "" "")
            return
        }
        def rspan:string (to_string (a.row + 1))
        def rnoun:string "row "
        if (b.row > a.row) {
            rspan = ((rspan + " – ") + (to_string (b.row + 1)))
            rnoun = "rows "
        }
        m.name = "Row actions"
        this.item(m "r-cut" "Cut" "edit.cut" "" "Ctrl+X")
        this.item(m "r-copy" "Copy" "edit.copy" "" "Ctrl+C")
        this.item(m "r-paste" "Paste" "edit.paste" "" "Ctrl+V")
        this.item(m "r-pastespecial" "Paste special…" "edit.pasteSpecial" "" "")
        m.addSeparator()
        this.item(m "r-rowabove" "Insert 1 row above" "insert.row.above" "" "")
        this.item(m "r-rowbelow" "Insert 1 row below" "insert.row.below" "" "")
        this.item(m "r-delrows" ("Delete " + (rnoun + rspan)) "delete.rows" "" "")
        this.item(m "r-clearrows" ("Clear " + (rnoun + rspan)) "edit.clear" "" "Del")
        m.addSeparator()
        this.item(m "r-moveup" "Move row up" "move.row.up" "" "")
        this.item(m "r-movedown" "Move row down" "move.row.down" "" "")
        this.item(m "r-fitrow" "Fit row height" "format.autofit.row" "" "")
        m.addSeparator()
        this.item(m "r-cf" "Conditional formatting…" "format.conditional" "" "")
        this.item(m "r-dv" "Data validation…" "data.validation" "" "")
    }

    fn doubleClick:void (x:int y:int) {
        def target:string (ui.hitTest((to_double x) (to_double y)))
        if ((strlen target) > 0) {
            if (tabs.owns(target)) {
                if (readOnly == false) {
                    gridFocused = true
                    ui.blur()
                    def ok:boolean (grid.run("sheet.rename" ""))
                }
            }
            this.sync()
            return
        }
        if (this.insideGrid(x y)) {
            grid.autoFitAt((x - gx) (y - gy))
            this.sync()
        }
    }

    fn wheel:void (x:int y:int delta:int) {
        if (this.insideGrid(x y)) {
            grid.wheel((x - gx) (y - gy) delta)
            this.sync()
        }
    }

    fn wheelX:void (x:int y:int delta:int) {
        if (this.insideGrid(x y)) {
            grid.wheelX((x - gx) (y - gy) delta)
            this.sync()
        }
    }

    fn cursorAt:string (x:int y:int) {
        if tabDragMoved {
            return "grabbing"
        }
        if gridCapture {
            return (grid.cursorAt((x - gx) (y - gy)))
        }
        def over:string (ui.hitTest((to_double x) (to_double y)))
        if ((strlen over) > 0) {
            return "pointer"
        }
        if (this.insideGrid(x y)) {
            return (grid.cursorAt((x - gx) (y - gy)))
        }
        return "default"
    }

    ; Keys arrive by their DOM names ("ArrowLeft", "Enter", "F6", "a").
    fn key:void (name:string shift:boolean ctrl:boolean) {
        ; F6 walks the regions, the way an office suite does: menubar,
        ; toolbar, sheet, tabs, and round again.
        if (name == "F6") {
            this.cycleRegion(shift)
            this.sync()
            return
        }
        ; F10 goes to the menubar, as on every desktop.
        if (name == "F10") {
            if showMenubar {
                gridFocused = false
                ui.focus((menubar.triggerTid("file")))
            }
            this.sync()
            return
        }
        if (this.dialogOpen()) {
            this.dialogKey(name shift ctrl)
            return
        }
        if ((this.anyMenuOpen()) || (gridFocused == false)) {
            if ((name == "Escape") && ((this.anyMenuOpen()) == false)) {
                gridFocused = true
                ui.blur()
                this.sync()
                return
            }
            def target:string ui.focusId
            ; A menu opened with the pointer holds no focus for Escape to
            ; reach: Escape closes it here.
            if ((name == "Escape") && (this.anyMenuOpen()) && ((strlen target) == 0)) {
                this.closeMenus()
                gridFocused = true
                this.sync()
                return
            }
            ; Enter in the pane's search takes the first match.
            if ((name == "Enter") && (target == paneSearch.tid) && ((strlen paneBuilt) > 0)) {
                def took:boolean (grid.app.paneChoose(0))
                gridFocused = true
                ui.blur()
                this.sync()
                return
            }
            def choice:string ""
            if ((name == "Enter") || (name == " ")) {
                choice = (this.choiceOf(target))
            }
            def wasCtx:boolean ctxMenu.open
            def menuWas:boolean (this.anyMenuOpen())
            ui.keyWith(name shift ctrl)
            ; Escape always closes an open menu, wherever focus sits in it
            ; (a gallery's content panel does not handle keys itself).
            if ((name == "Escape") && menuWas && (this.anyMenuOpen())) {
                this.closeMenus()
                ui.blur()
                gridFocused = true
                this.sync()
                return
            }
            if (wasCtx && (ctxMenu.open == false)) {
                ctxOpen = false
                gridFocused = true
            }
            this.afterChrome(target choice)
            if (((strlen ui.focusId) == 0) && ((this.anyMenuOpen()) == false)) {
                gridFocused = true
            }
            return
        }
        if ((name == "Backspace") && (SheetsEdits.backspaceClears(grid.app))) {
            grid.key("delete" shift ctrl)
            this.sync()
            return
        }
        def gk:string (SheetsApp.gridKeyName(name))
        if ((strlen gk) > 0) {
            grid.key(gk shift ctrl)
        }
        this.sync()
    }

    sfn gridKeyName:string (name:string) {
        if (name == "Backspace") { return "backspace" }
        if (name == "Enter") { return "enter" }
        if (name == "Tab") { return "tab" }
        if (name == "Escape") { return "escape" }
        if (name == "ArrowLeft") { return "left" }
        if (name == "ArrowRight") { return "right" }
        if (name == "ArrowUp") { return "up" }
        if (name == "ArrowDown") { return "down" }
        if (name == "Delete") { return "delete" }
        if (name == "Home") { return "home" }
        if (name == "End") { return "end" }
        if (name == "PageUp") { return "pageUp" }
        if (name == "PageDown") { return "pageDown" }
        if (name == "F2") { return "f2" }
        return ""
    }

    ; Printable text, and Ctrl chords (`ctrl` true, `s` the letter). A chord
    ; goes to the sheet wherever focus is: Ctrl+Z undoes from the toolbar too.
    fn text:void (s:string shift:boolean ctrl:boolean) {
        ; While a dialog is up its fields take the text, and a chord is the
        ; field's (Ctrl+A selects the query), not the sheet's.
        if (this.dialogOpen()) {
            ; Space presses a button; on a field it is a space.
            def od:SxDialog (this.openDialog())
            if ((s == " ") && (od.isButton(ui.focusId))) {
                this.dialogKey(" " shift ctrl)
                return
            }
            if ctrl {
                ui.keyWith(s shift true)
            } {
                ui.type(s)
            }
            this.sync()
            return
        }
        ; Ctrl+F and Ctrl+H open Find and replace, as in Excel.
        if (ctrl && (((to_lowercase s) == "f") || ((to_lowercase s) == "h"))) {
            def opened:boolean (this.openFind())
            return
        }
        if ctrl {
            grid.text(s shift true)
            this.sync()
            return
        }
        if ((this.anyMenuOpen()) || (gridFocused == false)) {
            ui.type(s)
            this.sync()
            return
        }
        grid.text(s shift false)
        this.sync()
    }

    fn pasteText:void (s:string) {
        if (this.dialogOpen()) {
            ui.type(s)
            this.sync()
            return
        }
        SheetsEdits.paste(grid.app s (SheetsEdits.modeAll()))
        this.sync()
    }

    ; Ctrl+Shift+V: values only, into the cells' own formats.
    fn pasteTextValues:void (s:string) {
        if (this.dialogOpen()) {
            ui.type(s)
            this.sync()
            return
        }
        SheetsEdits.paste(grid.app s (SheetsEdits.modeValues()))
        this.sync()
    }

    fn idle:void () {
        grid.idle()
    }

    fn coasting:boolean () {
        return (grid.coasting())
    }

    ; One tick for the controllers: a submenu opens on a delay.
    ; A row of a menu whose submenu is open, outside that submenu: the hover
    ; it means is held for `holdDelayMs`.
    fn hoverHeld:boolean (over:string) {
        def menus:[MenuCtl] (this.allMenus())
        def i:int 0
        while (i < (array_length menus)) {
            def mc:MenuCtl (itemAt menus i)
            def depth:int (array_length mc.openPath)
            if (mc.open && (depth > 0) && ((mc.rowIndexOf(over)) >= 0)) {
                def deepest:string (itemAt mc.openPath (depth - 1))
                if ((indexOf over deepest) == 0) {
                    return false
                }
                if (mc.isOpenSub(over)) {
                    return false
                }
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn openSubTrigger:boolean (over:string) {
        def menus:[MenuCtl] (this.allMenus())
        def i:int 0
        while (i < (array_length menus)) {
            def mc:MenuCtl (itemAt menus i)
            if (mc.open && (mc.isOpenSub(over))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn tick:boolean (dtMs:double) {
        if ((strlen holdHover) > 0) {
            holdMs = (holdMs + dtMs)
            if (holdMs >= holdDelayMs) {
                def h:string holdHover
                holdHover = ""
                ui.hover(h)
            }
        }
        def busy:boolean ((ui.tick(dtMs)) || ((strlen holdHover) > 0))
        return (busy || (menubar.pendingSub()))
    }

    ; The regions F6 visits, in order, with the first focusable id of each.
    fn regionStops:[string] () {
        def a:[string]
        if showMenubar {
            push a (menubar.triggerTid("file"))
        }
        if (showRibbon && (readOnly == false)) {
            def groups:[RibbonCtl] (this.ribbonGroups())
            def i:int 0
            def found:boolean false
            while ((i < (array_length groups)) && (found == false)) {
                def g:RibbonCtl (itemAt groups i)
                if ((g.buttonCount()) > 0) {
                    push a (g.itemTid(g.rovingValue))
                    found = true
                }
                i = (i + 1)
            }
        }
        push a "sx-grid"
        if showTabs {
            push a (tabs.tabTid(tabs.value))
        }
        return a
    }

    fn cycleRegion:void (back:boolean) {
        this.closeMenus()
        def stops:[string] (this.regionStops())
        def n:int (array_length stops)
        def cur:int 0
        def i:int 0
        while (i < n) {
            def s:string (itemAt stops i)
            if (s == "sx-grid") {
                if gridFocused {
                    cur = i
                }
            } {
                if ((gridFocused == false) && (this.sameRegion(s ui.focusId))) {
                    cur = i
                }
            }
            i = (i + 1)
        }
        def next:int (cur + 1)
        if back {
            next = (cur - 1)
        }
        if (next >= n) {
            next = 0
        }
        if (next < 0) {
            next = (n - 1)
        }
        def want:string (itemAt stops next)
        if (want == "sx-grid") {
            gridFocused = true
            ui.blur()
        } {
            gridFocused = false
            ui.focus(want)
        }
    }

    fn sameRegion:boolean (stop:string focus:string) {
        if ((strlen focus) == 0) {
            return false
        }
        if (menubar.owns(stop)) {
            return (menubar.owns(focus))
        }
        if (tabs.owns(stop)) {
            return (tabs.owns(focus))
        }
        ; Any ribbon control counts as the ribbon.
        return ((indexOf focus "sx-rb-") == 0) || ((indexOf focus "sx-font") == 0) || ((indexOf focus "sx-size") == 0) || ((indexOf focus "sx-num") == 0) || ((indexOf focus "sx-borders") == 0)
    }

    ; Everything a page needs to know about the sheet, plus the chrome's own.
    fn state:string () {
        def s:string (grid.state())
        def inner:string (substring s 1 ((strlen s) - 1))
        return ("{\"gridFocused\":" + (GridApp.jsonBool(gridFocused)) + ",\"uiFocus\":" + (GridApp.jsonStr(ui.focusId)) + ",\"menuOpen\":" + (GridApp.jsonBool((this.anyMenuOpen()))) + ",\"options\":" + (this.optionsJson()) + "," + inner + "}")
    }

    ; Press a control by its id — what a test (or a reader's activation, which
    ; the mirror turns into a press at the node's centre) does.
    fn pressId:boolean (tid:string) {
        def r:string (ui.rectOf(tid))
        if ((strlen r) == 0) {
            return false
        }
        def parts:[string] (strsplit r ",")
        def x:int (?? (to_int (itemAt parts 0)) 0)
        def y:int (?? (to_int (itemAt parts 1)) 0)
        def w:int (?? (to_int (itemAt parts 2)) 0)
        def h:int (?? (to_int (itemAt parts 3)) 0)
        this.pointer((x + (idiv w 2)) (y + (idiv h 2)) true false false)
        this.pointer((x + (idiv w 2)) (y + (idiv h 2)) false false false)
        return true
    }

    fn rectOf:string (tid:string) {
        return (ui.rectOf(tid))
    }

    ; The facade the page also reaches through: files, clipboard, requests.
    fn takeFileRequest:string () {
        return (grid.takeFileRequest())
    }

    fn copySeq:int () {
        return (grid.copySeq())
    }
}

; The selection's count and sum, from the model. A small class rather than
; JSON parsed back, so the status line and `stateJson` count the same cells.
class SxStats {
    def count:int 0
    def nums:int 0
    def sum:double 0.0

    Constructor () {
    }

    sfn of:SxStats (app:GridApp) {
        def s (new SxStats())
        def model:SpreadsheetModel app.model
        def sel:GridSelection app.sel
        def lastR:int (model.usedRow())
        def lastC:int (model.usedCol())
        def seen:int 0
        def ri:int 0
        while (ri < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(ri))
            def r0:int g.r0
            def r1:int g.r1
            def c0:int g.c0
            def c1:int g.c1
            if (r0 > r1) {
                def t:int r0
                r0 = r1
                r1 = t
            }
            if (c0 > c1) {
                def t2:int c0
                c0 = c1
                c1 = t2
            }
            if (r1 > lastR) {
                r1 = lastR
            }
            if (c1 > lastC) {
                c1 = lastC
            }
            def r:int r0
            while ((r <= r1) && (seen <= 50000)) {
                def c:int c0
                while (c <= c1) {
                    seen = (seen + 1)
                    def raw:string (trim (model.getCell(r c)))
                    if ((strlen raw) > 0) {
                        s.count = (s.count + 1)
                        if (ChartData.looksNumeric(raw)) {
                            s.sum = (s.sum + (ConditionalFormat.cellNumber(model r c)))
                            s.nums = (s.nums + 1)
                        }
                    }
                    c = (c + 1)
                }
                r = (r + 1)
            }
            ri = (ri + 1)
        }
        return s
    }
}
