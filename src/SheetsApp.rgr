    ; The toolbars of the tab that is showing, in the order they are mounted.
    fn ribbonGroups:[RibbonCtl] () {
        if (ribbonTab != "home") {
            return (this.groupsOf(ribbonTab))
        }
        if ((array_length tools) > 0) {
            return ([] _:RibbonCtl (history textTools alignTools numberTools dataTools insertTools))
        }
        return ([] _:RibbonCtl (xUndo xClip xFontA xFontB xFontC xAlignV xAlignH xNum xSum xAddins))
    }

    ; Every toolbar whose buttons mirror the caret's cell, whichever is showing.
    fn stateGroups:[RibbonCtl] () {
        return ([] _:RibbonCtl (history textTools alignTools numberTools dataTools xUndo xClip xFontB xFontC xAlignV xAlignH xNum))
    }

    ; The ribbon's drop-down menus.
    fn ribbonMenus:[MenuCtl] () {
        def out:[MenuCtl] ([] _:MenuCtl (fontMenu sizeMenu numMenu borderMenu cfMenu tableMenu styleMenu pasteMenu mergeMenu insMenu delMenu fmtMenu fillMenu clearMenu sortMenu findMenu cgClip cgAlign cgNum cgStyles cgEdit))
        def i:int 0
        while (i < (array_length tabMenus)) {
            push out (itemAt tabMenus i)
            i = (i + 1)
        }
        return out
    }

    ; Lucide's icons (ISC licence), 24×24, stroked.
    sfn icon:string (name:string) {
        if (name == "save") { return "M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7 M7 3v4a1 1 0 0 0 1 1h7" }
        if (name == "undo") { return "M9 14 4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" }
        if (name == "redo") { return "m15 14 5-5-5-5 M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13" }
        if (name == "painter") { return "M18 4H6a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z M20 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-8.5 M12 12v3 M11 15h2v6h-2z" }
        if (name == "bold") { return "M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8" }
        if (name == "italic") { return "M19 4h-9 M14 20H5 M15 4 9 20" }
        if (name == "underline") { return "M6 4v6a6 6 0 0 0 12 0V4 M4 20h16" }
        if (name == "strike") { return "M16 4H9a3 3 0 0 0-2.83 4 M14 12a4 4 0 0 1 0 8H6 M4 12h16" }
        if (name == "color") { return "M5 16 12 3l7 13 M8 11h8" }
        if (name == "fill") { return "m19 11-8-8-8.6 8.6a2 2 0 0 0 0 2.8l5.2 5.2c.8.8 2 .8 2.8 0L19 11Z M5 2l5 5 M2 13h15" }
        if (name == "left") { return "M21 6H3 M15 12H3 M17 18H3" }
        if (name == "center") { return "M21 6H3 M17 12H7 M19 18H5" }
        if (name == "right") { return "M21 6H3 M21 12H9 M21 18H7" }
