    ; Each group's folded drop-down: its buttons as rows, its drop-downs as
    ; submenus, under the group's name.
    fn buildFolds:void () {
        def i:int 0
        while (i < (array_length tabSets)) {
            def g:SxGroup (itemAt tabSets i)
            def m:MenuCtl (this.drop((g.tid + "-fold") g.name))
            def pre:string ("fd" + (to_string i) + "-")
            def k:int 0
            while (k < (array_length g.slots)) {
                def sl:SxSlot (itemAt g.slots k)
                if sl.isMenu {
                    this.subOf(m (pre + sl.menu.tid) sl.menu.name sl.menu)
                } {
                    this.copyBar(m sl.bar pre)
                }
                k = (k + 1)
            }
            g.fold = m
            push tabMenus m
            i = (i + 1)
        }
    }

    ; Roughly how wide a group lays out, from its words: a labelled button is
    ; its glyph, its caption (Open Sans 12px) and padding; a drop-down is its
    ; name (13px) and chevron. Measured against the drawn widths in the smoke.
    fn barWidth:int (r:RibbonCtl small:boolean) {
        def w:double 6.0
        def i:int 0
        while (i < (array_length r.items)) {
            def it:RibbonItem (itemAt r.items i)
            if (it.separator == false) {
                if (((strlen it.text) > 0) && ((small == false) || ((strlen it.icon) == 0))) {
                    w = (w + 38.0 + ((to_double (strlen it.text)) * 6.6))
                } {
                    w = (w + 29.0)
                }
            }
            i = (i + 1)
        }
        return (to_int w)
    }

    fn menuWidth:int (m:MenuCtl) {
        return (to_int (38.0 + ((to_double (strlen m.name)) * 7.2)))
    }

    fn setWidth:int (g:SxGroup small:boolean) {
        def body:int 0
        def c:int 0
        while (c < g.cols) {
            def cw:int 0
            def k:int 0
            while (k < (array_length g.slots)) {
                def sl:SxSlot (itemAt g.slots k)
                if (sl.col == c) {
                    def w:int 0
                    if sl.isMenu {
                        w = (this.menuWidth(sl.menu))
                    } {
                        w = (this.barWidth(sl.bar small))
                    }
                    if (w > cw) {
                        cw = w
                    }
                }
                k = (k + 1)
            }
            body = (body + cw)
            if (c > 0) {
                body = (body + 4)
            }
            c = (c + 1)
        }
        def cap:int (to_int ((to_double (strlen g.name)) * 6.2))
        if (cap > body) {
            body = cap
        }
        ; The group's padding, the rule before it and the bar's two gaps.
        return (body + 17)
    }

    ; How the groups of `tab` shrink at this width, as Excel's do: from the
    ; right, a group first drops its captions ("c:" and its tid), and when
    ; every group has and the tab still does not fit, groups fold into their
    ; drop-downs ("f:"), again from the right.
    fn tabFolds:[string] (tab:string) {
        def out:[string]
        def sets:[SxGroup]
        def i:int 0
        while (i < (array_length tabSets)) {
            def g:SxGroup (itemAt tabSets i)
            if (g.tab == tab) {
                push sets g
            }
            i = (i + 1)
        }
        def n:int (array_length sets)
        def need:int 20
        def j:int 0
        while (j < n) {
            need = (need + (this.setWidth((itemAt sets j) false)))
            j = (j + 1)
        }
        def avail:int (to_int pageW)
        ; Two passes each: the other groups first, then the ones kept.
        def pass:int 0
        while (pass < 2) {
            def k:int (n - 1)
            while ((need > avail) && (k >= 0)) {
                def g2:SxGroup (itemAt sets k)
                if (g2.keep == (pass == 1)) {
                    push out ("c:" + g2.tid)
                    need = ((need - (this.setWidth(g2 false))) + (this.setWidth(g2 true)))
                }
                k = (k - 1)
            }
            pass = (pass + 1)
        }
        pass = 0
        while (pass < 2) {
            def k2:int (n - 1)
            while ((need > avail) && (k2 >= 0)) {
                def g3:SxGroup (itemAt sets k2)
                if (g3.keep == (pass == 1)) {
                    push out ("f:" + g3.tid)
                    need = ((need - (this.setWidth(g3 true))) + ((this.menuWidth(g3.fold)) + 17))
                }
                k2 = (k2 - 1)
            }
            pass = (pass + 1)
        }
        return out
    }

    ; The groups of the shown tab past Home, folded or laid out.
    fn buildTabGroups:void () {
        def fold:[string] (this.tabFolds(ribbonTab))
        def i:int 0
        while (i < (array_length tabSets)) {
            def g:SxGroup (itemAt tabSets i)
            if (g.tab == ribbonTab) {
                def small:boolean (RibbonCtl.listHas(fold ("c:" + g.tid)))
                if (RibbonCtl.listHas(fold ("f:" + g.tid))) {
                    this.foldedGroup(g.tid g.name g.fold)
                } {
                    def box:RibbonGroupCtl (this.openGroup(g.tid g.name))
                    def c:int 0
                    while (c < g.cols) {
                        def col:EVGElement (this.groupCol(box))
                        def k:int 0
                        while (k < (array_length g.slots)) {
                            def sl:SxSlot (itemAt g.slots k)
                            if (sl.col == c) {
                                if sl.isMenu {
                                    this.mount((this.groupRow(col)) sl.menu)
                                } {
                                    sl.bar.iconsOnly = small
                                    this.mountInRow(col sl.bar box)
                                }
                            }
                            k = (k + 1)
                        }
                        c = (c + 1)
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; The toggles on the tabs past Home say what is shown.
    fn syncTabToggles:void () {
        def app:GridApp grid.app
        def model:SpreadsheetModel app.model
        def rs:[RibbonCtl] (this.groupsOf(ribbonTab))
        def i:int 0
        while (i < (array_length rs)) {
            def r:RibbonCtl (itemAt rs i)
            r.setOn("v-grid" model.showGridlines)
            r.setOn("p-vgrid" model.showGridlines)
            r.setOn("v-head" model.showHeadings)
            r.setOn("p-vhead" model.showHeadings)
            r.setOn("p-gridlines" model.printGridlines)
            r.setOn("p-headings" model.printHeadings)
            r.setOn("v-ruler" model.showRuler)
            r.setOn("f-show" model.showFormulas)
            r.setOn("v-fbar" showFormulaBar)
            r.setOn("v-tabs" showTabs)
            r.setOn("v-status" showStatus)
            r.setOn("v-dark" (theme == "dark"))
            r.setOn("v-rtl" app.uiRtl)
            r.setOn("v-menubar" showMenubar)
            r.setOn("v-expand" app.fbExpanded)
            i = (i + 1)
        }
        themeBar.setOn("hdr-theme" (theme == "dark"))
    }

