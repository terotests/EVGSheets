Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

; What a menu row or a ribbon button does: a GridApp command and its argument,
; or one of the app's own verbs ("sx:…") that the core does not have.
class SxAction {
    def value:string ""
    def command:string ""
    def arg:string ""
    def shortcut:string ""

    Constructor () {
    }
}

class SheetsApp {
    def grid:DataGridWeb (new DataGridWeb)
    def ui:UiHost (new UiHost)

    def menubar:MenubarCtl (new MenubarCtl)
    def fontMenu:MenuCtl (new MenuCtl)
    def sizeMenu:MenuCtl (new MenuCtl)
    def numMenu:MenuCtl (new MenuCtl)
    def borderMenu:MenuCtl (new MenuCtl)
    ; The Styles galleries: Conditional Formatting, Format as Table, Cell Styles.
    def cfMenu:MenuCtl (new MenuCtl)
    def tableMenu:MenuCtl (new MenuCtl)
    def styleMenu:MenuCtl (new MenuCtl)
    ; The Quick Access Toolbar in the title bar, and the status bar's zoom slider.
    def qat:RibbonCtl (new RibbonCtl)
    def zoomSlider:SliderCtl (new SliderCtl)
    def sliderDrag:boolean false
    ; A hover the pointer passed over on its way to an open submenu.
    def holdHover:string ""
    ; The first tab the strip shows (see tabWindow).
    def tabFirst:int 0
    def holdMs:double 0.0
    def holdDelayMs:double 400.0
    ; The contextual tab showing: "tabledesign", "chartdesign" or "".
    def ctxTab:string ""
    ; The colour each sheet's tab was drawn with, by sheet index.
    def tabColours:[string:string]
    def ctxMenu:MenuCtl (new MenuCtl)
    def history:RibbonCtl (new RibbonCtl)
    def textTools:RibbonCtl (new RibbonCtl)
    def alignTools:RibbonCtl (new RibbonCtl)
    def numberTools:RibbonCtl (new RibbonCtl)
    def dataTools:RibbonCtl (new RibbonCtl)
    def insertTools:RibbonCtl (new RibbonCtl)
    def tabs:TabsCtl (new TabsCtl)
    def sheetTools:RibbonCtl (new RibbonCtl)
    ; Excel's ribbon: a row of tabs, each with its own groups. Home keeps the
    ; groups above; the rest are listed in `tabGroups`, `tabOf` naming the tab.
    def ribTabs:TabsCtl (new TabsCtl)
    def ribbonTab:string "home"
    def tabGroups:[RibbonCtl]
    def tabOf:[string]
    def ribTabRow:EVGElement (EVGElement.createDiv())
    ; Footer: scroll through the sheets, and the status bar's view and zoom.
    def tabNav:RibbonCtl (new RibbonCtl)
    def viewTools:RibbonCtl (new RibbonCtl)

    ; The page's own elements (not controllers).
    def headerEl:EVGElement (EVGElement.createDiv())
    def ribbonEl:EVGElement (EVGElement.createDiv())
    def gridEl:EVGElement (EVGElement.createDiv())
    def footerEl:EVGElement (EVGElement.createDiv())
    def titleEl:EVGElement (EVGElement.createSpan())
    def docEl:EVGElement (EVGElement.createSpan())
    def statusEl:EVGElement (EVGElement.createSpan())
    def statsEl:EVGElement (EVGElement.createSpan())
    def badgeEl:EVGElement (EVGElement.createSpan())
    def ctxHolder:EVGElement (EVGElement.createDiv())
    ; The task pane at the right of the grid (Insert Function, Name Manager,
    ; Watch Window, Comments, Selection, PivotTable Fields, Format Chart):
    ; what it lists is the core's (`paneRows`), and a row pressed is
    ; `paneChoose`.
    def paneHolder:EVGElement (EVGElement.createDiv())
    def paneTitleEl:EVGElement (EVGElement.createSpan())
    def paneHead:RibbonCtl (new RibbonCtl)
    def paneSearch:InputCtl (new InputCtl)
    def paneList:RibbonCtl (new RibbonCtl)
    def paneBuilt:string ""
    def paneW:int 280
    ; The dialogs the app draws with EVGUI controllers instead of leaving them
    ; to the core's EVGWindow, moved over one at a time.
    def find:FindDialog (new FindDialog)
    def paste:PasteDialog (new PasteDialog)
    def rename:RenameDialog (new RenameDialog)
    def link:LinkDialog (new LinkDialog)
    def color:ColorDialog (new ColorDialog)
    def border:BorderDialog (new BorderDialog)
    def cf:CfDialog (new CfDialog)
    def dv:ValidationDialog (new ValidationDialog)
    def pick:ListDialog (new ListDialog)
    def chart:ChartDialog (new ChartDialog)
    def sql:SqlDialog (new SqlDialog)
    def conn:ConnDialog (new ConnDialog)
    def delSheet:DeleteSheetDialog (new DeleteSheetDialog)
    def dlgHolder:EVGElement (EVGElement.createDiv())

    def actions:[string:SxAction]

    ; --- what is shown ------------------------------------------------------
    def preset:string "full"
    def showMenubar:boolean true
    def showRibbon:boolean true
    def showFormulaBar:boolean true
    def showTabs:boolean true
    def showStatus:boolean true
    def showTitle:boolean true
    def readOnly:boolean false
    ; Ribbon tools to keep, by value; empty keeps them all.
    def tools:[string]
    def theme:string "light"
    def title:string "EVGSheets"

    ; --- geometry -----------------------------------------------------------
    def pageW:double 1100.0
    def pageH:double 700.0
    def gx:int 0
    def gy:int 0
    def gw:int 0
    def gh:int 0

    ; --- focus and pointer ----------------------------------------------------
    ; Who has the keyboard: the sheet, or an EVGUI control (ui.focusId).
    def gridFocused:boolean true
    ; A press that began on the grid keeps going to the grid until it is let
    ; go, wherever the pointer wanders — a drag-select past the edge.
    def gridCapture:boolean false
    def held:boolean false
    def ctxOpen:boolean false
    def ctxX:int 0
    def ctxY:int 0
    ; The context menu has three faces: a cell, a column header, a row header.
    ; The cell rows are built once and put back; a header's are made per press,
    ; because they name the columns or rows they act on.
    def ctxKind:string "cell"
    def cellItems:[UiItem]
    ; A tab carried along the strip. `tabDrag` is the sheet held (-1: none),
    ; `tabDropAt` where it would land, shown by drawing the tabs in that
    ; order; the sheet itself moves once, on release.
    def tabDrag:int -1
    def tabDropAt:int -1
    def tabDragX:int 0
    def tabDragMoved:boolean false
    def lastSheetsKey:string ""
    def built:boolean false

    Constructor () {
        def m:[string:SxAction]
        actions = m
        def t:[string]
        tools = t
    }

    ; =========================================================================
    ; Starting up
    ; =========================================================================

    fn start:void (w:int h:int css:string) {
        pageW = (to_double w)
        pageH = (to_double h)
        ui.setPageSize(pageW pageH)
        if ((strlen css) > 0) {
            ui.addStyleSheet(css)
        }
        ; The core starts at the full size and is told its real rectangle by
        ; the first layout.
        grid.start(w h)
        grid.app.setChrome(false true false false)
        ; The column and row menus are this app's (fillCtxMenu); the core's
        ; numbered header popups stay closed.
        grid.app.hostHeaderMenus = true
        def themed:boolean (grid.setTheme("modern"))
        this.buildModels()
        this.buildChrome()
        built = true
    }

    fn addFont:boolean (family:string data:buffer) {
        grid.app.addScriptFont(family data)
        return (grid.addFont(family data))
    }

    fn addFace:boolean (data:buffer) {
        grid.app.addScriptFont("" data)
        return (grid.addFace(data))
    }

    fn useDemo:void () {
        grid.useDemo()
        this.sync()
    }

    ; One empty sheet, the same as File > New workbook.
    fn useBlank:void () {
        grid.app.newBlankWorkbook()
        this.sync()
    }

    fn openWorkbook:boolean (data:buffer name:string) {
        def ok:boolean (grid.openWorkbook(data name))
        this.sync()
        return ok
    }

    fn openWorkbookPassword:boolean (data:buffer name:string password:string) {
        def ok:boolean (grid.openWorkbookPassword(data name password))
        this.sync()
        return ok
    }

    fn showSheet:boolean (name:string) {
        def ok:boolean (grid.showSheet(name))
        this.sync()
        return ok
    }

    fn resize:void (w:int h:int) {
        pageW = (to_double w)
        pageH = (to_double h)
        ui.setPageSize(pageW pageH)
    }

    ; =========================================================================
    ; Parameters: which pieces exist
    ; =========================================================================

    ; A preset is a starting point; `setOption` changes one piece after it.
    ;   full     menubar, ribbon, formula bar, sheet tabs, status bar
    ;   compact  a short ribbon, formula bar, tabs, status — no menubar
    ;   viewer   read-only: tabs and status only; select, scroll, copy, sort
    ;   grid     the bare grid, editable, nothing around it
    fn setPreset:boolean (name:string) {
        def n:string (to_lowercase (trim name))
        def empty:[string]
        tools = empty
        if (n == "full") {
            showMenubar = true
            showRibbon = true
            showFormulaBar = true
            showTabs = true
            showStatus = true
            showTitle = true
            readOnly = false
        } {
            if (n == "compact") {
                showMenubar = false
                showRibbon = true
                showFormulaBar = true
                showTabs = true
                showStatus = true
                showTitle = false
                readOnly = false
                tools = (strsplit "undo,redo,bold,italic,underline,color,fill,left,center,right,numfmt,percent,sortasc,sortdesc,chart" ",")
            } {
                if (n == "viewer") {
                    showMenubar = false
                    showRibbon = false
                    showFormulaBar = false
                    showTabs = true
                    showStatus = true
                    showTitle = false
                    readOnly = true
                } {
                    if (n == "grid") {
                        showMenubar = false
                        showRibbon = false
                        showFormulaBar = false
                        showTabs = false
                        showStatus = false
                        showTitle = false
                        readOnly = false
                    } {
                        return false
                    }
                }
            }
        }
        preset = n
        this.rebuildChrome()
        return true
    }

    ; One switch by name: menubar, ribbon, formulaBar, tabs, status, title,
    ; readOnly ("true"/"false"), tools (a comma list of ribbon values, or ""
    ; for all of them), theme ("light"/"dark"), name (the document title).
    fn setOption:boolean (name:string value:string) {
        def on:boolean ((value == "true") || (value == "1") || (value == "on") || (value == "yes"))
        if (name == "menubar") {
            showMenubar = on
        } {
            if (name == "ribbon") {
                showRibbon = on
            } {
                if (name == "formulaBar") {
                    showFormulaBar = on
                } {
                    if (name == "tabs") {
                        showTabs = on
                    } {
                        if (name == "status") {
                            showStatus = on
                        } {
                            if (name == "title") {
                                showTitle = on
                            } {
                                if (name == "readOnly") {
                                    readOnly = on
                                } {
                                    if (name == "tools") {
                                        def empty:[string]
                                        tools = empty
                                        if ((strlen (trim value)) > 0) {
                                            tools = (strsplit (trim value) ",")
                                        }
                                    } {
                                        if (name == "theme") {
                                            return (this.setTheme(value))
                                        } {
                                            if (name == "name") {
                                                title = value
                                            } {
                                                return false
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        this.rebuildChrome()
        return true
    }

    fn setTheme:boolean (name:string) {
        def n:string (to_lowercase (trim name))
        if ((n != "light") && (n != "dark")) {
            return false
        }
        theme = n
        if (n == "dark") {
            ui.setTheme("dark")
            def a:boolean (grid.setTheme("dark"))
        } {
            ui.setTheme("")
            def b:boolean (grid.setTheme("modern"))
        }
        this.sync()
        return true
    }

    ; Everything the page shows, as JSON a host can read back.
    fn optionsJson:string () {
        def o:string "{"
        o = (o + "\"preset\":" + (GridApp.jsonStr(preset)))
        o = (o + ",\"menubar\":" + (GridApp.jsonBool(showMenubar)))
        o = (o + ",\"ribbon\":" + (GridApp.jsonBool(showRibbon)))
        o = (o + ",\"formulaBar\":" + (GridApp.jsonBool(showFormulaBar)))
        o = (o + ",\"tabs\":" + (GridApp.jsonBool(showTabs)))
        o = (o + ",\"status\":" + (GridApp.jsonBool(showStatus)))
        o = (o + ",\"title\":" + (GridApp.jsonBool(showTitle)))
        o = (o + ",\"readOnly\":" + (GridApp.jsonBool(readOnly)))
        o = (o + ",\"theme\":" + (GridApp.jsonStr(theme)))
        o = (o + ",\"tools\":" + (GridApp.jsonStr((join tools ","))))
        o = (o + "}")
        return o
    }

    ; =========================================================================
    ; The models: menus, ribbon groups, tabs
    ; =========================================================================

    fn act:SxAction (value:string command:string arg:string shortcut:string) {
        def a (new SxAction())
        a.value = value
        a.command = command
        a.arg = arg
        a.shortcut = shortcut
        set actions value a
        return a
    }

    fn item:void (mc:MenuCtl value:string label:string command:string arg:string shortcut:string) {
        this.act(value command arg shortcut)
        mc.addItem(value label false)
    }

    fn kid:void (parent:UiItem value:string label:string command:string arg:string) {
        this.act(value command arg "")
        def k:UiItem (MenuCtl.addKid(parent value label false))
    }

    fn buildModels:void () {
        ; --- the menubar ---------------------------------------------------
        menubar = (new MenubarCtl)
        menubar.tid = "sx-mb"
        menubar.name = "Main menu"
        menubar.addMenu("file" "File")
        menubar.addMenu("edit" "Edit")
        menubar.addMenu("view" "View")
        menubar.addMenu("insert" "Insert")
        menubar.addMenu("format" "Format")
        menubar.addMenu("data" "Data")
        menubar.addMenu("pagelayout" "Page Layout")
        menubar.addMenu("formulas" "Formulas")
        menubar.addMenu("review" "Review")

        def f:MenuCtl (menubar.attachMenu("file"))
        this.item(f "new" "New workbook" "file.new" "" "")
        this.item(f "open" "Open…" "file.open" "" "Ctrl+O")
        f.addSeparator()
        this.item(f "save" "Download .xlsx" "file.saveAs" "" "Ctrl+S")
        this.item(f "csv" "Download .csv" "file.exportCsv" "" "")
        this.item(f "html" "Download .html" "file.exportHtml" "" "")
        f.addSeparator()
        this.item(f "close" "Close" "file.close" "" "")

        def e:MenuCtl (menubar.attachMenu("edit"))
        this.item(e "undo" "Undo" "edit.undo" "" "Ctrl+Z")
        this.item(e "redo" "Redo" "edit.redo" "" "Ctrl+Y")
        e.addSeparator()
        this.item(e "cut" "Cut" "edit.cut" "" "Ctrl+X")
        this.item(e "copy" "Copy" "edit.copy" "" "Ctrl+C")
        this.item(e "paste" "Paste" "sx:paste" "" "Ctrl+V")
        this.item(e "pastevalues" "Paste values only" "sx:pasteValues" "" "Ctrl+⇧V")
        this.item(e "pastespecial" "Paste special…" "edit.pasteSpecial" "" "")
        e.addSeparator()
        this.item(e "find" "Find and replace…" "edit.find" "" "Ctrl+F")
        this.item(e "clear" "Clear contents" "edit.clear" "" "Del")
        this.item(e "selectall" "Select all" "select.all" "" "Ctrl+A")

        def v:MenuCtl (menubar.attachMenu("view"))
        this.act("showformula" "sx:formulaBar" "" "")
        def c1:UiItem (v.addCheckbox("showformula" "Formula bar" true))
        this.act("showtabs" "sx:tabs" "" "")
        def c2:UiItem (v.addCheckbox("showtabs" "Sheet tabs" true))
        this.act("showstatus" "sx:status" "" "")
        def c3:UiItem (v.addCheckbox("showstatus" "Status bar" true))
        this.act("showribbon" "sx:ribbon" "" "")
        def c4:UiItem (v.addCheckbox("showribbon" "Toolbar" true))
        v.addSeparator()
        this.act("themelight" "sx:theme" "light" "")
        def r1:UiItem (v.addRadio("themelight" "Light theme" "theme" true))
        this.act("themedark" "sx:theme" "dark" "")
        def r2:UiItem (v.addRadio("themedark" "Dark theme" "theme" false))
        v.addSeparator()
        this.item(v "freeze" "Freeze panes at selection" "view.freeze.here" "" "")
        this.item(v "unfreeze" "Unfreeze panes" "view.freeze.none" "" "")
        this.item(v "freezetop" "Freeze top row" "view.freezeTopRow" "" "")
        this.item(v "freezefirst" "Freeze first column" "view.freezeFirstColumn" "" "")
        v.addSeparator()
        this.item(v "gridlines" "Gridlines" "view.gridlines" "" "")
        this.item(v "headings" "Headings" "view.headings" "" "")
        this.act("rtl" "view.rtl" "" "")
        def c5:UiItem (v.addCheckbox("rtl" "Right to left" false))

        def ins:MenuCtl (menubar.attachMenu("insert"))
        this.item(ins "rowabove" "Row above" "insert.row.above" "" "")
        this.item(ins "rowbelow" "Row below" "insert.row.below" "" "")
        this.item(ins "colleft" "Column left" "insert.column.left" "" "")
        this.item(ins "colright" "Column right" "insert.column.right" "" "")
        ins.addSeparator()
        this.item(ins "chart" "Chart…" "insert.chart" "" "")
        this.item(ins "table" "Table" "insert.table" "" "Ctrl+T")
        this.item(ins "link" "Link…" "insert.link" "" "Ctrl+K")
        ins.addSeparator()
        this.item(ins "sheet" "New sheet" "sheet.add" "" "")
        this.item(ins "dupsheet" "Duplicate sheet" "sheet.duplicate" "" "")

        def fm:MenuCtl (menubar.attachMenu("format"))
        this.item(fm "fbold" "Bold" "format.bold" "" "Ctrl+B")
        this.item(fm "fitalic" "Italic" "format.italic" "" "Ctrl+I")
        this.item(fm "funderline" "Underline" "format.underline" "" "Ctrl+U")
        this.item(fm "fstrike" "Strikethrough" "format.strike" "" "")
        def textSub:UiItem (fm.addSub("textmore" "Text" false))
        this.kid(textSub "fdunder" "Double underline" "home.doubleUnderline" "")
        this.kid(textSub "fbigger" "Bigger text" "format.size.up" "")
        this.kid(textSub "fsmaller" "Smaller text" "format.size.down" "")
        fm.addSeparator()
        def numSub:UiItem (fm.addSub("number" "Number" false))
        this.kid(numSub "nf-general" "General" "format.numfmt" "general")
        this.kid(numSub "nf-number" "Number" "format.numfmt" "number")
        this.kid(numSub "nf-currency" "Currency" "format.numfmt" "currency")
        this.kid(numSub "nf-accounting" "Accounting" "format.numfmt" "accounting")
        this.kid(numSub "nf-longdate" "Long Date" "format.numfmt" "longDate")
        this.kid(numSub "nf-time" "Time" "format.numfmt" "time")
        this.kid(numSub "nf-fraction" "Fraction" "format.numfmt" "fraction")
        this.kid(numSub "nf-scientific" "Scientific" "format.numfmt" "scientific")
        this.kid(numSub "nf-percent" "Percent" "format.numfmt" "percent")
        this.kid(numSub "nf-comma" "Thousands separator" "format.numfmt" "comma")
        this.kid(numSub "nf-date" "Date" "format.numfmt" "date")
        this.kid(numSub "nf-text" "Text" "format.numfmt" "text")
        MenuCtl.addKidSeparator(numSub)
        this.kid(numSub "nf-more" "More decimals" "format.decimals" "more")
        this.kid(numSub "nf-less" "Fewer decimals" "format.decimals" "less")
        def alignSub:UiItem (fm.addSub("alignment" "Alignment" false))
        this.kid(alignSub "al-left" "Left" "format.align" "left")
        this.kid(alignSub "al-center" "Center" "format.align" "center")
        this.kid(alignSub "al-right" "Right" "format.align" "right")
        MenuCtl.addKidSeparator(alignSub)
        this.kid(alignSub "al-top" "Top" "format.valign" "top")
        this.kid(alignSub "al-middle" "Middle" "format.valign" "center")
        this.kid(alignSub "al-bottom" "Bottom" "format.valign" "bottom")
        this.kid(alignSub "al-indent" "Increase indent" "home.increaseIndent" "")
        this.kid(alignSub "al-outdent" "Decrease indent" "home.decreaseIndent" "")
        this.kid(alignSub "al-rotate" "Angle counterclockwise" "home.orientation" "counterclockwise")
        this.item(fm "fwrap" "Wrap text" "format.wrap" "" "")
        def mergeSub:UiItem (fm.addSub("merge" "Merge" false))
        this.kid(mergeSub "fmerge" "Merge cells" "format.merge" "")
        this.kid(mergeSub "fmergecenter" "Merge & center" "home.mergeCenter" "")
        this.kid(mergeSub "fmergeacross" "Merge across" "home.mergeAcross" "")
        this.kid(mergeSub "funmerge" "Unmerge cells" "home.unmergeCells" "")
        def styleSub:UiItem (fm.addSub("cellstyles" "Cell styles" false))
        def styleNames:[string] ([] _:string ("Normal" "Good" "Bad" "Neutral" "Title" "Heading 1" "Total" "Note" "Input" "Calculation" "Warning Text"))
        def sti:int 0
        while (sti < (array_length styleNames)) {
            def stn:string (itemAt styleNames sti)
            this.kid(styleSub ("cs-" + (to_string sti)) stn "home.cellStyle" stn)
            sti = (sti + 1)
        }
