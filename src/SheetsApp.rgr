    fn tool:RibbonItem (r:RibbonCtl value:string name:string icon:string command:string arg:string toggle:boolean) {
        this.act(value command arg "")
        if toggle {
            return (r.addToggle(value name icon))
        }
        return (r.add(value name icon))
    }

    ; A group on one of the ribbon's tabs.
    fn grp:RibbonCtl (tab:string tid:string name:string) {
        def g:RibbonCtl (new RibbonCtl)
        g.tid = tid
        g.name = name
        push tabGroups g
        push tabOf tab
        return g
    }

    ; A button labelled with a word instead of a glyph.
    fn word:RibbonItem (r:RibbonCtl value:string name:string label:string command:string arg:string) {
        def it:RibbonItem (this.tool(r value name "" command arg false))
        it.text = label
        return it
    }

    fn groupsOf:[RibbonCtl] (tab:string) {
        def out:[RibbonCtl]
        def i:int 0
        while (i < (array_length tabGroups)) {
            if ((itemAt tabOf i) == tab) {
                push out (itemAt tabGroups i)
            }
            i = (i + 1)
        }
        return out
    }

    fn buildRibbon:void () {
        def noGroups:[RibbonCtl]
        tabGroups = noGroups
        def noTabs:[string]
        tabOf = noTabs
        qat = (new RibbonCtl)
        qat.tid = "sx-qat"
        qat.name = "Quick Access Toolbar"
        this.tool(qat "qat-save" "Save" (SheetsApp.icon("save")) "file.saveAs" "" false)
        this.tool(qat "qat-undo" "Undo" (SheetsApp.icon("undo")) "edit.undo" "" false)
        this.tool(qat "qat-redo" "Redo" (SheetsApp.icon("redo")) "edit.redo" "" false)

        history = (new RibbonCtl)
        history.tid = "sx-rb-history"
        history.name = "History"
        this.tool(history "undo" "Undo" (SheetsApp.icon("undo")) "edit.undo" "" false)
        this.tool(history "redo" "Redo" (SheetsApp.icon("redo")) "edit.redo" "" false)
        this.tool(history "painter" "Format painter" (SheetsApp.icon("painter")) "edit.formatPainter" "" true)

        textTools = (new RibbonCtl)
        textTools.tid = "sx-rb-text"
        textTools.name = "Font"
        def b:RibbonItem (this.tool(textTools "bold" "Bold" (SheetsApp.icon("bold")) "format.bold" "" true))
        b.shortcut = "Control+B"
        def it:RibbonItem (this.tool(textTools "italic" "Italic" (SheetsApp.icon("italic")) "format.italic" "" true))
        it.shortcut = "Control+I"
        def u:RibbonItem (this.tool(textTools "underline" "Underline" (SheetsApp.icon("underline")) "format.underline" "" true))
        u.shortcut = "Control+U"
        this.tool(textTools "strike" "Strikethrough" (SheetsApp.icon("strike")) "format.strike" "" true)
        textTools.addSeparator()
        def tc:RibbonItem (this.tool(textTools "color" "Text colour" (SheetsApp.icon("color")) "format.color" "" false))
        tc.swatch = "#dc2626"
        def fc:RibbonItem (this.tool(textTools "fill" "Fill colour" (SheetsApp.icon("fill")) "format.fill" "" false))
        fc.swatch = "#facc15"

        alignTools = (new RibbonCtl)
