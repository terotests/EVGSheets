        this.titem(shapes "i-diamond" "Diamond" "insert.shape" "diamond")
        this.titem(shapes "i-line" "Line" "insert.shape" "line")
        this.titem(shapes "i-arrow" "Arrow" "insert.shape" "arrow")
        this.tcol()
        this.tb("i-icons" "Icons" "Icons" "smile" "insert.icons" "")
        this.tb("i-smartart" "SmartArt" "SmartArt" "smartart" "insert.smartArt" "")
        this.tset("insert" "sx-rb-inscharts" "Charts")
        this.tkeep()
        this.tb("i-chart" "Insert chart" "Chart" "chart" "insert.chart" "")
        this.tb("i-spark" "Line sparkline" "Sparkline" "spark" "insert.sparkline" "")
        this.tset("insert" "sx-rb-insfilt" "Filters")
        this.tb("i-slicer" "Slicer" "Slicer" "filter" "insert.slicer" "")
        this.tb("i-timeline" "Timeline" "Timeline" "timeline" "insert.timeline" "")
        this.tset("insert" "sx-rb-inslinks" "Links & Comments")
        this.tb("i-link" "Link" "Link" "link" "insert.link" "")
        this.tb("i-comment" "Comment" "Comment" "comment" "review.newComment" "")
        this.tcol()
        this.tb("i-note" "Note" "Note" "note" "review.newNote" "")
        this.tset("insert" "sx-rb-instext" "Text")
        this.tb("i-textbox" "Text box" "Text Box" "textbox" "insert.textBox" "")
        this.tb("i-wordart" "WordArt" "WordArt" "wordart" "insert.wordArt" "WordArt")
        this.tcol()
        this.tb("i-sig" "Signature line" "Signature Line" "signature" "insert.signatureLine" "")
        this.tb("i-check" "Checkbox" "Checkbox" "checkbox" "insert.checkbox" "")
        this.tset("insert" "sx-rb-inssym" "Symbols")
        this.tb("i-equation" "Equation" "Equation" "sigma" "insert.equation" "x^2")
        this.tb("i-symbol" "Symbol" "Symbol" "omega" "insert.symbol" "")

        ; --- Draw --------------------------------------------------------------
        this.tset("draw" "sx-rb-drtools" "Drawing Tools")
        this.tb("dr-pen" "Pen" "Pen" "pen" "draw.pen" "")
        this.tb("dr-eraser" "Eraser" "Eraser" "eraser" "draw.eraser" "")
        this.tcol()
        this.tb("dr-lasso" "Lasso select" "Lasso Select" "lasso" "draw.lasso" "")
        this.tset("draw" "sx-rb-drconv" "Convert")
        this.tb("dr-ink" "Ink to shape" "Ink to Shape" "wand" "draw.inkToShape" "")

