Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

; What a menu row or a ribbon button does: a GridApp command and its argument,
; or one of the app's own verbs ("sx:…") that the core does not have.
class SxAction {
    def value:string ""
    def command:string ""
    def arg:string ""
    def shortcut:string ""

    Constructor () {
    }
}

; One place in a ribbon group on the tabs past Home: a toolbar row or a
; drop-down, in column `col` of its group.
class SxSlot {
    def col:int 0
    def isMenu:boolean false
    def bar:RibbonCtl (new RibbonCtl)
    def menu:MenuCtl (new MenuCtl)

    Constructor () {
    }
}

; A labelled group on one of the tabs past Home (Show, Zoom, Window…): its
; slots laid out in columns of two rows, and the drop-down it folds into
; when the window is too narrow for the whole tab.
class SxGroup {
    def tab:string ""
    def tid:string ""
    def name:string ""
    def cols:int 1
    ; A group the tab is mostly for (Sort & Filter on Data): it keeps its
    ; captions and stays unfolded longest.
    def keep:boolean false
    def slots:[SxSlot]
    def fold:MenuCtl (new MenuCtl)

    Constructor () {
        def none:[SxSlot]
        slots = none
    }
}

class SheetsApp {
    def grid:DataGridWeb (new DataGridWeb)
    def ui:UiHost (new UiHost)

    def menubar:MenubarCtl (new MenubarCtl)
    def fontMenu:MenuCtl (new MenuCtl)
    def sizeMenu:MenuCtl (new MenuCtl)
