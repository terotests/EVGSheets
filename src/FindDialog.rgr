; =============================================================================
; FindDialog — Find and replace, built from EVGUI controllers
; =============================================================================
;
;   ┌─ Find and replace ─────────────────────────────── × ┐
;   │ Find           [________________________________]   │
;   │ Replace with   [________________________________]   │
;   │ ☐ Match case             ☐ Entire cell              │
;   │ ☑ Search formulas        ☐ All sheets               │
;   │ replaced 3 of 'x'                                   │
;   │            [Close] [Replace all] [Replace] [Find next]│
;   └─────────────────────────────────────────────────────┘
;
; The core (GridApp) has its own find dialog, an EVGWindow. This is the same
; dialog as EVGUI controllers (see SxDialog) — a modal WindowCtl holding two InputCtls, four
; CheckboxCtls and four ButtonCtls — so it is styled by sheets.css like the
; rest of the chrome and reads to a screen reader as a real dialog.
;
; The search itself stays the core's. GridApp keeps the query and the options
; in fields (findQuery, findMatchCase…) and searches with findNext,
; replaceCurrent and replaceAll, none of which needs its dialog; this writes
; the fields and calls those. The query survives closing the dialog because
; it lives in the core, as it did before.
; =============================================================================

Import "SxDialog.rgr"

class FindDialog extends SxDialog {
    def findIn:InputCtl (new InputCtl)
    def replIn:InputCtl (new InputCtl)
    def matchCase:CheckboxCtl (new CheckboxCtl)
    def wholeCell:CheckboxCtl (new CheckboxCtl)
    def inFormulas:CheckboxCtl (new CheckboxCtl)
    def allSheets:CheckboxCtl (new CheckboxCtl)
    def closeBtn:ButtonCtl (new ButtonCtl)
    def allBtn:ButtonCtl (new ButtonCtl)
    def oneBtn:ButtonCtl (new ButtonCtl)
    def nextBtn:ButtonCtl (new ButtonCtl)

    Constructor () {
        this.setup("sx-find" "Find and replace")
        this.field(findIn "sx-find-query" "Find")
        this.field(replIn "sx-find-replace" "Replace with")
        this.check(matchCase "sx-find-case" "Match case")
        this.check(wholeCell "sx-find-cell" "Entire cell")
        this.check(inFormulas "sx-find-formulas" "Search formulas")
        this.check(allSheets "sx-find-sheets" "All sheets")
        this.button(closeBtn "sx-find-close" "Close" "secondary")
        this.button(allBtn "sx-find-all" "Replace all" "secondary")
        this.button(oneBtn "sx-find-one" "Replace" "secondary")
        this.button(nextBtn "sx-find-next" "Find next" "primary")
    }

    fn ctls:[UiCtl] () {
        def a:[UiCtl]
        push a win
        push a findIn
        push a replIn
        push a matchCase
        push a wholeCell
        push a inFormulas
        push a allSheets
        push a closeBtn
        push a allBtn
        push a oneBtn
        push a nextBtn
        return a
    }

    fn ring:[string] () {
        def a:[string]
        push a findIn.tid
        push a replIn.tid
        push a matchCase.tid
        push a wholeCell.tid
        push a inFormulas.tid
        push a allSheets.tid
        push a closeBtn.tid
        push a allBtn.tid
        push a oneBtn.tid
        push a nextBtn.tid
        push a (win.closeTid())
        return a
    }

    fn isButton:boolean (target:string) {
        return ((target == closeBtn.tid) || (target == allBtn.tid) || (target == oneBtn.tid) || (target == nextBtn.tid))
    }

    ; Enter in either field is Find next.
    fn entersDefault:boolean (target:string) {
        return ((findIn.owns(target)) || (replIn.owns(target)))
    }

    fn defaultTid:string () {
        return nextBtn.tid
    }

    fn buildBody:void () {
        def body:EVGElement (unwrap win.bodyEl)
        body.className = "sx-dlg-body"
        UiTree.clearChildren(body)
        def f1:EVGElement (this.row("sx-dlg-field"))
        f1.addChild((this.label(findIn.name)))
        f1.addChild((unwrap findIn.rootEl))
        body.addChild(f1)
        def f2:EVGElement (this.row("sx-dlg-field"))
        f2.addChild((this.label(replIn.name)))
        f2.addChild((unwrap replIn.rootEl))
        body.addChild(f2)
        def opts:EVGElement (this.row("sx-dlg-options"))
        def c1:EVGElement (this.row("sx-dlg-col"))
        c1.addChild((unwrap matchCase.rootEl))
        c1.addChild((unwrap inFormulas.rootEl))
        def c2:EVGElement (this.row("sx-dlg-col"))
        c2.addChild((unwrap wholeCell.rootEl))
        c2.addChild((unwrap allSheets.rootEl))
        opts.addChild(c1)
        opts.addChild(c2)
        body.addChild(opts)
        body.addChild((this.statusRow()))
        def acts:EVGElement (this.row("sx-dlg-actions"))
        acts.addChild((unwrap closeBtn.rootEl))
        acts.addChild((unwrap allBtn.rootEl))
        acts.addChild((unwrap oneBtn.rootEl))
        acts.addChild((unwrap nextBtn.rootEl))
        body.addChild(acts)
    }

    ; Open on what the core remembers, and return where focus goes: the query.
    fn open:string (app:GridApp pageW:double pageH:double) {
        if app.editing {
            app.commitEdit()
        }
        findIn.setValue(app.findQuery)
        findIn.selectAll()
        replIn.setValue(app.replaceWith)
        matchCase.checkState = (SxDialog.tri(app.findMatchCase))
        wholeCell.checkState = (SxDialog.tri(app.findWholeCell))
        inFormulas.checkState = (SxDialog.tri(app.findInFormulas))
        allSheets.checkState = (SxDialog.tri(app.findAllSheets))
        app.findStatus = ""
        statusEl.textContent = ""
        this.openOn(pageW pageH)
        return findIn.tid
    }

    ; The fields into the core, before every search.
    fn store:void (app:GridApp) {
        app.findQuery = findIn.value
        app.replaceWith = replIn.value
        app.findMatchCase = (matchCase.checkState == 1)
        app.findWholeCell = (wholeCell.checkState == 1)
        app.findInFormulas = (inFormulas.checkState == 1)
        app.findAllSheets = (allSheets.checkState == 1)
    }

    fn act:boolean (target:string app:GridApp) {
        this.store(app)
        if (target == closeBtn.tid) {
            this.close()
            return true
        }
        if (target == nextBtn.tid) {
            def found:boolean (app.findNext())
        }
        if (target == oneBtn.tid) {
            def replaced:boolean (app.replaceCurrent())
        }
        if (target == allBtn.tid) {
            def n:int (app.replaceAll())
        }
        statusEl.textContent = app.findStatus
        return false
    }

    fn showFocus:void (focusId:string) {
        if (win.open == false) {
            return
        }
        this.caretFor(findIn focusId)
        this.caretFor(replIn focusId)
    }
}
